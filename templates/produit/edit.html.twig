{% extends 'base.html.twig' %}

{% block title %}Modifier {{ produit.nom }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_produit_index') }}"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>

        <div>
            <h1 class="fw-bold mb-1">Modifier le produit</h1>
            <p class="text-muted mb-0">
                Modification de « {{ produit.nom }} »
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-9">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Informations du produit
                    </h5>
                </div>

                <div class="card-body p-4">

                    {% if form.vars.submitted and not form.vars.valid %}
                        <div class="alert alert-danger">
                            <strong>La modification n’a pas pu être enregistrée.</strong>
                            Veuillez corriger les erreurs suivantes.
                            {{ form_errors(form) }}
                        </div>
                    {% endif %}

                    {{ form_start(form, {
                        'attr': {'id': 'form-modifier-produit'}
                    }) }}

                    <div class="row g-4">

                        <div class="col-md-6">
                            {{ form_row(form.reference) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.nom) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.description) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.categorie) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.unite) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.prixAchat) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.prixVente) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.quantiteStock) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.seuilAlerte) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.actif) }}
                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end align-items-center gap-2 flex-wrap">

                        <a href="{{ path('app_produit_show', {
                            'id': produit.id
                        }) }}" class="btn btn-light border">
                            <i class="bi bi-eye me-1"></i>
                            Voir
                        </a>

                        <button type="submit"
                                form="form-modifier-produit"
                                class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Enregistrer les modifications
                        </button>

                    </div>

                    {{ form_end(form) }}

                    <hr class="my-4">

                    <form method="post"
                          action="{{ path('app_produit_delete', {
                              'id': produit.id
                          }) }}"
                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete' ~ produit.id) }}">

                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i>
                            Supprimer le produit
                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
