{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }}{% endblock %}

{% block body %}

<div class="container-fluid py-4">


<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div class="d-flex align-items-center gap-3">

        <a
            href="{{ path('app_produit_index') }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
        </a>

        <div>
            <h1 class="fw-bold mb-1">{{ produit.nom }}</h1>

            <p class="text-muted mb-0">
                Référence :
                <strong>{{ produit.reference }}</strong>
            </p>
        </div>

    </div>

    <div class="d-flex gap-2">

        <a
            href="{{ path('app_produit_edit', {'id': produit.id}) }}"
            class="btn btn-primary"
        >
            <i class="bi bi-pencil me-1"></i>
            Modifier
        </a>

        <form
            method="post"
            action="{{ path('app_produit_delete', {'id': produit.id}) }}"
            onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');"
        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('delete' ~ produit.id) }}"
            >

            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>
                Supprimer
            </button>
        </form>

    </div>

</div>

<div class="row g-4">

    {# Informations générales #}
    <div class="col-12 col-xl-8">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Informations générales
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">
                            Référence
                        </div>
                        <div class="fw-semibold">
                            {{ produit.reference }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">
                            Catégorie
                        </div>
                        <div class="fw-semibold">
                            {% if produit.categorie %}
                                {{ produit.categorie.nom }}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">
                            Unité
                        </div>
                        <div class="fw-semibold">
                            {{ produit.unite }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">
                            Statut
                        </div>

                        {% if produit.actif %}
                            <span class="badge text-bg-success">
                                Actif
                            </span>
                        {% else %}
                            <span class="badge text-bg-secondary">
                                Inactif
                            </span>
                        {% endif %}
                    </div>

                    <div class="col-12">

                        <div class="text-muted small mb-1">
                            Description
                        </div>

                        {% if produit.description %}
                            <p class="mb-0">
                                {{ produit.description|nl2br }}
                            </p>
                        {% else %}
                            <span class="text-muted">
                                Aucune description.
                            </span>
                        {% endif %}

                    </div>

                </div>

            </div>

        </div>

    </div>

    {# Stock #}
    <div class="col-12 col-xl-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-boxes me-2"></i>
                    Stock
                </h5>
            </div>

            <div class="card-body">

                <div class="text-center py-3">

                    <div class="display-4 fw-bold mb-2">
                        {{ produit.quantiteStock }}
                    </div>

                    <div class="text-muted">
                        {{ produit.unite }}(s) disponibles
                    </div>

                </div>

                <hr>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">
                        Seuil d'alerte
                    </span>

                    <strong>
                        {{ produit.seuilAlerte }}
                    </strong>
                </div>

                {% if produit.quantiteStock <= produit.seuilAlerte %}

                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Stock faible : réapprovisionnement recommandé.
                    </div>

                {% elseif produit.quantiteStock <= produit.seuilAlerte * 2 %}

                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        Le stock commence à être faible.
                    </div>

                {% else %}

                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        Niveau de stock correct.
                    </div>

                {% endif %}

            </div>

        </div>

    </div>

    {# Prix #}
    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-currency-dollar me-2"></i>
                    Informations tarifaires
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="border rounded-3 p-3">

                            <div class="text-muted small">
                                Prix d'achat
                            </div>

                            <div class="fs-4 fw-bold mt-1">
                                {{ produit.prixAchat|number_format(2, ',', ' ') }}
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="border rounded-3 p-3">

                            <div class="text-muted small">
                                Prix de vente
                            </div>

                            <div class="fs-4 fw-bold mt-1">
                                {{ produit.prixVente|number_format(2, ',', ' ') }}
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="border rounded-3 p-3">

                            <div class="text-muted small">
                                Marge unitaire
                            </div>

                            <div class="fs-4 fw-bold mt-1">
                                {{ (produit.prixVente - produit.prixAchat)|number_format(2, ',', ' ') }}
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    {# Dates #}
    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Créé le
                        </span>

                        <strong>
                            {{ produit.createdAt ? produit.createdAt|date('d/m/Y à H:i') : '—' }}
                        </strong>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Dernière modification
                        </span>

                        <strong>
                            {{ produit.updatedAt ? produit.updatedAt|date('d/m/Y à H:i') : '—' }}
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


</div>
{% endblock %}
