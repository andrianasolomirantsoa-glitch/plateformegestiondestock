{% extends 'base.html.twig' %}

{% block title %}Nouveau produit | NEXA{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .product-create {
            --nexa-primary: #1f2551;
            --nexa-blue: #4385f5;
            --nexa-cyan: #16b8c8;
            --nexa-border: #e7ebf2;
            --nexa-muted: #788399;
            color: #26314b;
        }

        /* HEADER */
        .create-header {
            position: relative;
            overflow: hidden;
            padding: 27px 30px;
            border-radius: 18px;
            color: #fff;
            background: linear-gradient(120deg, #1f2551, #303c78);
        }

        .create-header::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            top: -125px;
            right: -65px;
            border: 35px solid rgba(255,255,255,.06);
            border-radius: 50%;
        }

        .header-content {
            position: relative;
            z-index: 1;
        }

        .header-back {
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 12px;
            background: rgba(255,255,255,.1);
            color: white;
            text-decoration: none;
            transition: .2s;
        }

        .header-back:hover {
            background: rgba(255,255,255,.2);
            color: white;
            transform: translateX(-2px);
        }

        .header-eyebrow {
            color: #b9c9f5;
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .13em;
            margin-bottom: 6px;
        }

        .header-title {
            font-size: clamp(1.4rem, 2.5vw, 1.9rem);
            font-weight: 800;
            margin: 0;
        }

        .header-description {
            color: rgba(255,255,255,.68);
            font-size: .9rem;
            margin: 6px 0 0;
        }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 13px;
            border-radius: 10px;
            background: rgba(255,255,255,.11);
            color: #fff;
            font-size: .8rem;
            font-weight: 600;
        }

        /* LAYOUT */
        .create-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 290px;
            gap: 22px;
            align-items: start;
            margin-top: 23px;
        }

        .create-card,
        .side-card {
            background: #fff;
            border: 1px solid var(--nexa-border);
            border-radius: 16px;
            box-shadow: 0 5px 22px rgba(31,37,81,.045);
            overflow: hidden;
        }

        .card-top {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 19px 23px;
            border-bottom: 1px solid var(--nexa-border);
        }

        .card-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 12px;
            background: #eef3ff;
            color: var(--nexa-blue);
            font-size: 1.15rem;
        }

        .card-top h5 {
            margin: 0;
            color: var(--nexa-primary);
            font-size: .98rem;
            font-weight: 750;
        }

        .card-top p {
            margin: 4px 0 0;
            color: var(--nexa-muted);
            font-size: .8rem;
        }

        .card-content {
            padding: 24px;
        }

        /* FORM SECTIONS */
        .form-section + .form-section {
            margin-top: 27px;
            padding-top: 24px;
            border-top: 1px solid var(--nexa-border);
        }

        .form-section-title {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 17px;
            color: var(--nexa-primary);
            font-size: .9rem;
            font-weight: 750;
        }

        .form-section-title i {
            color: var(--nexa-blue);
            font-size: 1.05rem;
        }

        /* FORM CONTROLS */
        .product-create .form-label {
            margin-bottom: 7px;
            color: #35405a;
            font-size: .84rem;
            font-weight: 650;
        }

        .product-create .form-control,
        .product-create .form-select {
            min-height: 46px;
            padding: 10px 13px;
            border: 1px solid #dfe5ef;
            border-radius: 10px;
            background-color: #fff;
            color: #26314b;
            font-size: .89rem;
            box-shadow: none;
            transition: .2s;
        }

        .product-create textarea.form-control {
            min-height: 115px;
            resize: vertical;
        }

        .product-create .form-control:focus,
        .product-create .form-select:focus {
            border-color: var(--nexa-blue);
            box-shadow: 0 0 0 3px rgba(67,133,245,.11);
        }

        .product-create .form-text {
            margin-top: 6px;
            color: var(--nexa-muted);
            font-size: .76rem;
        }

        .product-create .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 48px;
            margin: 0;
            padding: 12px 14px 12px 42px;
            border: 1px solid var(--nexa-border);
            border-radius: 10px;
            background: #f8faff;
        }

        .product-create .form-check-input {
            cursor: pointer;
        }

        .product-create .form-check-input:checked {
            background-color: var(--nexa-blue);
            border-color: var(--nexa-blue);
        }

        .product-create .form-check-label {
            color: #35405a;
            font-size: .86rem;
            font-weight: 600;
            cursor: pointer;
        }

        .product-create .invalid-feedback {
            font-size: .78rem;
        }

        /* FOOTER */
        .form-footer {
            position: sticky;
            bottom: 0;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-top: 27px;
            padding: 16px 20px;
            border: 1px solid var(--nexa-border);
            border-radius: 13px;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 20px rgba(31,37,81,.07);
        }

        .btn-nexa {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 10px 18px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(120deg, #2867dc, #4385f5);
            color: #fff;
            font-size: .86rem;
            font-weight: 650;
            transition: .2s;
        }

        .btn-nexa:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(67,133,245,.25);
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 10px 17px;
            border: 1px solid var(--nexa-border);
            border-radius: 10px;
            background: #fff;
            color: #536078;
            font-size: .86rem;
            font-weight: 600;
            text-decoration: none;
        }

        .btn-cancel:hover {
            background: #f5f7fb;
            color: var(--nexa-primary);
        }

        /* SIDEBAR */
        .side-card {
            padding: 20px;
        }

        .side-card + .side-card {
            margin-top: 15px;
        }

        .side-title {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 19px;
            color: var(--nexa-primary);
            font-size: .92rem;
            font-weight: 750;
        }

        .side-title i {
            color: var(--nexa-blue);
            font-size: 1.1rem;
        }

        .guide-item {
            display: flex;
            align-items: flex-start;
            gap: 11px;
        }

        .guide-item + .guide-item {
            margin-top: 18px;
        }

        .guide-number {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 8px;
            background: #eef3ff;
            color: var(--nexa-blue);
            font-size: .76rem;
            font-weight: 800;
        }

        .guide-item strong {
            display: block;
            margin-bottom: 4px;
            color: #35405a;
            font-size: .82rem;
        }

        .guide-item p {
            margin: 0;
            color: var(--nexa-muted);
            font-size: .77rem;
            line-height: 1.55;
        }

        .info-box {
            padding: 13px;
            border: 1px solid #dfe8ff;
            border-radius: 10px;
            background: #f5f8ff;
            color: #526387;
            font-size: .79rem;
            line-height: 1.6;
        }

        .info-box i {
            color: var(--nexa-blue);
            margin-right: 5px;
        }

        .side-stat {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px;
            border: 1px solid var(--nexa-border);
            border-radius: 11px;
            background: #fafbfe;
        }

        .side-stat-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #eef3ff;
            color: var(--nexa-blue);
            font-size: 1.1rem;
        }

        .side-stat strong {
            display: block;
            color: var(--nexa-primary);
            font-size: .82rem;
        }

        .side-stat span {
            color: var(--nexa-muted);
            font-size: .74rem;
        }

        /* RESPONSIVE */
        @media (max-width: 1100px) {
            .create-layout {
                grid-template-columns: minmax(0, 1fr) 250px;
            }
        }

        @media (max-width: 991px) {
            .create-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .side-column {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 15px;
            }

            .side-card + .side-card {
                margin-top: 0;
            }
        }

        @media (max-width: 575px) {
            .create-header {
                padding: 20px;
            }

            .header-badge {
                display: none;
            }

            .card-content {
                padding: 17px;
            }

            .card-top {
                padding: 16px;
            }

            .side-column {
                grid-template-columns: 1fr;
            }

            .form-footer {
                position: static;
                align-items: stretch;
                flex-direction: column;
            }

            .footer-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .footer-actions .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="container-fluid py-4 product-create">

    {# EN-TÊTE #}
    <div class="create-header">
        <div class="header-content">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                <div class="d-flex align-items-center gap-3">
                    <a href="{{ path('app_produit_index') }}"
                       class="header-back"
                       title="Retour aux produits">
                        <i class="bi bi-arrow-left"></i>
                    </a>

                    <div>
                        <div class="header-eyebrow">
                            NEXA / GESTION DU STOCK
                        </div>

                        <h1 class="header-title">
                            Ajouter un produit
                        </h1>

                        <p class="header-description">
                            Enregistrez un nouvel article dans votre catalogue.
                        </p>
                    </div>
                </div>

                <div class="header-badge">
                    <i class="bi bi-plus-circle"></i>
                    Nouveau produit
                </div>

            </div>
        </div>
    </div>

    {# FORMULAIRE #}
    {{ form_start(form, {
        attr: {
            class: 'product-form',
            novalidate: 'novalidate'
        }
    }) }}

    <div class="create-layout">

        {# COLONNE PRINCIPALE #}
        <main class="create-card">

            <div class="card-top">
                <div class="card-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h5>Informations du produit</h5>
                    <p>Complétez les différentes informations de votre article.</p>
                </div>
            </div>

            <div class="card-content">

                {% if form.vars.submitted and not form.vars.valid %}
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Le produit n'a pas pu être enregistré.
                        </div>
                        Veuillez corriger les erreurs ci-dessous.
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                {# IDENTIFICATION #}
                <section class="form-section">
                    <h3 class="form-section-title">
                        <i class="bi bi-upc-scan"></i>
                        Identification du produit
                    </h3>

                    <div class="row g-3">

                        <div class="col-md-6">
                            {{ form_row(form.reference) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.codeBarres, {
                                label: 'Code-barres EAN-13',
                                help: 'Saisissez les 13 chiffres du code-barres existant ou laissez vide pour une génération automatique.'
                            }) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.nom) }}
                        </div>

                    </div>
                </section>

                {# CLASSIFICATION #}
                <section class="form-section">
                    <h3 class="form-section-title">
                        <i class="bi bi-diagram-3"></i>
                        Classification et description
                    </h3>

                    <div class="row g-3">

                        <div class="col-md-6">
                            {{ form_row(form.famille) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.unite) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.description) }}
                        </div>

                    </div>
                </section>

                {# TARIFICATION #}
                <section class="form-section">
                    <h3 class="form-section-title">
                        <i class="bi bi-currency-exchange"></i>
                        Informations commerciales
                    </h3>

                    <div class="row g-3">

                        <div class="col-md-6">
                            {{ form_row(form.prixAchat) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.prixVente) }}
                        </div>

                    </div>
                </section>

                {# STOCK #}
                <section class="form-section">
                    <h3 class="form-section-title">
                        <i class="bi bi-boxes"></i>
                        Gestion du stock
                    </h3>

                    <div class="row g-3">

                        <div class="col-md-6">
                            {{ form_row(form.quantiteStock) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.seuilAlerte) }}
                        </div>

                        <div class="col-12">
                            {{ form_row(form.actif) }}
                        </div>

                    </div>
                </section>

                {# ACTIONS #}
                <div class="form-footer">

                    <div class="small text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Vérifiez les données avant de valider.
                    </div>

                    <div class="footer-actions d-flex gap-2 flex-wrap">

                        <a href="{{ path('app_produit_index') }}"
                           class="btn-cancel">
                            Annuler
                        </a>

                        <button type="submit" class="btn-nexa">
                            <i class="bi bi-check2-circle"></i>
                            Enregistrer le produit
                        </button>

                    </div>
                </div>

            </div>
        </main>

        {# COLONNE SECONDAIRE #}
        <aside class="side-column">

            <div class="side-card">

                <h5 class="side-title">
                    <i class="bi bi-lightbulb"></i>
                    Guide de création
                </h5>

                <div class="guide-item">
                    <span class="guide-number">1</span>
                    <div>
                        <strong>Identification</strong>
                        <p>Renseignez le nom, la référence et le code-barres du produit.</p>
                    </div>
                </div>

                <div class="guide-item">
                    <span class="guide-number">2</span>
                    <div>
                        <strong>Classification</strong>
                        <p>Choisissez la famille adaptée et l'unité de mesure.</p>
                    </div>
                </div>

                <div class="guide-item">
                    <span class="guide-number">3</span>
                    <div>
                        <strong>Tarification</strong>
                        <p>Indiquez le prix d'achat et le prix de vente.</p>
                    </div>
                </div>

                <div class="guide-item">
                    <span class="guide-number">4</span>
                    <div>
                        <strong>Stock initial</strong>
                        <p>Définissez la quantité disponible et le seuil d'alerte.</p>
                    </div>
                </div>

            </div>

            <div class="side-card">

                <h5 class="side-title">
                    <i class="bi bi-info-circle"></i>
                    Bon à savoir
                </h5>

                <div class="info-box">
                    <i class="bi bi-check-circle-fill"></i>
                    Le produit sera enregistré avec les règles de validation définies dans votre application.
                </div>

            </div>

            <div class="side-card">

                <h5 class="side-title">
                    <i class="bi bi-shield-check"></i>
                    Contrôle des données
                </h5>

                <div class="side-stat">
                    <div class="side-stat-icon">
                        <i class="bi bi-upc"></i>
                    </div>

                    <div>
                        <strong>Code EAN-13</strong>
                        <span>Identification du produit</span>
                    </div>
                </div>

                <div class="side-stat mt-2">
                    <div class="side-stat-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <div>
                        <strong>Suivi du stock</strong>
                        <span>Surveillance des quantités</span>
                    </div>
                </div>

            </div>

        </aside>

    </div>

    {{ form_end(form) }}

</div>

{% endblock %}
