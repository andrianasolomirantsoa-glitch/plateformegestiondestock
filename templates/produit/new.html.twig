{% extends 'base.html.twig' %}

{% block title %}Nouveau produit{% endblock %}

{% block body %}

<div class="container-fluid py-4">

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>

    <div>
        <h1 class="fw-bold mb-1">Nouveau produit</h1>
        <p class="text-muted mb-0">
            Ajouter un nouveau produit au catalogue
        </p>
    </div>
</div>

<div class="row justify-content-center">

    <div class="col-12 col-xl-9">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-box-seam me-2"></i>
                    Informations du produit
                </h5>
            </div>

            <div class="card-body p-4">

                {{ form_start(form) }}

                <div class="row g-4">

                    <div class="col-md-6">
                        {{ form_row(form.reference) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.nom) }}
                    </div>

                    <div class="col-12">
                        {{ form_row(form.description) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.categorie) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.unite) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.prixAchat) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.prixVente) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.quantiteStock) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.seuilAlerte) }}
                    </div>

                    <div class="col-12">
                        {{ form_row(form.actif) }}
                    </div>

                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">

                    <a
                        href="{{ path('app_produit_index') }}"
                        class="btn btn-light border"
                    >
                        Annuler
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Enregistrer le produit
                    </button>

                </div>

                {{ form_end(form) }}

            </div>

        </div>

    </div>

</div>


</div>
{% endblock %}
