{# ================================================================
   JAVASCRIPT
   IMPORTANT : ce bloc est EN DEHORS du block body
================================================================ #}

{% block javascripts %}

    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            /* =====================================================
               VOIR / CACHER LES MOTS DE PASSE
            ====================================================== */

            const toggleButtons =
                document.querySelectorAll('.toggle-password');

            toggleButtons.forEach(function (button) {

                button.addEventListener('click', function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const targetId =
                        this.getAttribute('data-target');

                    const input =
                        document.getElementById(targetId);

                    if (!input) {
                        console.error(
                            'Champ mot de passe introuvable : ' +
                            targetId
                        );
                        return;
                    }

                    const icon =
                        this.querySelector('i');

                    const label =
                        this.querySelector('.toggle-label');


                    /* =================================================
                       SI LE CHAMP EST MASQUÉ → AFFICHER
                    ================================================== */

                    if (input.type === 'password') {

                        input.type = 'text';

                        if (icon) {
                            icon.className =
                                'bi bi-eye-slash-fill';
                        }

                        if (label) {
                            label.textContent =
                                'Cacher';
                        }

                        this.setAttribute(
                            'aria-label',
                            'Masquer le mot de passe'
                        );

                        this.setAttribute(
                            'aria-pressed',
                            'true'
                        );

                        this.setAttribute(
                            'title',
                            'Masquer le mot de passe'
                        );

                    }

                    /* =================================================
                       SI LE CHAMP EST VISIBLE → CACHER
                    ================================================== */

                    else {

                        input.type = 'password';

                        if (icon) {
                            icon.className =
                                'bi bi-eye-fill';
                        }

                        if (label) {
                            label.textContent =
                                'Voir';
                        }

                        this.setAttribute(
                            'aria-label',
                            'Afficher le mot de passe'
                        );

                        this.setAttribute(
                            'aria-pressed',
                            'false'
                        );

                        this.setAttribute(
                            'title',
                            'Afficher le mot de passe'
                        );
                    }

                });

            });


            /* =====================================================
               FORCE DU MOT DE PASSE
            ====================================================== */

            const passwordInput =
                document.getElementById('password');

            const strengthContainer =
                document.getElementById('passwordStrength');

            const bars =
                strengthContainer
                    ? strengthContainer.querySelectorAll('.bar')
                    : [];

            const strengthLabel =
                strengthContainer
                    ? strengthContainer.querySelector('.strength-label')
                    : null;


            function updatePasswordStrength() {

                if (
                    !passwordInput ||
                    !strengthContainer ||
                    !strengthLabel
                ) {
                    return;
                }

                const value =
                    passwordInput.value;


                if (value.length === 0) {

                    strengthContainer.classList.remove(
                        'visible'
                    );

                    bars.forEach(function (bar) {

                        bar.classList.remove(
                            'active',
                            'weak',
                            'medium',
                            'strong'
                        );

                    });

                    strengthLabel.textContent = '';

                    return;
                }


                strengthContainer.classList.add(
                    'visible'
                );


                let score = 0;


                if (value.length >= 8) {
                    score++;
                }

                if (/[A-Z]/.test(value)) {
                    score++;
                }

                if (/[0-9]/.test(value)) {
                    score++;
                }

                if (/[^A-Za-z0-9]/.test(value)) {
                    score++;
                }


                bars.forEach(function (bar, index) {

                    bar.classList.remove(
                        'active',
                        'weak',
                        'medium',
                        'strong'
                    );


                    if (index < score) {

                        bar.classList.add('active');


                        if (score <= 2) {

                            bar.classList.add('weak');

                        } else if (score === 3) {

                            bar.classList.add('medium');

                        } else {

                            bar.classList.add('strong');

                        }

                    }

                });


                strengthLabel.classList.remove(
                    'weak',
                    'medium',
                    'strong'
                );


                if (score <= 2) {

                    strengthLabel.textContent =
                        'Faible';

                    strengthLabel.classList.add(
                        'weak'
                    );

                } else if (score === 3) {

                    strengthLabel.textContent =
                        'Moyen';

                    strengthLabel.classList.add(
                        'medium'
                    );

                } else {

                    strengthLabel.textContent =
                        'Fort';

                    strengthLabel.classList.add(
                        'strong'
                    );

                }

            }


            /* =====================================================
               CONFIRMATION MOT DE PASSE
            ====================================================== */

            const confirmationInput =
                document.getElementById(
                    'password_confirmation'
                );

            const passwordMatch =
                document.getElementById(
                    'passwordMatch'
                );


            function checkPasswordMatch() {

                if (
                    !passwordInput ||
                    !confirmationInput ||
                    !passwordMatch
                ) {
                    return;
                }


                const icon =
                    passwordMatch.querySelector('i');

                const text =
                    passwordMatch.querySelector('span');


                const password =
                    passwordInput.value;

                const confirmation =
                    confirmationInput.value;


                if (confirmation.length === 0) {

                    passwordMatch.classList.remove(
                        'visible',
                        'success',
                        'error'
                    );

                    return;
                }


                passwordMatch.classList.add(
                    'visible'
                );


                if (password === confirmation) {

                    passwordMatch.classList.remove(
                        'error'
                    );

                    passwordMatch.classList.add(
                        'success'
                    );


                    if (icon) {
                        icon.className =
                            'bi bi-check-circle-fill';
                    }


                    if (text) {
                        text.textContent =
                            'Les mots de passe correspondent.';
                    }

                } else {

                    passwordMatch.classList.remove(
                        'success'
                    );

                    passwordMatch.classList.add(
                        'error'
                    );


                    if (icon) {
                        icon.className =
                            'bi bi-x-circle-fill';
                    }


                    if (text) {
                        text.textContent =
                            'Les mots de passe ne correspondent pas.';
                    }

                }

            }


            /* =====================================================
               ÉVÉNEMENTS PASSWORD
            ====================================================== */

            if (passwordInput) {

                passwordInput.addEventListener(
                    'input',
                    function () {

                        updatePasswordStrength();

                        checkPasswordMatch();

                    }
                );

            }


            if (confirmationInput) {

                confirmationInput.addEventListener(
                    'input',
                    checkPasswordMatch
                );

            }


            /* =====================================================
               SUBMIT
            ====================================================== */

            const form =
                document.getElementById(
                    'registerForm'
                );

            const registerBtn =
                document.getElementById(
                    'registerBtn'
                );


            if (form && registerBtn) {

                form.addEventListener(
                    'submit',
                    function (event) {

                        if (
                            passwordInput &&
                            confirmationInput &&
                            passwordInput.value !==
                            confirmationInput.value
                        ) {

                            event.preventDefault();

                            checkPasswordMatch();

                            confirmationInput.focus();

                            return;
                        }


                        registerBtn.innerHTML = `
                            <i class="bi bi-arrow-repeat spinner"></i>
                            <span>Création du compte...</span>
                        `;

                        registerBtn.disabled = true;

                    }
                );

            }


            /* =====================================================
               FALLBACK LOGO
            ====================================================== */

            const logoImg =
                document.querySelector(
                    '.auth-logo-wrapper img'
                );


            if (logoImg) {

                logoImg.addEventListener(
                    'error',
                    function () {

                        this.style.display = 'none';

                        const placeholder =
                            this.parentElement.querySelector(
                                '.logo-placeholder'
                            );


                        if (placeholder) {

                            placeholder.style.display =
                                'flex';

                        }

                    }
                );

            }

        });
    </script>

{% endblock %}