{% extends 'auth_base.html.twig' %}

{% block title %}Inscription | Jumbo Score Madagascar{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        :root {
            --jumbo-red: #d71920;
            --jumbo-red-dark: #a90f16;
            --jumbo-yellow: #ffcc00;
            --jumbo-navy: #17223b;
            --jumbo-text: #252a34;
            --jumbo-muted: #737b8c;
            --jumbo-light: #f5f6fa;
            --border-color: #dfe3eb;
            --success: #16834a;
            --danger: #c62828;
        }

        * {
            box-sizing: border-box;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            background:
                radial-gradient(circle at top left, rgba(255, 204, 0, .15), transparent 35%),
                linear-gradient(135deg, #f8f9fc, #eef0f6);
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .auth-card {
            width: 100%;
            max-width: 1100px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            background: #fff;
            border: 1px solid rgba(223, 227, 235, .8);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 22px 65px rgba(23, 34, 59, .15);
        }

        /* Formulaire */

        .auth-form-panel {
            min-width: 0;
            padding: 38px 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .auth-logo-wrapper {
            width: 100%;
            height: 105px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-logo-wrapper img {
            display: block;
            width: 100%;
            max-width: 210px;
            height: 100%;
            object-fit: contain;
        }

        .auth-card h1 {
            margin: 0 0 9px;
            color: var(--jumbo-navy);
            font-size: 29px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .auth-subtitle {
            margin: 0;
            color: var(--jumbo-muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .auth-subtitle i {
            margin-right: 5px;
            color: var(--jumbo-red);
        }

        /* Alertes */

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            margin-bottom: 17px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .alert i {
            flex-shrink: 0;
            margin-top: 2px;
        }

        .alert-danger {
            color: #9f1721;
            background: #fff0f0;
            border: 1px solid #ffd1d4;
        }

        .alert-success {
            color: #17663b;
            background: #edfff4;
            border: 1px solid #bce9cd;
        }

        /* Champs */

        .form-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 14px;
        }

        .form-group {
            min-width: 0;
            margin-bottom: 17px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--jumbo-text);
            font-size: 13px;
            font-weight: 700;
        }

        .form-group label > i {
            margin-right: 5px;
            color: var(--jumbo-red);
        }

        .input-wrapper {
            position: relative;
            width: 100%;
            min-width: 0;
        }

        .input-wrapper .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            color: #858d9d;
            font-size: 15px;
            pointer-events: none;
        }

        .input-wrapper input {
            display: block;
            width: 100%;
            min-width: 0;
            height: 48px;
            padding: 12px 16px 12px 42px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            outline: none;
            background: #fbfcfe;
            color: var(--jumbo-text);
            font-family: inherit;
            font-size: 13px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

        .input-wrapper input::placeholder {
            color: #a3a9b5;
            font-size: 12px;
        }

        .input-wrapper input:hover {
            border-color: #bdc5d3;
            background: #fff;
        }

        .input-wrapper input:focus {
            border-color: var(--jumbo-red);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(215, 25, 32, .09);
        }

        .input-wrapper input:focus ~ .input-icon {
            color: var(--jumbo-red);
        }

        /* Espace réservé au bouton Voir/Cacher */

        .input-wrapper input.has-toggle {
            padding-right: 88px !important;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 7px;
            z-index: 5;
            transform: translateY(-50%);
            min-width: 66px;
            height: 34px;
            padding: 0 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border: 1px solid #f1c7c9;
            border-radius: 8px;
            background: #fff3f3;
            color: var(--jumbo-red);
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, color .2s;
        }

        .toggle-password:hover {
            background: var(--jumbo-red);
            color: #fff;
            border-color: var(--jumbo-red);
        }

        .toggle-password:focus-visible {
            outline: 2px solid var(--jumbo-red);
            outline-offset: 2px;
        }

        .toggle-password i,
        .toggle-password span {
            pointer-events: none;
        }

        /* Indicateur de force */

        .password-strength {
            display: none;
            align-items: center;
            gap: 9px;
            margin-top: 8px;
        }

        .password-strength.visible {
            display: flex;
        }

        .strength-bar {
            flex: 1;
            display: flex;
            gap: 4px;
        }

        .strength-bar .bar {
            height: 4px;
            flex: 1;
            border-radius: 5px;
            background: #e5e7eb;
        }

        .strength-bar .bar.active.weak {
            background: #ef4444;
        }

        .strength-bar .bar.active.medium {
            background: #f59e0b;
        }

        .strength-bar .bar.active.strong {
            background: #10b981;
        }

        .strength-label {
            min-width: 46px;
            font-size: 11px;
            font-weight: 700;
            text-align: right;
        }

        .strength-label.weak {
            color: #ef4444;
        }

        .strength-label.medium {
            color: #b77900;
        }

        .strength-label.strong {
            color: #16834a;
        }

        /* Correspondance des mots de passe */

        .password-match {
            display: none;
            align-items: center;
            gap: 6px;
            margin-top: 7px;
            font-size: 11px;
            font-weight: 600;
        }

        .password-match.visible {
            display: flex;
        }

        .password-match.success {
            color: var(--success);
        }

        .password-match.error {
            color: var(--danger);
        }

        /* Bouton inscription */

        .btn-primary {
            width: 100%;
            min-height: 50px;
            margin-top: 5px;
            padding: 13px 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: none;
            border-radius: 10px;
            background: var(--jumbo-red);
            color: #fff;
            font-family: inherit;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 7px 18px rgba(215, 25, 32, .19);
            transition: background .2s, transform .2s, box-shadow .2s;
        }

        .btn-primary:hover {
            background: var(--jumbo-red-dark);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(215, 25, 32, .25);
        }

        .btn-primary:disabled {
            opacity: .7;
            cursor: wait;
            transform: none;
        }

        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Lien de connexion */

        .auth-footer {
            margin-top: 22px;
            padding-top: 19px;
            border-top: 1px solid #edf0f5;
            color: var(--jumbo-muted);
            font-size: 12px;
            text-align: center;
            line-height: 1.8;
        }

        .auth-footer p {
            margin: 0;
        }

        .auth-footer a {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-left: 4px;
            color: var(--jumbo-red);
            font-weight: 800;
            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        /* Panneau de présentation */

        .auth-visual-panel {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            display: flex;
            align-items: center;
            padding: 48px 42px;
            color: #fff;
            background:
                linear-gradient(145deg, rgba(23, 34, 59, .95), rgba(23, 34, 59, .78)),
                url('{{ asset('images/log.jpg') }}') center / cover no-repeat;
        }

        .auth-visual-panel::before {
            content: "";
            position: absolute;
            z-index: -1;
            width: 320px;
            height: 320px;
            top: -100px;
            right: -100px;
            border-radius: 50%;
            background: rgba(255, 204, 0, .17);
        }

        .auth-visual-panel::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 280px;
            height: 280px;
            left: -140px;
            bottom: -150px;
            border-radius: 50%;
            border: 38px solid rgba(255, 255, 255, .07);
        }

        .visual-content {
            width: 100%;
            position: relative;
            z-index: 1;
        }

        .visual-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 25px;
            padding: 8px 14px;
            border: 1px solid rgba(255, 204, 0, .35);
            border-radius: 30px;
            background: rgba(255, 204, 0, .12);
            color: var(--jumbo-yellow);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .visual-title {
            margin: 0 0 17px;
            color: #fff;
            font-size: clamp(27px, 3vw, 37px);
            line-height: 1.25;
            font-weight: 800;
        }

        .visual-title span {
            color: var(--jumbo-yellow);
        }

        .visual-description {
            margin: 0 0 29px;
            color: rgba(255, 255, 255, .84);
            font-size: 14px;
            line-height: 1.8;
        }

        .feature-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255, 255, 255, .93);
            font-size: 13px;
        }

        .feature-icon {
            width: 35px;
            height: 35px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, .14);
            border-radius: 10px;
            background: rgba(255, 255, 255, .08);
            color: var(--jumbo-yellow);
        }

        .progress-steps {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 34px;
            padding-top: 25px;
            border-top: 1px solid rgba(255, 255, 255, .17);
        }

        .progress-step {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .step-dot {
            width: 31px;
            height: 31px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, .3);
            border-radius: 50%;
            background: rgba(255, 255, 255, .09);
            color: #fff;
            font-size: 12px;
            font-weight: 800;
        }

        .progress-step.active .step-dot {
            background: var(--jumbo-yellow);
            border-color: var(--jumbo-yellow);
            color: var(--jumbo-navy);
        }

        .step-label {
            color: rgba(255, 255, 255, .76);
            font-size: 10px;
            font-weight: 700;
            text-align: center;
        }

        .progress-step.active .step-label {
            color: var(--jumbo-yellow);
        }

        /* Responsive */

        @media (max-width: 900px) {
            .auth-card {
                max-width: 550px;
                grid-template-columns: minmax(0, 1fr);
            }

            .auth-visual-panel {
                order: -1;
                padding: 32px;
            }

            .visual-title {
                font-size: 28px;
            }

            .visual-description {
                margin-bottom: 20px;
            }

            .feature-list {
                gap: 11px;
            }

            .progress-steps {
                margin-top: 23px;
                padding-top: 20px;
            }

            .auth-form-panel {
                padding: 34px 30px;
            }
        }

        @media (max-width: 480px) {
            .auth-container {
                padding: 12px;
            }

            .auth-card {
                border-radius: 16px;
            }

            .auth-form-panel {
                padding: 27px 20px;
            }

            .auth-visual-panel {
                padding: 27px 22px;
            }

            .form-row {
                grid-template-columns: minmax(0, 1fr);
                gap: 0;
            }

            .auth-card h1 {
                font-size: 25px;
            }

            .visual-title {
                font-size: 25px;
            }

            .auth-logo-wrapper {
                height: 80px;
            }

            .auth-logo-wrapper img {
                max-width: 170px;
            }

            .toggle-password {
                right: 6px;
                min-width: 62px;
                padding: 0 6px;
            }

            .input-wrapper input.has-toggle {
                padding-right: 80px !important;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">

        <section class="auth-form-panel">
            <div class="auth-header">
                <div class="auth-logo-wrapper">
                    <img
                        src="{{ asset('images/Fond.png') }}"
                        alt="Logo Jumbo Score Madagascar"
                    >
                </div>

                <h1>Créer un compte</h1>

                <p class="auth-subtitle">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Inscrivez-vous pour accéder à votre espace client.
                </p>
            </div>

            {% for flash in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                    <span>{{ flash }}</span>
                </div>
            {% endfor %}

            {% for flash in app.flashes('success') %}
                <div class="alert alert-success" role="status">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    <span>{{ flash }}</span>
                </div>
            {% endfor %}

            <form
                method="post"
                action="{{ path('app_register') }}"
                id="registerForm"
                autocomplete="on"
            >
                <div class="form-row">
                    <div class="form-group">
                        <label for="prenom">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            Prénom
                        </label>

                        <div class="input-wrapper">
                            <input
                                type="text"
                                id="prenom"
                                name="prenom"
                                placeholder="Votre prénom"
                                required
                                autocomplete="given-name"
                            >

                            <span class="input-icon" aria-hidden="true">
                                <i class="bi bi-person-fill"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="nom">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                            Nom
                        </label>

                        <div class="input-wrapper">
                            <input
                                type="text"
                                id="nom"
                                name="nom"
                                placeholder="Votre nom"
                                required
                                autocomplete="family-name"
                            >

                            <span class="input-icon" aria-hidden="true">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        Adresse e-mail
                    </label>

                    <div class="input-wrapper">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="exemple@email.com"
                            required
                            autocomplete="email"
                        >

                        <span class="input-icon" aria-hidden="true">
                            <i class="bi bi-envelope-fill"></i>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        Mot de passe
                    </label>

                    <div class="input-wrapper">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="has-toggle"
                            placeholder="Choisissez un mot de passe"
                            required
                            minlength="8"
                            autocomplete="new-password"
                        >

                        <span class="input-icon" aria-hidden="true">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <button
                            type="button"
                            class="toggle-password"
                            data-target="password"
                            aria-label="Afficher le mot de passe"
                            aria-pressed="false"
                            title="Afficher le mot de passe"
                        >
                            <i class="bi bi-eye-fill" aria-hidden="true"></i>
                            <span class="toggle-label">Voir</span>
                        </button>
                    </div>

                    <div class="password-strength" id="passwordStrength" aria-live="polite">
                        <div class="strength-bar">
                            <div class="bar"></div>
                            <div class="bar"></div>
                            <div class="bar"></div>
                            <div class="bar"></div>
                        </div>
                        <span class="strength-label"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password_confirmation">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        Confirmer le mot de passe
                    </label>

                    <div class="input-wrapper">
                        <input
                            type="password"
                            id="password_confirmation"
                            name="password_confirmation"
                            class="has-toggle"
                            placeholder="Répétez votre mot de passe"
                            required
                            minlength="8"
                            autocomplete="new-password"
                        >

                        <span class="input-icon" aria-hidden="true">
                            <i class="bi bi-shield-lock-fill"></i>
                        </span>

                        <button
                            type="button"
                            class="toggle-password"
                            data-target="password_confirmation"
                            aria-label="Afficher la confirmation du mot de passe"
                            aria-pressed="false"
                            title="Afficher la confirmation du mot de passe"
                        >
                            <i class="bi bi-eye-fill" aria-hidden="true"></i>
                            <span class="toggle-label">Voir</span>
                        </button>
                    </div>

                    <div class="password-match" id="passwordMatch" aria-live="polite">
                        <i class="bi" aria-hidden="true"></i>
                        <span></span>
                    </div>
                </div>

                <button type="submit" class="btn-primary" id="registerBtn">
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                    <span>S'inscrire</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <div class="auth-footer">
                <p>
                    Vous avez déjà un compte ?
                    <a href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        Se connecter
                    </a>
                </p>
            </div>
        </section>

        <aside class="auth-visual-panel">
            <div class="visual-content">
                <div class="visual-badge">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    Espace client
                </div>

                <h2 class="visual-title">
                    Bienvenue chez
                    <span>Jumbo Score Madagascar.</span>
                </h2>

                <p class="visual-description">
                    Créez votre compte client pour accéder à votre espace
                    et profiter d'une expérience de gestion simple et pratique.
                </p>

                <ul class="feature-list">
                    <li>
                        <span class="feature-icon">
                            <i class="bi bi-person-check" aria-hidden="true"></i>
                        </span>
                        Création rapide de votre compte
                    </li>

                    <li>
                        <span class="feature-icon">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                        </span>
                        Mot de passe protégé
                    </li>

                    <li>
                        <span class="feature-icon">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                        </span>
                        Un espace client dédié
                    </li>
                </ul>

                <div class="progress-steps">
                    <div class="progress-step active">
                        <div class="step-dot">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </div>
                        <span class="step-label">Inscription</span>
                    </div>

                    <div class="progress-step">
                        <div class="step-dot">2</div>
                        <span class="step-label">Compte créé</span>
                    </div>

                    <div class="progress-step">
                        <div class="step-dot">3</div>
                        <span class="step-label">Connexion</span>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('registerForm');
            const passwordInput = document.getElementById('password');
            const confirmationInput = document.getElementById('password_confirmation');
            const strengthContainer = document.getElementById('passwordStrength');
            const matchContainer = document.getElementById('passwordMatch');
            const registerButton = document.getElementById('registerBtn');

            /* Afficher / masquer chaque mot de passe */
            document.querySelectorAll('.toggle-password').forEach(function (button) {
                button.addEventListener('click', function () {
                    const input = document.getElementById(this.dataset.target);

                    if (!input) {
                        return;
                    }

                    const showPassword = input.type === 'password';
                    input.type = showPassword ? 'text' : 'password';

                    const icon = this.querySelector('i');
                    const label = this.querySelector('.toggle-label');

                    if (icon) {
                        icon.className = showPassword
                            ? 'bi bi-eye-slash-fill'
                            : 'bi bi-eye-fill';
                    }

                    if (label) {
                        label.textContent = showPassword ? 'Cacher' : 'Voir';
                    }

                    const fieldLabel = this.dataset.target === 'password'
                        ? 'le mot de passe'
                        : 'la confirmation du mot de passe';

                    this.setAttribute(
                        'aria-label',
                        (showPassword ? 'Masquer ' : 'Afficher ') + fieldLabel
                    );

                    this.setAttribute('aria-pressed', String(showPassword));
                    this.setAttribute(
                        'title',
                        (showPassword ? 'Masquer ' : 'Afficher ') + fieldLabel
                    );
                });
            });

            /* Évaluer la force du mot de passe */
            function updatePasswordStrength() {
                if (!passwordInput || !strengthContainer) {
                    return;
                }

                const value = passwordInput.value;
                const bars = strengthContainer.querySelectorAll('.bar');
                const label = strengthContainer.querySelector('.strength-label');

                if (!value) {
                    strengthContainer.classList.remove('visible');
                    bars.forEach(function (bar) {
                        bar.className = 'bar';
                    });
                    label.textContent = '';
                    label.className = 'strength-label';
                    return;
                }

                strengthContainer.classList.add('visible');

                let score = 0;
                if (value.length >= 8) score++;
                if (/[A-Z]/.test(value)) score++;
                if (/[0-9]/.test(value)) score++;
                if (/[^A-Za-z0-9]/.test(value)) score++;

                const level = score <= 2 ? 'weak' : (score === 3 ? 'medium' : 'strong');
                const text = score <= 2 ? 'Faible' : (score === 3 ? 'Moyen' : 'Fort');

                bars.forEach(function (bar, index) {
                    bar.className = 'bar';

                    if (index < score) {
                        bar.classList.add('active', level);
                    }
                });

                label.textContent = text;
                label.className = 'strength-label ' + level;
            }

            /* Vérifier que les deux mots de passe sont identiques */
            function checkPasswordMatch() {
                if (!passwordInput || !confirmationInput || !matchContainer) {
                    return true;
                }

                const password = passwordInput.value;
                const confirmation = confirmationInput.value;
                const icon = matchContainer.querySelector('i');
                const text = matchContainer.querySelector('span');

                if (!confirmation) {
                    matchContainer.className = 'password-match';
                    text.textContent = '';
                    return false;
                }

                matchContainer.classList.add('visible');

                if (password === confirmation) {
                    matchContainer.classList.remove('error');
                    matchContainer.classList.add('success');
                    icon.className = 'bi bi-check-circle-fill';
                    text.textContent = 'Les mots de passe correspondent.';
                    return true;
                }

                matchContainer.classList.remove('success');
                matchContainer.classList.add('error');
                icon.className = 'bi bi-x-circle-fill';
                text.textContent = 'Les mots de passe ne correspondent pas.';
                return false;
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', function () {
                    updatePasswordStrength();

                    if (confirmationInput && confirmationInput.value) {
                        checkPasswordMatch();
                    }
                });
            }

            if (confirmationInput) {
                confirmationInput.addEventListener('input', checkPasswordMatch);
            }

            /* Vérification avant l'envoi */
            if (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        return;
                    }

                    if (passwordInput.value !== confirmationInput.value) {
                        event.preventDefault();
                        checkPasswordMatch();
                        confirmationInput.focus();
                        return;
                    }

                    if (registerButton) {
                        registerButton.disabled = true;
                        registerButton.innerHTML =
                            '<i class="bi bi-arrow-repeat spinner" aria-hidden="true"></i>' +
                            '<span>Création du compte...</span>';
                    }
                });
            }

            /* Afficher un message de secours si le logo est introuvable */
            const logo = document.querySelector('.auth-logo-wrapper img');

            if (logo) {
                logo.addEventListener('error', function () {
                    this.style.display = 'none';
                });
            }
        });
    </script>
{% endblock %}