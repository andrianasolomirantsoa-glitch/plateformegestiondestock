{% extends 'auth_base.html.twig' %}

{% block title %}Connexion | Jumbo Score Madagascar{% endblock %}

{% block body %}
<style>
    :root {
        --jumbo-red: #d71920;
        --jumbo-red-dark: #a90f16;
        --jumbo-yellow: #ffcc00;
        --jumbo-navy: #17223b;
        --jumbo-text: #252a34;
        --jumbo-muted: #737b8c;
        --jumbo-light: #f5f6fa;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: var(--jumbo-light);
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 20px;
        background:
            radial-gradient(circle at top left, rgba(255, 204, 0, .16), transparent 35%),
            linear-gradient(135deg, #f8f9fc 0%, #eef0f6 100%);
    }

    .auth-card {
        width: 100%;
        max-width: 1050px;
        min-height: 590px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 22px 65px rgba(23, 34, 59, .15);
    }

    /* Partie visuelle */
    .auth-visual {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 42px;
        color: #fff;
        background:
            linear-gradient(145deg, rgba(23, 34, 59, .92), rgba(23, 34, 59, .72)),
            url('{{ asset('images/log.jpg') }}') center / cover no-repeat;
        isolation: isolate;
    }

    .auth-visual::before {
        content: "";
        position: absolute;
        z-index: -1;
        width: 250px;
        height: 250px;
        right: -90px;
        top: 90px;
        border-radius: 50%;
        background: rgba(255, 204, 0, .18);
    }

    .auth-visual::after {
        content: "";
        position: absolute;
        z-index: -1;
        width: 300px;
        height: 300px;
        left: -130px;
        bottom: -120px;
        border-radius: 50%;
        border: 45px solid rgba(255, 255, 255, .07);
    }

    .brand-logo {
        width: 175px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
        padding: 10px;
        background: #fff;
        border-radius: 12px;
    }

    .visual-content {
        position: relative;
        z-index: 1;
        margin: auto 0;
        padding: 35px 0;
    }

    .visual-tag {
        display: inline-block;
        padding: 8px 14px;
        margin-bottom: 20px;
        color: var(--jumbo-yellow);
        background: rgba(255, 204, 0, .13);
        border: 1px solid rgba(255, 204, 0, .35);
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .visual-content h1 {
        max-width: 420px;
        margin: 0 0 18px;
        font-size: clamp(30px, 3.5vw, 43px);
        line-height: 1.18;
        font-weight: 800;
    }

    .visual-content h1 span {
        color: var(--jumbo-yellow);
    }

    .visual-content p {
        max-width: 390px;
        color: rgba(255, 255, 255, .82);
        font-size: 15px;
        line-height: 1.8;
    }

    .visual-footer {
        position: relative;
        z-index: 1;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, .2);
        color: rgba(255, 255, 255, .75);
        font-size: 12px;
    }

    /* Formulaire */
    .auth-form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px;
    }

    .auth-form-content {
        width: 100%;
        max-width: 390px;
    }

    .form-heading {
        margin-bottom: 32px;
    }

    .form-heading .eyebrow {
        display: block;
        margin-bottom: 10px;
        color: var(--jumbo-red);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }

    .form-heading h2 {
        margin: 0 0 10px;
        color: var(--jumbo-navy);
        font-size: 31px;
        font-weight: 800;
    }

    .form-heading p {
        margin: 0;
        color: var(--jumbo-muted);
        font-size: 14px;
        line-height: 1.7;
    }

    .alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 20px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.6;
    }

    .alert-danger {
        color: #9f1721;
        background: #fff0f0;
        border: 1px solid #ffd1d4;
    }

    .alert-success {
        color: #17663b;
        background: #edfff4;
        border: 1px solid #bce9cd;
    }

    .form-group {
        margin-bottom: 21px;
    }

    .form-group label {
        display: block;
        margin-bottom: 9px;
        color: var(--jumbo-text);
        font-size: 13px;
        font-weight: 700;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        color: #8a91a1;
        font-size: 17px;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        min-height: 51px;
        padding: 13px 55px 13px 45px;
        color: var(--jumbo-text);
        background: #fbfcfe;
        border: 1px solid #dfe3eb;
        border-radius: 10px;
        outline: none;
        font-family: inherit;
        font-size: 14px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    .form-control::placeholder {
        color: #a3a9b5;
    }

    .form-control:focus {
        background: #fff;
        border-color: var(--jumbo-red);
        box-shadow: 0 0 0 4px rgba(215, 25, 32, .09);
    }

    /* Bouton afficher/masquer le mot de passe */
    .toggle-password {
        position: absolute;
        top: 50%;
        right: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        padding: 0;
        color: #777f90;
        background: transparent;
        border: none;
        border-radius: 8px;
        transform: translateY(-50%);
        cursor: pointer;
        transition: color .2s, background .2s;
    }

    .toggle-password:hover {
        color: var(--jumbo-red);
        background: #fff0f0;
    }

    .toggle-password:focus-visible {
        outline: 2px solid var(--jumbo-red);
        outline-offset: 2px;
    }

    .toggle-password i {
        font-size: 19px;
        line-height: 1;
    }

    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 3px 0 25px;
        color: var(--jumbo-muted);
        font-size: 12px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
    }

    .remember-me input {
        accent-color: var(--jumbo-red);
    }

    .btn-login {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 18px;
        color: #fff;
        background: var(--jumbo-red);
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(215, 25, 32, .2);
        transition: background .2s, transform .2s, box-shadow .2s;
    }

    .btn-login:hover {
        background: var(--jumbo-red-dark);
        box-shadow: 0 11px 22px rgba(215, 25, 32, .27);
        transform: translateY(-1px);
    }

    .btn-login:active {
        transform: translateY(0);
    }

    .register-link {
        margin-top: 27px;
        color: var(--jumbo-muted);
        font-size: 13px;
        text-align: center;
        line-height: 1.8;
    }

    .register-link a {
        color: var(--jumbo-red);
        font-weight: 800;
        text-decoration: none;
    }

    .register-link a:hover {
        text-decoration: underline;
    }

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 22px;
        color: #858c9a;
        font-size: 11px;
    }

    .security-note i {
        color: #29965b;
        font-size: 14px;
    }

    @media (max-width: 800px) {
        .auth-card {
            max-width: 520px;
            grid-template-columns: 1fr;
        }

        .auth-visual {
            min-height: 260px;
            padding: 28px;
        }

        .brand-logo {
            width: 135px;
        }

        .visual-content {
            padding: 28px 0 10px;
        }

        .visual-content h1 {
            font-size: 30px;
        }

        .visual-content p {
            font-size: 13px;
        }

        .visual-footer {
            margin-top: 10px;
        }

        .auth-form-panel {
            padding: 35px 28px;
        }
    }

    @media (max-width: 420px) {
        .login-page {
            padding: 15px 10px;
        }

        .auth-card {
            border-radius: 16px;
        }

        .auth-visual {
            padding: 22px;
        }

        .auth-form-panel {
            padding: 30px 22px;
        }

        .form-heading h2 {
            font-size: 27px;
        }

        .form-options {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            transition: none !important;
            scroll-behavior: auto !important;
        }
    }
    
/* Correction définitive du champ mot de passe */
.input-wrapper:has(#password) {
    position: relative !important;
    width: 100%;
}

.input-wrapper #password {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding-left: 45px !important;
    padding-right: 65px !important;
    overflow: hidden;
}

/* Icône œil : reste dans une zone réservée à droite */
.input-wrapper #togglePassword {
    position: absolute !important;
    top: 50% !important;
    right: 8px !important;
    z-index: 10;
    width: 32px;
    height: 32px;
    padding: 0;
    margin: 0;
    transform: translateY(-50%) !important;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: none;
    border-radius: 7px;
    cursor: pointer;
}

/* Évite que l'icône masque les derniers caractères */
.input-wrapper #password:focus {
    padding-right: 65px !important;
}

/* Corriger le champ e-mail / nom d'utilisateur */
.input-wrapper #username {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding-left: 45px !important;
    padding-right: 20px !important;
}

/* Garder l'icône utilisateur à gauche */
.input-wrapper:has(#username) {
    position: relative !important;
    width: 100%;
}

.input-wrapper:has(#username) .input-icon {
    left: 15px;
    z-index: 2;
}

</style>

<div class="login-page">
    <div class="auth-card">

        {# Panneau visuel #}
        <section class="auth-visual">
            <div>
                <img
                    src="{{ asset('images/jumbo-score-logo.png') }}"
                    alt="Jumbo Score Madagascar"
                    class="brand-logo"
                >
            </div>

            <div class="visual-content">
                <span class="visual-tag">Gestion de stock</span>

                <h1>
                    Bienvenue sur votre
                    <span>espace de gestion.</span>
                </h1>

                <p>
                    Connectez-vous pour gérer vos produits, suivre les stocks
                    et organiser vos opérations en toute simplicité.
                </p>
            </div>

            <div class="visual-footer">
                &copy; {{ "now"|date("Y") }} Jumbo Score Madagascar.
                Tous droits réservés.
            </div>
        </section>

        {# Panneau de connexion #}
        <section class="auth-form-panel">
            <div class="auth-form-content">

                <div class="form-heading">
                    <span class="eyebrow">Votre espace professionnel</span>
                    <h2>Connexion</h2>
                    <p>Entrez vos identifiants pour accéder à votre compte.</p>
                </div>

                {# Message d'erreur de connexion #}
                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    </div>
                {% endif %}

                {# Messages flash #}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success" role="status">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="form-group">
                        <label for="username">Nom d'utilisateur ou adresse e-mail</label>

                        <div class="input-wrapper">
                            <i class="bi bi-person input-icon" aria-hidden="true"></i>

                            <input
                                type="text"
                                id="username"
                                name="_username"
                                class="form-control"
                                value="{{ last_username|default('') }}"
                                placeholder="Entrez votre identifiant"
                                autocomplete="username"
                                required
                                autofocus
                            >
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Mot de passe</label>

                        <div class="input-wrapper">
                            <i class="bi bi-lock input-icon" aria-hidden="true"></i>

                            <input
                                type="password"
                                id="password"
                                name="_password"
                                class="form-control"
                                placeholder="Entrez votre mot de passe"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                class="toggle-password"
                                id="togglePassword"
                                aria-label="Afficher le mot de passe"
                                aria-pressed="false"
                                title="Afficher le mot de passe"
                            >
                                <i class="bi bi-eye" id="togglePasswordIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="remember-me" for="rememberMe">
                            <input
                                type="checkbox"
                                id="rememberMe"
                                name="_remember_me"
                            >
                            <span>Se souvenir de moi</span>
                        </label>
                    </div>

                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                    >

                    <button type="submit" class="btn-login">
                        <span>Se connecter</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>

                <div class="register-link">
                    Vous n'avez pas encore de compte ?
                    <br>
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </div>

                <div class="security-note">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Connexion sécurisée</span>
                </div>

            </div>
        </section>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const passwordInput = document.getElementById('password');
        const toggleButton = document.getElementById('togglePassword');
        const toggleIcon = document.getElementById('togglePasswordIcon');

        if (!passwordInput || !toggleButton || !toggleIcon) {
            return;
        }

        toggleButton.addEventListener('click', function () {
            const isPasswordHidden = passwordInput.type === 'password';

            passwordInput.type = isPasswordHidden ? 'text' : 'password';

            toggleIcon.classList.toggle('bi-eye', !isPasswordHidden);
            toggleIcon.classList.toggle('bi-eye-slash', isPasswordHidden);

            toggleButton.setAttribute(
                'aria-label',
                isPasswordHidden ? 'Masquer le mot de passe' : 'Afficher le mot de passe'
            );

            toggleButton.setAttribute(
                'title',
                isPasswordHidden ? 'Masquer le mot de passe' : 'Afficher le mot de passe'
            );

            toggleButton.setAttribute(
                'aria-pressed',
                isPasswordHidden ? 'true' : 'false'
            );
        });
    });
</script>
{% endblock %}
