{% extends 'auth_base.html.twig' %}

{% block title %}Connexion - Gestion de Stock{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            /* Nouvelle palette moderne */
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --accent-color: #f59e0b;
            --accent-light: #fef3c7;
            --secondary-color: #64748b;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --warning-color: #f59e0b;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
            --text-gray: #64748b;
            --card-shadow: 0 30px 60px -15px rgba(15, 23, 42, 0.25);
            --input-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
            --transition-smooth: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: 
                radial-gradient(circle at 15% 20%, rgba(79, 70, 229, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(245, 158, 11, 0.06) 0%, transparent 45%),
                linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
            padding: 24px;
            position: relative;
            overflow: hidden;
        }

        /* Particules décoratives flottantes */
        .auth-container::before,
        .auth-container::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(2px);
        }

        .auth-container::before {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.12) 0%, transparent 70%);
            top: -120px;
            right: -80px;
            animation: float 10s ease-in-out infinite;
        }

        .auth-container::after {
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.10) 0%, transparent 70%);
            bottom: -100px;
            left: -80px;
            animation: float 12s ease-in-out infinite reverse;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(25px, -25px) scale(1.06); }
        }

        /* ===== Carte principale ===== */
        .auth-card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #ffffff;
            border-radius: 28px;
            width: 100%;
            max-width: 1040px;
            min-height: 640px;
            box-shadow: var(--card-shadow);
            animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ===== PANNEAU GAUCHE : FORMULAIRE ===== */
        .auth-form-panel {
            padding: 52px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            background: #ffffff;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .auth-logo-wrapper {
            width: 76px;
            height: 76px;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, #eef2ff, #e0e7ff);
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            transition: var(--transition-smooth);
            border: 2px solid #e0e7ff;
            box-shadow: 0 8px 20px -8px rgba(79, 70, 229, 0.35);
        }

        .auth-logo-wrapper:hover {
            transform: scale(1.06) rotate(-3deg);
            border-color: var(--primary-color);
            box-shadow: 0 14px 35px -8px rgba(79, 70, 229, 0.45);
        }

        .auth-logo-wrapper img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 10px;
        }

        .auth-logo-wrapper .logo-placeholder {
            font-size: 36px;
            color: var(--primary-color);
        }

        .auth-card h1 {
            font-size: 27px;
            font-weight: 800;
            color: var(--text-dark);
            margin: 0 0 8px 0;
            letter-spacing: -0.7px;
            background: linear-gradient(135deg, #0f172a, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .auth-subtitle {
            color: var(--text-gray);
            font-size: 14px;
            margin: 0;
            line-height: 1.55;
            font-weight: 500;
        }

        .auth-subtitle i {
            color: var(--primary-color);
            margin-right: 5px;
        }

        /* ===== Formulaire ===== */
        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
            letter-spacing: 0.1px;
        }

        .form-group label i {
            margin-right: 6px;
            color: var(--primary-color);
            font-size: 14px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper .input-icon {
            position: absolute;
            left: 15px;
            color: #94a3b8;
            font-size: 16px;
            transition: color 0.3s ease;
            pointer-events: none;
        }

        .input-wrapper input {
            width: 100%;
            padding: 14px 15px 14px 46px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            transition: var(--transition-smooth);
            background: #f8fafc;
            color: var(--text-dark);
            font-family: inherit;
        }

        .input-wrapper input:hover {
            border-color: #cbd5e1;
        }

        .input-wrapper input:focus {
            outline: none;
            border-color: var(--primary-color);
            background: #ffffff;
            box-shadow: var(--input-shadow);
        }

        .input-wrapper input:focus ~ .input-icon {
            color: var(--primary-color);
        }

        .input-wrapper input::placeholder {
            color: #94a3b8;
            font-size: 13.5px;
            font-weight: 400;
        }

        .input-wrapper .toggle-password {
            position: absolute;
            right: 15px;
            cursor: pointer;
            color: #94a3b8;
            transition: color 0.3s ease;
            font-size: 16px;
            background: none;
            border: none;
            padding: 4px;
            display: flex;
            align-items: center;
        }

        .input-wrapper .toggle-password:hover {
            color: var(--primary-color);
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 8px 0 24px;
        }

        .form-options .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-gray);
            cursor: pointer;
            transition: color 0.3s ease;
            font-weight: 500;
        }

        .form-options .checkbox-label:hover {
            color: var(--text-dark);
        }

        .form-options .checkbox-label input[type="checkbox"] {
            width: 17px;
            height: 17px;
            accent-color: var(--primary-color);
            cursor: pointer;
        }

        /* ===== Bouton principal ===== */
        .btn-primary {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #7c3aed 100%);
            background-size: 200% 200%;
            color: white;
            border: none;
            border-radius: 13px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.3px;
            box-shadow: 0 10px 25px -8px rgba(79, 70, 229, 0.5);
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.7s ease;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            background-position: 100% 50%;
            transform: translateY(-2px);
            box-shadow: 0 15px 35px -8px rgba(79, 70, 229, 0.6);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary i {
            font-size: 17px;
        }

        .btn-primary .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .btn-primary:disabled {
            opacity: 0.75;
            cursor: not-allowed;
            transform: none;
        }

        /* ===== Pied de page ===== */
        .auth-footer {
            text-align: center;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid var(--border-color);
        }

        .auth-footer p {
            color: var(--text-gray);
            font-size: 13px;
            margin: 0;
            font-weight: 500;
        }

        .auth-footer a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 700;
            transition: var(--transition-smooth);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .auth-footer a:hover {
            color: var(--primary-hover);
            transform: translateX(3px);
        }

        .auth-footer a i {
            font-size: 13px;
        }

        /* ===== PANNEAU DROIT : VISUEL ===== */
        .auth-visual-panel {
            background: 
                radial-gradient(circle at 100% 0%, rgba(99, 102, 241, 0.5) 0%, transparent 50%),
                radial-gradient(circle at 0% 100%, rgba(124, 58, 237, 0.4) 0%, transparent 50%),
                linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            padding: 52px 44px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
            color: white;
        }

        /* Grille décorative */
        .auth-visual-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
            -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
        }

        .auth-visual-panel::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 55%);
            animation: rotate 35s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .visual-content {
            position: relative;
            z-index: 2;
        }

        .visual-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 26px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            width: fit-content;
            color: #fef3c7;
        }

        .visual-badge i {
            font-size: 14px;
            color: var(--accent-color);
        }

        .auth-visual-panel h2 {
            font-size: 30px;
            font-weight: 800;
            margin: 0 0 14px 0;
            line-height: 1.25;
            letter-spacing: -0.8px;
            background: linear-gradient(135deg, #ffffff 0%, #c7d2fe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .auth-visual-panel > .visual-content > p {
            font-size: 14.5px;
            line-height: 1.7;
            opacity: 0.88;
            margin: 0 0 32px 0;
            color: #e0e7ff;
            font-weight: 400;
        }

        /* ===== Liste des fonctionnalités ===== */
        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0 0 36px 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 14px;
            opacity: 0.96;
            color: #e0e7ff;
            font-weight: 500;
            transition: var(--transition-smooth);
        }

        .feature-list li:hover {
            transform: translateX(4px);
            color: #ffffff;
        }

        .feature-list li .feature-icon {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(245, 158, 11, 0.08));
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 1px solid rgba(245, 158, 11, 0.35);
            color: var(--accent-color);
            box-shadow: 0 4px 12px -4px rgba(245, 158, 11, 0.4);
        }

        .feature-list li .feature-icon i {
            font-size: 16px;
        }

        /* ===== Statistiques ===== */
        .stats-section {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .stat-item {
            text-align: center;
            padding: 16px 10px;
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 15px;
            transition: var(--transition-smooth);
            border: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
            overflow: hidden;
        }

        .stat-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .stat-item:hover {
            background: rgba(255, 255, 255, 0.13);
            transform: translateY(-4px);
            box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.4);
            border-color: rgba(245, 158, 11, 0.4);
        }

        .stat-item:hover::before {
            opacity: 1;
        }

        .stat-item .stat-icon {
            font-size: 18px;
            display: block;
            margin-bottom: 6px;
            color: var(--accent-color);
        }

        .stat-item .stat-number {
            font-size: 21px;
            font-weight: 800;
            display: block;
            line-height: 1.2;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .stat-item .stat-label {
            font-size: 10px;
            opacity: 0.85;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 600;
            margin-top: 5px;
            display: block;
            line-height: 1.3;
            color: #c7d2fe;
        }

        /* ===== Alertes ===== */
        .alert {
            padding: 13px 17px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 11px;
            animation: slideDown 0.4s ease-out;
            border: 1px solid transparent;
            font-size: 13px;
            font-weight: 500;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .alert-danger {
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
            border-color: #fecaca;
            color: #b91c1c;
        }

        .alert-success {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            border-color: #bbf7d0;
            color: #15803d;
        }

        .alert i {
            font-size: 17px;
            flex-shrink: 0;
        }

        /* ===== Séparateur social ===== */
        .social-login {
            margin-top: 22px;
        }

        .social-login .divider {
            text-align: center;
            color: var(--text-gray);
            font-size: 12px;
            margin: 0 0 16px 0;
            position: relative;
            font-weight: 500;
            letter-spacing: 0.2px;
        }

        .social-login .divider::before,
        .social-login .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 30%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border-color), transparent);
        }

        .social-login .divider::before { left: 0; }
        .social-login .divider::after { right: 0; }

        .social-buttons {
            display: flex;
            gap: 10px;
        }

        .social-btn {
            flex: 1;
            padding: 11px;
            border: 1.5px solid var(--border-color);
            border-radius: 12px;
            background: white;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
        }

        .social-btn:hover {
            border-color: var(--primary-color);
            background: var(--primary-light);
            transform: translateY(-2px);
            box-shadow: 0 8px 18px -6px rgba(79, 70, 229, 0.3);
        }

        .social-btn i {
            font-size: 17px;
        }

        .social-btn.google i { color: #DB4437; }
        .social-btn.microsoft i { color: #00A4EF; }

        /* ===== Responsive ===== */
        @media (max-width: 900px) {
            .auth-card {
                grid-template-columns: 1fr;
                max-width: 480px;
                min-height: auto;
            }

            .auth-visual-panel {
                padding: 40px 32px;
                order: -1;
            }

            .auth-visual-panel h2 { font-size: 23px; }

            .feature-list { display: none; }

            .auth-form-panel { padding: 40px 30px; }
        }

        @media (max-width: 480px) {
            .auth-container { padding: 14px; }
            .auth-card { border-radius: 22px; }
            .auth-form-panel { padding: 30px 22px; }
            .auth-visual-panel { padding: 30px 22px; }
            .auth-card h1 { font-size: 23px; }
            .auth-visual-panel h2 { font-size: 21px; }

            .auth-logo-wrapper {
                width: 64px;
                height: 64px;
                padding: 11px;
            }

            .auth-logo-wrapper .logo-placeholder { font-size: 30px; }

            .form-options {
                flex-direction: column;
                gap: 10px;
                align-items: flex-start;
            }

            .social-buttons { flex-direction: column; }

            .stats-section {
                grid-template-columns: 1fr;
                gap: 8px;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="auth-container">
    <div class="auth-card">

        <!-- ===== PANNEAU GAUCHE : FORMULAIRE ===== -->
        <div class="auth-form-panel">

            <div class="auth-header">
                <div class="auth-logo-wrapper">
                    <img 
                        src="{{ asset('images/logo-stock-management.png') }}" 
                        alt="Logo Gestion de Stock"
                        onerror="this.style.display='none'; this.parentElement.querySelector('.logo-placeholder').style.display='block';"
                    >
                    <span class="logo-placeholder" style="display: none;">
                        <i class="bi bi-box-seam"></i>
                    </span>
                </div>
                <h1>Connexion</h1>
                <p class="auth-subtitle">
                    <i class="bi bi-shield-check"></i>
                    Gérez votre inventaire en toute sécurité
                </p>
            </div>

            {% if error %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            {% if app.session.flashbag.has('success') %}
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{{ app.flashes('success')[0] }}</span>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" id="loginForm">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <label for="email">
                        <i class="bi bi-envelope"></i>
                        Adresse email
                    </label>
                    <div class="input-wrapper">
                        <input
                            type="email"
                            id="email"
                            name="_username"
                            placeholder="exemple@email.com"
                            required
                            autofocus
                            value="{{ last_username }}"
                        >
                        <span class="input-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">
                        <i class="bi bi-key"></i>
                        Mot de passe
                    </label>
                    <div class="input-wrapper">
                        <input
                            type="password"
                            id="password"
                            name="_password"
                            placeholder="Votre mot de passe"
                            required
                        >
                        <span class="input-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <button type="button" class="toggle-password" aria-label="Afficher le mot de passe">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="checkbox-label">
                        <input type="checkbox" name="_remember_me">
                        <i class="bi bi-check-circle"></i>
                        Se souvenir de moi
                    </label>
                </div>

                <button type="submit" class="btn-primary" id="loginBtn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Se connecter</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="social-login">
                <p class="divider">Ou connectez-vous avec</p>
                <div class="social-buttons">
                    <button class="social-btn google" onclick="alert('Connexion Google en cours de développement')">
                        <i class="bi bi-google"></i>
                        Google
                    </button>
                    <button class="social-btn microsoft" onclick="alert('Connexion Microsoft en cours de développement')">
                        <i class="bi bi-microsoft"></i>
                        Microsoft
                    </button>
                </div>
            </div>

            <div class="auth-footer">
                <p>
                    Vous n'avez pas encore de compte ?
                    <a href="{{ path('app_register') }}">
                        <i class="bi bi-person-plus-fill"></i>
                        Créer un compte
                    </a>
                </p>
            </div>

        </div>

        <!-- ===== PANNEAU DROIT : VISUEL ===== -->
