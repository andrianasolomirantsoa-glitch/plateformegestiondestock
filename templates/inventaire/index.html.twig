{% extends 'base.html.twig' %}

{% block title %}Inventaires | Jumbo Score{% endblock %}

{% block stylesheets %}
<style>
    .inv-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .inv-title {
        font-size: 1.65rem;
        font-weight: 800;
        color: #172033;
        margin-bottom: 5px;
    }

    .inv-subtitle {
        color: #64748b;
        font-size: .9rem;
        margin: 0;
    }

    .inv-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 11px;
        background: linear-gradient(135deg, #0891b2, #6366f1);
        box-shadow: 0 5px 15px rgba(59,130,246,.18);
        transition: .2s;
    }

    .inv-btn-primary:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(59,130,246,.25);
    }

    .inv-stat-card {
        height: 100%;
        padding: 20px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15,23,42,.035);
    }

    .inv-stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .inv-stat-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.2rem;
    }

    .inv-stat-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: #172033;
        line-height: 1;
    }

    .inv-stat-label {
        color: #64748b;
        font-size: .85rem;
        font-weight: 600;
    }

    .inv-panel {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15,23,42,.035);
        overflow: hidden;
    }

    .inv-panel-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .inv-panel-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #172033;
        margin: 0;
    }

    .inv-table {
        margin: 0;
        white-space: nowrap;
    }

    .inv-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: .74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .045em;
        padding: 15px 18px;
        border-bottom: 1px solid #e9eef5;
    }

    .inv-table tbody td {
        padding: 16px 18px;
        vertical-align: middle;
        color: #334155;
        font-size: .87rem;
        border-bottom: 1px solid #f0f2f6;
    }

    .inv-table tbody tr:last-child td {
        border-bottom: none;
    }

    .inv-table tbody tr:hover {
        background: #f8fbff;
    }

    .inv-reference {
        font-weight: 800;
        color: #334155;
    }

    .inv-store {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 650;
    }

    .inv-store-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #ecfeff;
        color: #0891b2;
    }

    .inv-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 30px;
        font-size: .73rem;
        font-weight: 800;
    }

    .inv-status.pending {
        color: #a16207;
        background: #fef9c3;
    }

    .inv-status.valid {
        color: #15803d;
        background: #dcfce7;
    }

    .inv-status.cancelled {
        color: #64748b;
        background: #f1f5f9;
    }

    .inv-action {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #475569;
        background: #f1f5f9;
        transition: .2s;
    }

    .inv-action:hover {
        color: #0891b2;
        background: #ecfeff;
    }

    .inv-empty {
        padding: 55px 20px;
        text-align: center;
    }

    .inv-empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        color: #0891b2;
        background: #ecfeff;
        font-size: 1.8rem;
    }

    @media (max-width: 767px) {
        .inv-title {
            font-size: 1.35rem;
        }

        .inv-header .inv-btn-primary {
            width: 100%;
            justify-content: center;
        }
    }
</style>
{% endblock %}

{% block header_title %}{% endblock %}

{% block body %}

{% set total = inventaires|length %}
{% set en_cours = inventaires|filter(i => i.statut == 'EN_COURS')|length %}
{% set valides = inventaires|filter(i => i.statut == 'VALIDE')|length %}
{% set annules = inventaires|filter(i => i.statut == 'ANNULE')|length %}

<div class="inv-header">

    <div>
        <h1 class="inv-title">
            <i class="bi bi-clipboard2-check text-info me-2"></i>
            Gestion des inventaires
        </h1>

        <p class="inv-subtitle">
            Suivi des comptages physiques et régularisation des stocks par magasin.
        </p>
    </div>

    <a href="{{ path('admin_inventaire_new') }}" class="inv-btn-primary">
        <i class="bi bi-plus-circle-fill"></i>
        Nouvel inventaire
    </a>

</div>

{# STATISTIQUES #}

<div class="row g-3 mb-4">

    <div class="col-6 col-xl-3">
        <div class="inv-stat-card">
            <div class="inv-stat-top">
                <span class="inv-stat-label">Total inventaires</span>
                <span class="inv-stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-clipboard-data"></i>
                </span>
            </div>
            <div class="inv-stat-number">{{ total }}</div>
            <div class="text-muted small mt-2">Tous les inventaires</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="inv-stat-card">
            <div class="inv-stat-top">
                <span class="inv-stat-label">En cours</span>
                <span class="inv-stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </span>
            </div>
            <div class="inv-stat-number">{{ en_cours }}</div>
            <div class="text-muted small mt-2">Comptages à terminer</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="inv-stat-card">
            <div class="inv-stat-top">
                <span class="inv-stat-label">Validés</span>
                <span class="inv-stat-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle"></i>
                </span>
            </div>
            <div class="inv-stat-number">{{ valides }}</div>
            <div class="text-muted small mt-2">Inventaires terminés</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="inv-stat-card">
            <div class="inv-stat-top">
                <span class="inv-stat-label">Annulés</span>
                <span class="inv-stat-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-x-circle"></i>
                </span>
            </div>
            <div class="inv-stat-number">{{ annules }}</div>
            <div class="text-muted small mt-2">Inventaires annulés</div>
        </div>
    </div>

</div>

{# TABLEAU DES INVENTAIRES #}

<div class="inv-panel">

    <div class="inv-panel-header">

        <div>
            <h2 class="inv-panel-title">
                <i class="bi bi-list-ul text-info me-2"></i>
                Historique des inventaires
            </h2>

            <div class="text-muted small mt-1">
                Consulte et suis les inventaires de tes magasins.
            </div>
        </div>

        <span class="badge rounded-pill text-bg-light border px-3 py-2">
            {{ total }} résultat(s)
        </span>

    </div>

    {% if inventaires is not empty %}

        <div class="table-responsive">

            <table class="table inv-table align-middle">

                <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Magasin</th>
                        <th>Date inventaire</th>
                        <th>Responsable</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for inventaire in inventaires %}

                    <tr>

                        <td>
                            <span class="inv-reference">
                                INV-{{ "%04d"|format(inventaire.id) }}
                            </span>
                        </td>

                        <td>
                            <div class="inv-store">
                                <span class="inv-store-icon">
                                    <i class="bi bi-shop"></i>
                                </span>
                                <span>{{ inventaire.magasin.nom }}</span>
                            </div>
                        </td>

                        <td>
                            <i class="bi bi-calendar3 text-muted me-1"></i>
                            {{ inventaire.dateInventaire|date('d/m/Y H:i') }}
                        </td>

                        <td>
                            {% if inventaire.utilisateur %}
                                {{ inventaire.utilisateur.nom }}
                                {{ inventaire.utilisateur.prenom }}
                            {% else %}
                                <span class="text-muted">Non renseigné</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if inventaire.statut == 'EN_COURS' %}
                                <span class="inv-status pending">
                                    <i class="bi bi-hourglass-split"></i>
                                    En cours
                                </span>
                            {% elseif inventaire.statut == 'VALIDE' %}
                                <span class="inv-status valid">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Validé
                                </span>
                            {% else %}
                                <span class="inv-status cancelled">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Annulé
                                </span>
                            {% endif %}
                        </td>

                        <td class="text-center">

                            <a
                                href="{{ path('admin_inventaire_show', {id: inventaire.id}) }}"
                                class="inv-action"
                                title="Voir les détails"
                            >
                                <i class="bi bi-eye-fill"></i>
                            </a>

                            {% if inventaire.statut == 'EN_COURS' %}
                                <a
                                    href="{{ path('admin_inventaire_comptage', {id: inventaire.id}) }}"
                                    class="inv-action ms-1"
                                    title="Continuer le comptage"
                                >
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            {% endif %}

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    {% else %}

        <div class="inv-empty">

            <div class="inv-empty-icon">
                <i class="bi bi-clipboard2-x"></i>
            </div>

            <h5 class="fw-bold text-dark">
                Aucun inventaire pour le moment
            </h5>

            <p class="text-muted mb-4">
                Commence par créer un inventaire pour l'un de tes magasins.
            </p>

            <a href="{{ path('admin_inventaire_new') }}" class="inv-btn-primary">
                <i class="bi bi-plus-circle"></i>
                Créer mon premier inventaire
            </a>

        </div>

    {% endif %}

</div>

{% endblock %}
