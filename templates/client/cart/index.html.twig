{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}

<style>

    /* =========================================================
       PAGE PANIER CLIENT
       ========================================================= */

    .client-cart-page {
        max-width: 1350px;
        margin: 0 auto;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .cart-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 24px;
    }

    .cart-page-header small {
        display: block;

        margin-bottom: 5px;

        color: #7f899c;

        font-size: 10px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .cart-page-header h1 {
        margin: 0;

        color: #172033;

        font-size: 29px;
        font-weight: 800;
    }

    .cart-page-header p {
        margin: 7px 0 0;

        color: #7d8799;

        font-size: 12px;
    }

    .cart-item-count {
        padding: 10px 13px;

        border: 1px solid #e8ebf1;
        border-radius: 10px;

        background: white;

        color: #667085;

        font-size: 11px;
        font-weight: 800;
    }

    /* =========================================================
       LAYOUT
       ========================================================= */

    .cart-layout {
        display: grid;

        grid-template-columns: minmax(0, 1.65fr) minmax(300px, .8fr);

        gap: 20px;

        align-items: start;
    }

    /* =========================================================
       CARD
       ========================================================= */

    .cart-card {
        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 17px;

        box-shadow: 0 4px 16px rgba(15,23,42,.05);

        overflow: hidden;
    }

    .cart-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 18px 20px;

        border-bottom: 1px solid #edf0f5;
    }

    .cart-card-header h2 {
        margin: 0;

        color: #172033;

        font-size: 15px;
        font-weight: 850;
    }

    /* =========================================================
       LIGNE PRODUIT
       ========================================================= */

    .cart-product {
        display: grid;

        grid-template-columns: 70px minmax(0, 1fr) auto;

        gap: 15px;

        align-items: center;

        padding: 20px;

        border-bottom: 1px solid #edf0f5;
    }

    .cart-product:last-child {
        border-bottom: none;
    }

    .cart-product-image {
        width: 70px;
        height: 70px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background:
            radial-gradient(
                circle at top right,
                #eaf2ff,
                transparent 50%
            ),
            #f7f9fc;

        color: #2563eb;

        font-size: 26px;
    }

    .cart-product-info {
        min-width: 0;
    }

    .cart-product-reference {
        color: #929bad;

        font-size: 9px;
        font-weight: 750;

        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .cart-product-name {
        margin: 5px 0 5px;

        color: #172033;

        font-size: 14px;
        font-weight: 850;
    }

    .cart-product-category {
        color: #8a94a6;

        font-size: 10px;
    }

    .cart-product-price {
        margin-top: 7px;

        color: #4c586d;

        font-size: 11px;
    }

    /* =========================================================
       QUANTITE
       ========================================================= */

    .cart-product-controls {
        display: flex;
        align-items: center;

        gap: 12px;
    }

    .quantity-control {
        display: flex;
        align-items: center;

        border: 1px solid #dfe4ec;
        border-radius: 9px;

        overflow: hidden;
    }

    .quantity-control form {
        margin: 0;
    }

    .quantity-btn {
        width: 33px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 0;

        background: #f8fafc;

        color: #4c586d;

        font-size: 15px;
        font-weight: 850;

        cursor: pointer;

        transition: .2s ease;
    }

    .quantity-btn:hover {
        background: #eef3fb;
        color: #2563eb;
    }

    .quantity-value {
        min-width: 37px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-left: 1px solid #dfe4ec;
        border-right: 1px solid #dfe4ec;

        color: #172033;

        font-size: 11px;
        font-weight: 850;
    }

    /* =========================================================
       SOUS TOTAL
       ========================================================= */

    .cart-subtotal {
        min-width: 115px;

        text-align: right;
    }

    .cart-subtotal-value {
        color: #172033;

        font-size: 14px;
        font-weight: 900;
    }

    .cart-remove-form {
        margin-top: 7px;
    }

    .cart-remove-btn {
        padding: 0;

        border: 0;

        background: transparent;

        color: #a0a8b6;

        font-size: 10px;
        font-weight: 700;

        cursor: pointer;
    }

    .cart-remove-btn:hover {
        color: #dc2626;
    }

    /* =========================================================
       STOCK INFO
       ========================================================= */

    .cart-stock {
        display: inline-flex;

        align-items: center;
        gap: 5px;

        margin-top: 7px;

        color: #7f899c;

        font-size: 9px;
    }

    /* =========================================================
       BOTTOM ACTIONS
       ========================================================= */

    .cart-actions {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 17px 20px;

        background: #fafbfd;

        border-top: 1px solid #edf0f5;
    }

    .continue-shopping {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        color: #2563eb;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;
    }

    .continue-shopping:hover {
        color: #1d4ed8;
    }

    .clear-cart-btn {
        display: inline-flex;

        align-items: center;
        gap: 6px;

        padding: 9px 11px;

        border: 1px solid #e8d1d1;
        border-radius: 9px;

        background: #fff8f8;

        color: #b91c1c;

        font-size: 10px;
        font-weight: 800;

        cursor: pointer;
    }

    .clear-cart-btn:hover {
        background: #fef2f2;
    }

    /* =========================================================
       RESUME COMMANDE
       ========================================================= */

    .summary-card {
        position: sticky;
        top: 90px;
    }

    .summary-body {
        padding: 20px;
    }

    .summary-line {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 15px;

        margin-bottom: 13px;
    }

    .summary-line span:first-child {
        color: #798397;

        font-size: 11px;
    }

    .summary-line span:last-child {
        color: #344054;

        font-size: 11px;
        font-weight: 750;
    }

    .summary-divider {
        height: 1px;

        margin: 16px 0;

        background: #edf0f5;
    }

    .summary-total {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 15px;
    }

    .summary-total-label {
        color: #344054;

        font-size: 12px;
        font-weight: 800;
    }

    .summary-total-value {
        color: #172033;

        font-size: 21px;
        font-weight: 900;
    }

    .order-button {
        width: 100%;

        min-height: 46px;

        margin-top: 19px;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        border: 0;
        border-radius: 10px;

        background: #172033;
        color: white;

        font-size: 11px;
        font-weight: 850;

        cursor: pointer;

        transition: .2s ease;
    }

    .order-button:hover {
        background: #263653;

        transform: translateY(-1px);
    }

    .summary-note {
        display: flex;

        gap: 7px;

        margin-top: 13px;

        color: #8b95a7;

        font-size: 9px;
        line-height: 1.55;
    }

    .summary-note i {
        color: #2563eb;
    }

    /* =========================================================
       EMPTY PANIER
       ========================================================= */

    .empty-cart {
        padding: 65px 25px;

        text-align: center;
    }

    .empty-cart-icon {
        width: 75px;
        height: 75px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 15px;

        border-radius: 22px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 31px;
    }

    .empty-cart h2 {
        margin: 0;

        color: #172033;

        font-size: 18px;
        font-weight: 850;
    }

    .empty-cart p {
        max-width: 450px;

        margin: 7px auto 0;

        color: #8791a3;

        font-size: 11px;
        line-height: 1.6;
    }

    .empty-cart a {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        margin-top: 18px;

        padding: 10px 14px;

        border-radius: 9px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 800;
    }

    /* =========================================================
       SECURITE / INFORMATION
       ========================================================= */

    .cart-information {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 13px;

        margin-top: 18px;
    }

    .information-box {
        display: flex;

        align-items: center;

        gap: 10px;

        padding: 13px;

        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 12px;
    }

    .information-icon {
        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 14px;
    }

    .information-box strong {
        display: block;

        color: #344054;

        font-size: 10px;
        font-weight: 800;
    }

    .information-box span {
        display: block;

        margin-top: 2px;

        color: #9199a8;

        font-size: 8px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1050px) {

        .cart-layout {
            grid-template-columns: 1fr;
        }

        .summary-card {
            position: static;
        }

    }

    @media (max-width: 750px) {

        .cart-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .cart-product {
            grid-template-columns: 58px minmax(0, 1fr);
        }

        .cart-product-image {
            width: 58px;
            height: 58px;
        }

        .cart-product-controls {
            grid-column: 1 / -1;

            justify-content: space-between;
        }

        .cart-subtotal {
            min-width: 0;

            text-align: right;
        }

        .cart-information {
            grid-template-columns: 1fr;
        }

    }

    @media (max-width: 500px) {

        .cart-product {
            padding: 15px;
        }

        .cart-actions {
            align-items: flex-start;

            flex-direction: column;
        }

        .continue-shopping,
        .clear-cart-btn {
            width: 100%;

            justify-content: center;
        }

    }

</style>


<div class="client-cart-page">

    {# =========================================================
       HEADER
       ========================================================= #}

    <div class="cart-page-header">

        <div>

            <small>
                Espace client
            </small>

            <h1>
                Mon panier
            </h1>

            <p>
                Vérifiez vos produits avant de passer votre commande.
            </p>

        </div>


        <div class="cart-item-count">

            <i class="bi bi-cart3 me-1"></i>

            {{ items|length }}
            produit(s)

        </div>

    </div>


    {% if items is not empty %}

        {# =====================================================
           PANIER + RESUME
           ===================================================== #}

        <div class="cart-layout">


            {# =================================================
               LISTE DES PRODUITS
               ================================================= #}

            <div>

                <div class="cart-card">

                    <div class="cart-card-header">

                        <h2>
                            Articles sélectionnés
                        </h2>

                        <span
                            style="
                                color:#8a94a6;
                                font-size:10px;
                            "
                        >
                            {{ items|length }} ligne(s)
                        </span>

                    </div>


                    {% for item in items %}

                        {% set produit = item.produit %}
                        {% set quantite = item.quantite %}
                        {% set sousTotal = item.sous_total %}


                        <div class="cart-product">

                            {# IMAGE / VISUEL #}

                            <div class="cart-product-image">
                                <i class="bi bi-box-seam"></i>
                            </div>


                            {# INFORMATIONS PRODUIT #}

                            <div class="cart-product-info">

                                <div class="cart-product-reference">

                                    Réf.
                                    {{ produit.reference }}

                                </div>


                                <div class="cart-product-name">

                                    {{ produit.nom }}

                                </div>


                                <div class="cart-product-category">

                                    {% if produit.categorie %}

                                        <i class="bi bi-tag me-1"></i>

                                        {{ produit.categorie.nom }}

                                    {% else %}

                                        Produit

                                    {% endif %}

                                </div>


                                <div class="cart-product-price">

                                    {{ produit.prixVente|number_format(0, ',', ' ') }}
                                    Ar
                                    / {{ produit.unite }}

                                </div>


                                <div class="cart-stock">

                                    {% if produit.quantiteStock > 0 %}

                                        <i class="bi bi-check-circle"></i>

                                        {{ produit.quantiteStock }}
                                        disponible(s)

                                    {% else %}

                                        <i class="bi bi-x-circle"></i>

                                        Rupture de stock

                                    {% endif %}

                                </div>

                            </div>


                            {# CONTROLES + SOUS TOTAL #}

                            <div class="cart-product-controls">


                                {# QUANTITE #}

                                <div class="quantity-control">

                                    {# DIMINUER #}

                                    <form
                                        method="post"
                                        action="{{ path('app_client_cart_decrease', {
                                            id: produit.id
                                        }) }}"
                                    >

                                        <button
                                            type="submit"
                                            class="quantity-btn"
                                            title="Diminuer"
                                        >
                                            −
                                        </button>

                                    </form>


                                    <div class="quantity-value">

                                        {{ quantite }}

                                    </div>


                                    {# AUGMENTER #}

                                    <form
                                        method="post"
                                        action="{{ path('app_client_cart_increase', {
                                            id: produit.id
                                        }) }}"
                                    >

                                        <button
                                            type="submit"
                                            class="quantity-btn"
                                            title="Augmenter"
                                        >
                                            +
                                        </button>

                                    </form>

                                </div>


                                {# SOUS TOTAL #}

                                <div class="cart-subtotal">

                                    <div class="cart-subtotal-value">

                                        {{ sousTotal|number_format(0, ',', ' ') }}
                                        Ar

                                    </div>


                                    {# SUPPRIMER #}

                                    <form
                                        method="post"
                                        action="{{ path('app_client_cart_remove', {
                                            id: produit.id
                                        }) }}"
                                        class="cart-remove-form"
                                    >

                                        <button
                                            type="submit"
                                            class="cart-remove-btn"
                                        >

                                            <i class="bi bi-trash me-1"></i>

                                            Supprimer

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    {% endfor %}


                    {# ACTIONS PANIER #}

                    <div class="cart-actions">

                        <a
                            href="{{ path('app_client_produit_index') }}"
                            class="continue-shopping"
                        >

                            <i class="bi bi-arrow-left"></i>

                            Continuer mes achats

                        </a>


                        <form
                            method="post"
                            action="{{ path('app_client_cart_clear') }}"
                            onsubmit="
                                return confirm(
                                    'Voulez-vous vraiment vider votre panier ?'
                                );
                            "
                        >

                            <button
                                type="submit"
                                class="clear-cart-btn"
                            >

                                <i class="bi bi-trash3"></i>

                                Vider le panier

                            </button>

                        </form>

                    </div>

                </div>


                {# INFORMATIONS #}

                <div class="cart-information">

                    <div class="information-box">

                        <div class="information-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <strong>
                                Panier sécurisé
                            </strong>

                            <span>
                                Vos données sont protégées.
                            </span>

                        </div>

                    </div>


                    <div class="information-box">

                        <div class="information-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div>

                            <strong>
                                Stock contrôlé
                            </strong>

                            <span>
                                Disponibilité vérifiée côté serveur.
                            </span>

                        </div>

                    </div>


                    <div class="information-box">

                        <div class="information-icon">
                            <i class="bi bi-check2-circle"></i>
                        </div>

                        <div>

                            <strong>
                                Total vérifié
                            </strong>

                            <span>
                                Le total final est recalculé par le serveur.
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            {# =================================================
               RESUME
               ================================================= #}

            <div class="summary-card">

                <div class="cart-card">

                    <div class="cart-card-header">

                        <h2>
                            Résumé de la commande
                        </h2>

                        <i class="bi bi-receipt"></i>

                    </div>


                    <div class="summary-body">

                        <div class="summary-line">

                            <span>
                                Nombre d'articles
                            </span>

                            <span>
                                {{ items|reduce((total, item) => total + item.quantite, 0) }}
                            </span>

                        </div>


                        <div class="summary-line">

                            <span>
                                Produits
                            </span>

                            <span>
                                {{ items|length }}
                            </span>

                        </div>


                        <div class="summary-line">

                            <span>
                                Sous-total
                            </span>

                            <span>
                                {{ total|number_format(0, ',', ' ') }} Ar
                            </span>

                        </div>


                        <div class="summary-line">

                            <span>
                                Livraison
                            </span>

                            <span>
                                À définir
                            </span>

                        </div>


                        <div class="summary-divider"></div>


                        <div class="summary-total">

                            <div class="summary-total-label">
                                Total
                            </div>

                            <div class="summary-total-value">
                                {{ total|number_format(0, ',', ' ') }} Ar
                            </div>

                        </div>


                        {# PASSER LA COMMANDE #}

                        <form
                            method="post"
                            action="{{ path('app_client_commande_create') }}"
                        >

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('passer_commande') }}"
                            >

                            <button
                                type="submit"
                                class="order-button"
                            >

                                <i class="bi bi-check2-circle"></i>

                                Passer la commande

                            </button>

                        </form>


                        <div class="summary-note">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                Avant la validation, le système vérifiera
                                à nouveau la disponibilité des produits
                                et recalculera le montant côté serveur.
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


    {% else %}

        {# =====================================================
           PANIER VIDE
           ===================================================== #}

        <div class="cart-card">

            <div class="empty-cart">

                <div class="empty-cart-icon">

                    <i class="bi bi-cart-x"></i>

                </div>


                <h2>
                    Votre panier est vide
                </h2>


                <p>
                    Vous n'avez encore ajouté aucun produit.
                    Découvrez notre catalogue et ajoutez les articles
                    qui vous intéressent à votre panier.
                </p>


                <a
                    href="{{ path('app_client_produit_index') }}"
                >

                    <i class="bi bi-shop"></i>

                    Découvrir les produits

                </a>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}

