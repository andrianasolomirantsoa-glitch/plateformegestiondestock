{% extends 'base.html.twig' %}

{% block title %}Mon profil | Gestion de Stock{% endblock %}

{% block header_title %}
    <div class="profile-page-heading">
        <div>
            <div class="profile-eyebrow">
                <i class="bi bi-person-badge"></i>
                ESPACE PERSONNEL
            </div>
            <h1 class="page-title">Mon profil</h1>
            <p class="dashboard-subtitle">
                Gérez vos informations personnelles et la sécurité de votre compte.
            </p>
        </div>

        <div class="profile-current-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>
    </div>
{% endblock %}

{% block body %}

<style>
    .profile-page {
        --profile-primary: #4f46e5;
        --profile-primary-dark: #3730a3;
        --profile-ink: #172033;
        --profile-muted: #64748b;
        --profile-border: #e8edf5;
        --profile-surface: #f8fafc;
        padding-bottom: 40px;
        color: var(--profile-ink);
    }

    .profile-page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        width: 100%;
    }

    .profile-eyebrow {
        color: var(--profile-primary);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.6px;
        margin-bottom: 7px;
    }

    .profile-current-date {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 15px;
        border: 1px solid var(--profile-border);
        background: #fff;
        border-radius: 12px;
        color: var(--profile-muted);
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
    }

    .profile-back {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #fff;
        color: #475569;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: all .2s ease;
    }

    .profile-back:hover {
        color: var(--profile-primary);
        border-color: #c7d2fe;
        background: #f8faff;
        transform: translateX(-2px);
    }

    .profile-layout {
        display: grid;
        grid-template-columns: minmax(250px, .78fr) minmax(0, 1.7fr);
        gap: 24px;
        align-items: start;
    }

    .profile-card {
        min-width: 0;
        background: #fff;
        border: 1px solid var(--profile-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 24px rgba(15, 23, 42, .035);
    }

    .profile-cover {
        position: relative;
        height: 120px;
        overflow: hidden;
        background:
            radial-gradient(circle at 85% 15%, rgba(255,255,255,.20) 0 45px, transparent 46px),
            radial-gradient(circle at 72% 110%, rgba(255,255,255,.10) 0 85px, transparent 86px),
            linear-gradient(130deg, #3730a3, #4f46e5 60%, #818cf8);
    }

    .profile-cover::after {
        content: "";
        position: absolute;
        width: 130px;
        height: 130px;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 50%;
        right: -25px;
        top: 32px;
    }

    .profile-summary {
        padding: 0 24px 25px;
    }

    .profile-avatar {
        width: 88px;
        height: 88px;
        margin-top: -44px;
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid #fff;
        border-radius: 50%;
        background: #eef2ff;
        color: var(--profile-primary);
        font-size: 37px;
        box-shadow: 0 4px 14px rgba(15,23,42,.10);
    }

    .profile-client-name {
        margin: 17px 0 5px;
        font-size: 22px;
        line-height: 1.3;
        font-weight: 800;
        letter-spacing: -.5px;
        overflow-wrap: anywhere;
    }

    .profile-client-email {
        color: var(--profile-muted);
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 17px;
        padding: 7px 11px;
        border-radius: 30px;
        background: #ecfdf5;
        color: #047857;
        font-size: 11px;
        font-weight: 750;
    }

    .profile-status.inactive {
        background: #fef2f2;
        color: #b91c1c;
    }

    .profile-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .profile-side-divider {
        height: 1px;
        margin: 22px 0;
        background: var(--profile-border);
    }

    .profile-side-title {
        margin-bottom: 14px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .profile-side-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        margin: 5px -12px;
        border-radius: 12px;
        color: #475569;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        transition: background .2s, color .2s;
    }

    .profile-side-link:hover {
        background: #f1f5f9;
        color: var(--profile-primary);
    }

    .profile-side-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef2ff;
        color: var(--profile-primary);
        font-size: 17px;
    }

    .profile-main-card {
        padding: 27px;
    }

    .profile-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 24px;
    }

    .profile-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        border-radius: 13px;
        background: #eef2ff;
        color: var(--profile-primary);
        font-size: 19px;
    }

    .profile-section-heading h2 {
        margin: 0 0 5px;
        font-size: 17px;
        font-weight: 800;
        color: var(--profile-ink);
    }

    .profile-section-heading p {
        margin: 0;
        color: var(--profile-muted);
        font-size: 12px;
        line-height: 1.6;
    }

    .profile-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .profile-info-item {
        min-width: 0;
        padding: 16px;
        border: 1px solid var(--profile-border);
        border-radius: 13px;
        background: var(--profile-surface);
    }

    .profile-info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 9px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .profile-info-label i {
        font-size: 14px;
    }

    .profile-info-value {
        color: var(--profile-ink);
        font-size: 14px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .profile-divider {
        height: 1px;
        margin: 28px 0;
        background: var(--profile-border);
    }

    .profile-form {
        padding: 21px;
        border: 1px solid var(--profile-border);
        border-radius: 15px;
        background: #fff;
    }

    .profile-form .form-label {
        display: block;
        margin-bottom: 8px;
        color: #475569;
        font-size: 12px;
        font-weight: 750;
    }

    .profile-form .form-control {
        min-height: 47px;
        padding: 11px 13px;
        border: 1px solid #dfe5ef;
        border-radius: 11px;
        background: #fff;
        color: var(--profile-ink);
        font-size: 13px;
        transition: border-color .2s, box-shadow .2s;
    }

    .profile-form .form-control:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 4px rgba(79,70,229,.09);
    }

    .profile-form .form-control::placeholder {
        color: #a0aabb;
    }

    .profile-form-hint {
        margin-top: 7px;
        color: #94a3b8;
        font-size: 11px;
    }

    .profile-save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 20px;
        border: 0;
        border-radius: 11px;
        background: var(--profile-primary);
        color: #fff;
        font-size: 13px;
        font-weight: 750;
        box-shadow: 0 4px 10px rgba(79,70,229,.17);
        transition: background .2s, transform .2s;
    }

    .profile-save-btn:hover {
        background: var(--profile-primary-dark);
        color: #fff;
        transform: translateY(-1px);
    }

    .profile-security-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 17px;
        border: 1px solid var(--profile-border);
        border-radius: 14px;
        background: var(--profile-surface);
    }

    .profile-security-description {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .profile-security-description h3 {
        margin: 0 0 5px;
        font-size: 13px;
        font-weight: 800;
    }

    .profile-security-description p {
        margin: 0;
        color: var(--profile-muted);
        font-size: 11px;
        line-height: 1.6;
    }

    .profile-outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 10px 13px;
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        background: #fff;
        color: var(--profile-primary);
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: all .2s;
    }

    .profile-outline-btn:hover {
        border-color: var(--profile-primary);
        background: #eef2ff;
        color: var(--profile-primary-dark);
    }

    .profile-account-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .profile-account-item {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        min-width: 0;
    }

    .profile-account-item > i {
        margin-top: 2px;
        color: #818cf8;
        font-size: 17px;
    }

    .profile-account-item small {
        display: block;
        margin-bottom: 6px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .profile-account-item strong {
        display: block;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .profile-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 22px;
        padding: 14px;
        border-radius: 12px;
        background: #f5f7ff;
        color: #6366a7;
        font-size: 11px;
        line-height: 1.7;
    }

    .profile-note i {
        margin-top: 1px;
        font-size: 16px;
    }

    @media (max-width: 991.98px) {
        .profile-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .profile-summary {
            padding-bottom: 22px;
        }

        .profile-side-divider {
            margin: 17px 0;
        }

        .profile-side-link {
            display: inline-flex;
            margin: 3px 4px 3px -5px;
        }
    }

    @media (max-width: 575.98px) {
        .profile-page-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-current-date {
            padding: 9px 12px;
        }

        .profile-main-card {
            padding: 19px 15px;
        }

        .profile-info-grid,
        .profile-account-details {
            grid-template-columns: minmax(0, 1fr);
        }

        .profile-form {
            padding: 16px;
        }

        .profile-security-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-outline-btn {
            width: 100%;
        }

        .profile-client-name {
            font-size: 20px;
        }
    }
</style>

<div class="container-fluid px-0 profile-page">

    <div class="mb-4">
        <a href="{{ path('app_client_home') }}" class="profile-back">
            <i class="bi bi-arrow-left"></i>
            Retour à l'espace client
        </a>
    </div>

    {# Notifications #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    <div class="profile-layout">

        {# COLONNE GAUCHE : IDENTITÉ CLIENT #}
        <aside class="profile-card">

            <div class="profile-cover"></div>

            <div class="profile-summary">

                <div class="profile-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h2 class="profile-client-name">
                    {{ user.prenom }} {{ user.nom }}
                </h2>

                <div class="profile-client-email">
                    <i class="bi bi-envelope me-1"></i>
                    {{ user.email }}
                </div>

                {% if user.actif %}
                    <div class="profile-status">
                        <span class="profile-status-dot"></span>
                        Compte actif
                    </div>
                {% else %}
                    <div class="profile-status inactive">
                        <span class="profile-status-dot"></span>
                        Compte inactif
                    </div>
                {% endif %}

                <div class="profile-side-divider"></div>

                <div class="profile-side-title">Mon espace</div>

                <a href="{{ path('app_client_profile') }}"
                   class="profile-side-link">
                    <span class="profile-side-icon">
                        <i class="bi bi-person-vcard"></i>
                    </span>
                    <span>Mon profil</span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>

                <a href="{{ path('app_client_password') }}"
                   class="profile-side-link">
                    <span class="profile-side-icon">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <span>Sécurité du compte</span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>

                <div class="profile-note">
                    <i class="bi bi-info-circle"></i>
                    <span>
                        Gardez vos informations personnelles à jour pour
                        faciliter la gestion de votre compte.
                    </span>
                </div>

            </div>
        </aside>

        {# COLONNE DROITE : INFORMATIONS ET PARAMÈTRES #}
        <main class="profile-card profile-main-card">

            {# INFORMATIONS PERSONNELLES #}
            <section>
                <div class="profile-section-heading">
                    <div class="profile-section-icon">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <div>
                        <h2>Informations personnelles</h2>
                        <p>Les informations associées à votre compte client.</p>
                    </div>
                </div>

                <div class="profile-info-grid">

                    <div class="profile-info-item">
                        <div class="profile-info-label">
                            <i class="bi bi-person"></i>
                            Nom
                        </div>
                        <div class="profile-info-value">
                            {{ user.nom }}
                        </div>
                    </div>

                    <div class="profile-info-item">
                        <div class="profile-info-label">
                            <i class="bi bi-person-check"></i>
                            Prénom
                        </div>
                        <div class="profile-info-value">
                            {{ user.prenom }}
                        </div>
                    </div>

                    <div class="profile-info-item">
                        <div class="profile-info-label">
                            <i class="bi bi-envelope"></i>
                            Adresse e-mail
                        </div>
                        <div class="profile-info-value">
                            {{ user.email }}
                        </div>
                    </div>

                    <div class="profile-info-item">
                        <div class="profile-info-label">
                            <i class="bi bi-patch-check"></i>
                            Statut du compte
                        </div>
                        <div class="profile-info-value">
                            {% if user.actif %}
                                <span class="text-success">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Actif
                                </span>
                            {% else %}
                                <span class="text-danger">
                                    <i class="bi bi-x-circle-fill me-1"></i>
                                    Inactif
                                </span>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </section>

            <div class="profile-divider"></div>

            {# FORMULAIRE DE MODIFICATION #}
            <section>
                <div class="profile-section-heading">
                    <div class="profile-section-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h2>Modifier mon profil</h2>
                        <p>Mettez à jour votre nom et votre prénom.</p>
                    </div>
                </div>

                <div class="profile-form">
                    <form method="post" action="{{ path('app_client_profile') }}">

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('modifier_profil') }}"
                        >

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label for="nom" class="form-label">
                                    Nom <span class="text-danger">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="nom"
                                    name="nom"
                                    class="form-control"
                                    value="{{ formData.nom|default(user.nom) }}"
                                    placeholder="Votre nom"
                                    maxlength="100"
                                    autocomplete="family-name"
                                    required
                                >
                            </div>

                            <div class="col-md-6">
                                <label for="prenom" class="form-label">
                                    Prénom <span class="text-danger">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="prenom"
                                    name="prenom"
                                    class="form-control"
                                    value="{{ formData.prenom|default(user.prenom) }}"
                                    placeholder="Votre prénom"
                                    maxlength="100"
                                    autocomplete="given-name"
                                    required
                                >
                            </div>

                        </div>

                        <div class="profile-form-hint">
                            <i class="bi bi-info-circle me-1"></i>
                            Les champs marqués d'un astérisque sont obligatoires.
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="profile-save-btn">
                                <i class="bi bi-check2-circle"></i>
                                Enregistrer les modifications
                            </button>
                        </div>

                    </form>
                </div>
            </section>

            <div class="profile-divider"></div>

            {# SÉCURITÉ #}
            <section>
                <div class="profile-section-heading">
                    <div class="profile-section-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h2>Sécurité du compte</h2>
                        <p>Protégez votre accès à l'application.</p>
                    </div>
                </div>

                <div class="profile-security-card">

                    <div class="profile-security-description">
                        <div class="profile-section-icon">
                            <i class="bi bi-key"></i>
                        </div>
                        <div>
                            <h3>Mot de passe</h3>
                            <p>
                                Modifiez votre mot de passe pour sécuriser votre compte.
                            </p>
                        </div>
                    </div>

                    <a href="{{ path('app_client_password') }}"
                       class="profile-outline-btn">
                        <i class="bi bi-shield-lock"></i>
                        Modifier le mot de passe
                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                </div>
            </section>

            <div class="profile-divider"></div>

            {# DATES DU COMPTE #}
            <section>
                <div class="profile-section-heading">
                    <div class="profile-section-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h2>Informations du compte</h2>
                        <p>Quelques détails concernant votre compte.</p>
                    </div>
                </div>

                <div class="profile-account-details">

                    <div class="profile-account-item">
                        <i class="bi bi-calendar-plus"></i>
                        <div>
                            <small>Compte créé le</small>
                            <strong>
                                {% if user.createdAt %}
                                    {{ user.createdAt|date('d/m/Y à H:i') }}
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </strong>
                        </div>
                    </div>

                    <div class="profile-account-item">
                        <i class="bi bi-arrow-repeat"></i>
                        <div>
                            <small>Dernière modification</small>
                            <strong>
                                {% if user.updatedAt %}
                                    {{ user.updatedAt|date('d/m/Y à H:i') }}
                                {% else %}
                                    Aucune modification
                                {% endif %}
                            </strong>
                        </div>
                    </div>

                </div>
            </section>

        </main>
    </div>
</div>

{% endblock %}
