{% extends 'base.html.twig' %}

{% block title %}
    Modifier le mot de passe - Gestion de Stock
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>
            <h1 class="page-title">
                Modifier mon mot de passe
            </h1>

            <p class="dashboard-subtitle">
                Sécurisez votre compte en mettant à jour votre mot de passe.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<style>
    .password-page {
        padding-bottom: 40px;
    }

    .password-card {
        max-width: 700px;
        margin: 0 auto;
        border: 0;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
    }

    .password-header {
        padding: 35px 30px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #ffffff;
    }

    .password-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 30px;
    }

    .password-body {
        padding: 30px;
        background: #ffffff;
    }

    .password-body .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #334155;
    }

    .password-body .form-control {
        min-height: 48px;
        border-radius: 12px;
    }

    .password-body .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.12);
    }

    .security-info {
        padding: 15px 16px;
        border-radius: 13px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
    }

    @media (max-width: 767.98px) {
        .password-header,
        .password-body {
            padding: 25px 20px;
        }
    }
</style>

<div class="container py-4 password-page">

    <div class="mb-4">

        <a
            href="{{ path('app_client_profile') }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Retour au profil
        </a>

    </div>

    <div class="password-card">

        <div class="password-header text-center">

            <div class="password-icon">

                <i class="bi bi-shield-lock"></i>

            </div>

            <h2 class="mt-3 mb-2">
                Modifier votre mot de passe
            </h2>

            <p class="mb-0 text-white-50">
                Gardez votre compte sécurisé avec un mot de passe personnel.
            </p>

        </div>

        <div class="password-body">

            <div class="security-info mb-4">

                <i class="bi bi-info-circle me-1"></i>

                Le nouveau mot de passe doit contenir au minimum
                <strong>8 caractères</strong> et être différent de votre ancien
                mot de passe.

            </div>

            <form method="post">

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('modifier_mot_de_passe') }}"
                >

                <div class="mb-4">

                    <label
                        for="ancien_mot_de_passe"
                        class="form-label"
                    >
                        Ancien mot de passe
                    </label>

                    <input
                        type="password"
                        id="ancien_mot_de_passe"
                        name="ancien_mot_de_passe"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >

                </div>

                <div class="mb-4">

                    <label
                        for="nouveau_mot_de_passe"
                        class="form-label"
                    >
                        Nouveau mot de passe
                    </label>

                    <input
                        type="password"
                        id="nouveau_mot_de_passe"
                        name="nouveau_mot_de_passe"
                        class="form-control"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >

                </div>

                <div class="mb-4">

                    <label
                        for="confirmation_mot_de_passe"
                        class="form-label"
                    >
                        Confirmer le nouveau mot de passe
                    </label>

                    <input
                        type="password"
                        id="confirmation_mot_de_passe"
                        name="confirmation_mot_de_passe"
                        class="form-control"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >

                </div>

                <div class="d-flex justify-content-end">

                    <button
                        type="submit"
                        class="btn btn-primary px-4"
                    >
                        <i class="bi bi-shield-check"></i>
                        Modifier le mot de passe
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

{% endblock %}

