{% extends 'base.html.twig' %}

{% block title %}Sécurité du compte | Gestion de Stock{% endblock %}

{% block header_title %}
    <div class="password-page-heading">
        <div>
            <div class="password-eyebrow">
                <i class="bi bi-shield-check"></i>
                ESPACE PERSONNEL
            </div>
            <h1 class="page-title">Sécurité du compte</h1>
            <p class="dashboard-subtitle">
                Gérez votre mot de passe et protégez votre accès à l'application.
            </p>
        </div>

        <div class="password-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>
    </div>
{% endblock %}

{% block body %}

<style>
    .password-page {
        --security-primary: #4f46e5;
        --security-primary-dark: #3730a3;
        --security-ink: #172033;
        --security-muted: #64748b;
        --security-border: #e8edf5;
        padding-bottom: 40px;
        color: var(--security-ink);
    }

    .password-page-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
    }

    .password-eyebrow {
        margin-bottom: 7px;
        color: var(--security-primary);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .password-date {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 15px;
        border: 1px solid var(--security-border);
        border-radius: 12px;
        background: #fff;
        color: var(--security-muted);
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
    }

    .password-back {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #fff;
        color: #475569;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: all .2s ease;
    }

    .password-back:hover {
        border-color: #c7d2fe;
        background: #f8faff;
        color: var(--security-primary);
        transform: translateX(-2px);
    }

    .password-layout {
        display: grid;
        grid-template-columns: minmax(220px, .75fr) minmax(0, 1.65fr);
        gap: 24px;
        align-items: start;
    }

    .password-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--security-border);
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 5px 24px rgba(15, 23, 42, .035);
    }

    .password-sidebar {
        padding: 25px;
    }

    .password-sidebar-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 145px;
        margin-bottom: 22px;
        overflow: hidden;
        border-radius: 16px;
        background:
            radial-gradient(circle at 85% 15%, rgba(255,255,255,.18) 0 45px, transparent 46px),
            linear-gradient(135deg, #3730a3, #4f46e5 65%, #818cf8);
    }

    .password-sidebar-visual::before,
    .password-sidebar-visual::after {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 50%;
    }

    .password-sidebar-visual::before {
        left: -50px;
        bottom: -65px;
    }

    .password-sidebar-visual::after {
        right: -35px;
        top: 75px;
    }

    .password-big-icon {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 76px;
        height: 76px;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 23px;
        background: rgba(255,255,255,.15);
        color: #fff;
        font-size: 34px;
        box-shadow: 0 10px 30px rgba(15,23,42,.12);
    }

    .password-sidebar h2 {
        margin: 0 0 9px;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .password-sidebar > p {
        margin-bottom: 22px;
        color: var(--security-muted);
        font-size: 12px;
        line-height: 1.8;
    }

    .password-benefit {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 17px;
    }

    .password-benefit-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 10px;
        background: #eef2ff;
        color: var(--security-primary);
        font-size: 16px;
    }

    .password-benefit strong {
        display: block;
        margin-bottom: 4px;
        font-size: 12px;
        font-weight: 750;
    }

    .password-benefit span {
        display: block;
        color: var(--security-muted);
        font-size: 11px;
        line-height: 1.6;
    }

    .password-main {
        padding: 29px;
    }

    .password-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 24px;
    }

    .password-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        border-radius: 13px;
        background: #eef2ff;
        color: var(--security-primary);
        font-size: 19px;
    }

    .password-section-heading h2 {
        margin: 0 0 5px;
        font-size: 17px;
        font-weight: 800;
    }

    .password-section-heading p {
        margin: 0;
        color: var(--security-muted);
        font-size: 12px;
        line-height: 1.7;
    }

    .password-notice {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 25px;
        padding: 15px;
        border: 1px solid #e0e7ff;
        border-radius: 13px;
        background: #f5f7ff;
        color: #525c94;
        font-size: 12px;
        line-height: 1.75;
    }

    .password-notice > i {
        margin-top: 1px;
        color: var(--security-primary);
        font-size: 17px;
    }

    .password-field {
        margin-bottom: 22px;
    }

    .password-field .form-label {
        display: block;
        margin-bottom: 8px;
        color: #475569;
        font-size: 12px;
        font-weight: 750;
    }

    .password-input-wrap {
        position: relative;
    }

    .password-input-wrap .form-control {
        min-height: 48px;
        padding: 11px 48px 11px 14px;
        border: 1px solid #dfe5ef;
        border-radius: 11px;
        background: #fff;
        color: var(--security-ink);
        font-size: 13px;
        transition: border-color .2s, box-shadow .2s;
    }

    .password-input-wrap .form-control:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 4px rgba(79,70,229,.09);
    }

    .password-input-wrap .form-control::placeholder {
        color: #a0aabb;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        transform: translateY(-50%);
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
    }

    .password-toggle:hover {
        background: #eef2ff;
        color: var(--security-primary);
    }

    .password-field-hint {
        margin-top: 7px;
        color: #94a3b8;
        font-size: 11px;
    }

    .password-strength {
        display: none;
        margin-top: 12px;
    }

    .password-strength.visible {
        display: block;
    }

    .password-strength-track {
        height: 5px;
        overflow: hidden;
        border-radius: 10px;
        background: #e2e8f0;
    }

    .password-strength-fill {
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: #94a3b8;
        transition: width .2s ease, background .2s ease;
    }

    .password-strength-label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 7px;
        color: var(--security-muted);
        font-size: 10px;
    }

    .password-divider {
        height: 1px;
        margin: 27px 0;
        background: var(--security-border);
    }

    .password-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 46px;
        padding: 11px 19px;
        border: 0;
        border-radius: 11px;
        background: var(--security-primary);
        color: #fff;
        font-size: 13px;
        font-weight: 750;
        box-shadow: 0 4px 10px rgba(79,70,229,.17);
        transition: background .2s, transform .2s;
    }

    .password-submit:hover {
        background: var(--security-primary-dark);
        color: #fff;
        transform: translateY(-1px);
    }

    .password-footer-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 20px;
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.7;
    }

    .password-footer-note i {
        color: #818cf8;
        font-size: 15px;
    }

    @media (max-width: 991.98px) {
        .password-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .password-sidebar {
            padding: 22px;
        }

        .password-sidebar-visual {
            height: 115px;
        }

        .password-benefits {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }
    }

    @media (max-width: 575.98px) {
        .password-page-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .password-main {
            padding: 20px 16px;
        }

        .password-sidebar {
            padding: 18px;
        }

        .password-benefits {
            grid-template-columns: minmax(0, 1fr);
        }

        .password-submit {
            width: 100%;
        }
    }
</style>

<div class="container-fluid px-0 password-page">

    <div class="mb-4">
        <a href="{{ path('app_client_profile') }}" class="password-back">
            <i class="bi bi-arrow-left"></i>
            Retour au profil
        </a>
    </div>

    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    <div class="password-layout">

        {# PANNEAU DE PRÉSENTATION #}
        <aside class="password-card password-sidebar">

            <div class="password-sidebar-visual">
                <div class="password-big-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
            </div>

            <h2>Votre sécurité compte</h2>

            <p>
                Un mot de passe personnel et difficile à deviner aide
                à protéger votre compte et vos informations.
            </p>

            <div class="password-benefits">

                <div class="password-benefit">
                    <div class="password-benefit-icon">
                        <i class="bi bi-key"></i>
                    </div>
                    <div>
                        <strong>Mot de passe unique</strong>
                        <span>Évitez de réutiliser un mot de passe d'un autre site.</span>
                    </div>
                </div>

                <div class="password-benefit">
                    <div class="password-benefit-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <strong>Plus de protection</strong>
                        <span>Privilégiez une combinaison longue et difficile à deviner.</span>
                    </div>
                </div>

                <div class="password-benefit">
                    <div class="password-benefit-icon">
                        <i class="bi bi-eye-slash"></i>
                    </div>
                    <div>
                        <strong>Restez vigilant</strong>
                        <span>Ne communiquez jamais votre mot de passe.</span>
                    </div>
                </div>

            </div>
        </aside>

        {# FORMULAIRE DE SÉCURITÉ #}
        <main class="password-card password-main">

            <div class="password-section-heading">
                <div class="password-section-icon">
                    <i class="bi bi-lock"></i>
                </div>
                <div>
                    <h2>Modifier le mot de passe</h2>
                    <p>
                        Renseignez votre mot de passe actuel, puis choisissez-en un nouveau.
                    </p>
                </div>
            </div>

            <div class="password-notice">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    Votre nouveau mot de passe doit contenir au minimum
                    <strong>8 caractères</strong> et être différent de l'ancien.
                    Utilisez de préférence une phrase de passe longue et unique.
                </div>
            </div>

            <form method="post" action="{{ path('app_client_password') }}">

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('modifier_mot_de_passe') }}"
                >

                <div class="password-field">
                    <label for="ancien_mot_de_passe" class="form-label">
                        Ancien mot de passe <span class="text-danger">*</span>
                    </label>

                    <div class="password-input-wrap">
                        <input
                            type="password"
                            id="ancien_mot_de_passe"
                            name="ancien_mot_de_passe"
                            class="form-control"
                            placeholder="Saisissez votre mot de passe actuel"
                            autocomplete="current-password"
                            required
                        >
                        <button
                            type="button"
                            class="password-toggle"
                            data-password-target="ancien_mot_de_passe"
                            aria-label="Afficher le mot de passe actuel"
                            aria-pressed="false"
                        >
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="password-field">
                    <label for="nouveau_mot_de_passe" class="form-label">
                        Nouveau mot de passe <span class="text-danger">*</span>
                    </label>

                    <div class="password-input-wrap">
                        <input
                            type="password"
                            id="nouveau_mot_de_passe"
                            name="nouveau_mot_de_passe"
                            class="form-control"
                            placeholder="Créez un nouveau mot de passe"
                            minlength="8"
                            autocomplete="new-password"
                            aria-describedby="password-strength-label"
                            required
                        >
                        <button
                            type="button"
                            class="password-toggle"
                            data-password-target="nouveau_mot_de_passe"
                            aria-label="Afficher le nouveau mot de passe"
                            aria-pressed="false"
                        >
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <div class="password-strength" id="password-strength">
                        <div class="password-strength-track">
                            <div class="password-strength-fill" id="password-strength-fill"></div>
                        </div>
                        <div class="password-strength-label" id="password-strength-label">
                            <span id="password-strength-text">Entrez un mot de passe</span>
                            <span id="password-strength-length">0 caractère</span>
                        </div>
                    </div>

                    <div class="password-field-hint">
                        8 caractères minimum. Une longueur supérieure est recommandée.
                    </div>
                </div>

                <div class="password-field">
                    <label for="confirmation_mot_de_passe" class="form-label">
                        Confirmer le nouveau mot de passe <span class="text-danger">*</span>
                    </label>

                    <div class="password-input-wrap">
                        <input
                            type="password"
                            id="confirmation_mot_de_passe"
                            name="confirmation_mot_de_passe"
                            class="form-control"
                            placeholder="Saisissez à nouveau le nouveau mot de passe"
                            minlength="8"
                            autocomplete="new-password"
                            required
                        >
                        <button
                            type="button"
                            class="password-toggle"
                            data-password-target="confirmation_mot_de_passe"
                            aria-label="Afficher la confirmation du mot de passe"
                            aria-pressed="false"
                        >
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="password-divider"></div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="password-submit">
                        <i class="bi bi-shield-check"></i>
                        Enregistrer le nouveau mot de passe
                    </button>
                </div>

                <div class="password-footer-note">
                    <i class="bi bi-lock-fill"></i>
                    <span>
                        Votre mot de passe doit rester confidentiel.
                        La validation définitive est effectuée par le serveur.
                    </span>
                </div>

            </form>

        </main>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Afficher ou masquer chaque champ indépendamment.
        document.querySelectorAll('.password-toggle').forEach(function (button) {
            button.addEventListener('click', function () {
                const targetId = button.dataset.passwordTarget;
                const input = document.getElementById(targetId);

                if (!input) {
                    return;
                }

                const shouldShow = input.type === 'password';
                input.type = shouldShow ? 'text' : 'password';

                const icon = button.querySelector('i');

                if (icon) {
                    icon.classList.toggle('bi-eye', !shouldShow);
                    icon.classList.toggle('bi-eye-slash', shouldShow);
                }

                button.setAttribute('aria-pressed', String(shouldShow));
                button.setAttribute(
                    'aria-label',
                    shouldShow ? 'Masquer le mot de passe' : 'Afficher le mot de passe'
                );
            });
        });

        // Indicateur visuel uniquement : la validation réelle reste côté serveur.
        const passwordInput = document.getElementById('nouveau_mot_de_passe');
        const strength = document.getElementById('password-strength');
        const fill = document.getElementById('password-strength-fill');
        const strengthText = document.getElementById('password-strength-text');
        const lengthText = document.getElementById('password-strength-length');

        if (passwordInput && strength && fill && strengthText && lengthText) {
            passwordInput.addEventListener('input', function () {
                const value = passwordInput.value;
                const length = Array.from(value).length;

                strength.classList.toggle('visible', length > 0);
                lengthText.textContent = length + (length > 1 ? ' caractères' : ' caractère');

                if (length === 0) {
                    fill.style.width = '0';
                    strengthText.textContent = 'Entrez un mot de passe';
                    return;
                }

                let score = 0;

                if (length >= 8) score++;
                if (length >= 12) score++;
                if (/[a-z]/.test(value) && /[A-Z]/.test(value)) score++;
                if (/\d/.test(value)) score++;
                if (/[^a-zA-Z0-9]/.test(value)) score++;

                let label;
                let width;

                if (length < 8) {
                    label = 'Trop court';
                    width = '20%';
                } else if (score <= 2) {
                    label = 'À renforcer';
                    width = '40%';
                } else if (score <= 3) {
                    label = 'Correct';
                    width = '65%';
                } else if (score === 4) {
                    label = 'Bon';
                    width = '85%';
                } else {
                    label = 'Très bon';
                    width = '100%';
                }

                strengthText.textContent = label;
                fill.style.width = width;
            });
        }

        // Vérification de confirmation côté interface, sans remplacer le serveur.
        const confirmation = document.getElementById('confirmation_mot_de_passe');

        if (passwordInput && confirmation) {
            function checkConfirmation() {
                if (confirmation.value === '') {
                    confirmation.setCustomValidity('');
                    return;
                }

                confirmation.setCustomValidity(
                    confirmation.value === passwordInput.value
                        ? ''
                        : 'Les deux mots de passe ne correspondent pas.'
                );
            }

            passwordInput.addEventListener('input', checkConfirmation);
            confirmation.addEventListener('input', checkConfirmation);
        }
    });
</script>

{% endblock %}
