{% extends 'base.html.twig' %}

{% block title %}
    Livraison - {{ commande.numero }}
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>
            <h1 class="page-title">
                Livraison de la commande
            </h1>

            <p class="dashboard-subtitle">
                Renseignez les informations nécessaires à la livraison.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<div class="container py-4">

    <div class="mb-4">

        <a
            href="{{ path(
                'app_client_commande_confirmation',
                {'id': commande.id}
            ) }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Retour à la commande
        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <i
                            class="bi bi-truck text-primary"
                            style="font-size: 60px;"
                        ></i>

                        <h2 class="mt-3">
                            Informations de livraison
                        </h2>

                        <p class="text-muted">
                            Commande {{ commande.numero }}
                        </p>

                    </div>

                    <div class="alert alert-success">

                        <div class="d-flex align-items-center">

                            <i class="bi bi-check-circle fs-3 me-3"></i>

                            <div>
                                <strong>
                                    Paiement validé
                                </strong>

                                <div>
                                    Vous pouvez maintenant renseigner
                                    votre livraison.
                                </div>
                            </div>

                        </div>

                    </div>

                    <form method="post">

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('livraison_' ~ commande.id) }}"
                        >

                        <div class="mb-4">

                            <label
                                for="mode_livraison"
                                class="form-label"
                            >
                                Mode de livraison
                            </label>

                            <select
                                name="mode_livraison"
                                id="mode_livraison"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    -- Sélectionnez un mode --
                                </option>

                                <option value="DOMICILE">
                                    Livraison à domicile
                                </option>

                                <option value="POINT_RELAIS">
                                    Point relais
                                </option>

                                <option value="RETRAIT">
                                    Retrait sur place
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label
                                for="adresse_livraison"
                                class="form-label"
                            >
                                Adresse de livraison
                            </label>

                            <textarea
                                name="adresse_livraison"
                                id="adresse_livraison"
                                class="form-control"
                                rows="3"
                                maxlength="255"
                                placeholder="Exemple : Lot II A 25, quartier..."
                                required
                            ></textarea>

                        </div>

                        <div class="mb-4">

                            <label
                                for="ville"
                                class="form-label"
                            >
                                Ville
                            </label>

                            <input
                                type="text"
                                name="ville"
                                id="ville"
                                class="form-control"
                                maxlength="100"
                                placeholder="Exemple : Antananarivo"
                                required
                            >

                        </div>

                        <div class="mb-4">

                            <label
                                for="pays"
                                class="form-label"
                            >
                                Pays
                            </label>

                            <input
                                type="text"
                                name="pays"
                                id="pays"
                                class="form-control"
                                maxlength="100"
                                value="Madagascar"
                                required
                            >

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary btn-lg w-100"
                        >
                            <i class="bi bi-truck"></i>
                            Enregistrer la livraison
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
