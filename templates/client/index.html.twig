{% extends 'base.html.twig' %}

{% block title %}Tableau de bord client{% endblock %}

{% block body %}

<style>

    /* =========================================================
       DASHBOARD CLIENT
       ========================================================= */

    .client-dashboard {
        max-width: 1500px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .client-welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;

        padding: 30px;
        margin-bottom: 25px;

        border-radius: 18px;

        background: linear-gradient(
            135deg,
            #172033 0%,
            #263653 100%
        );

        color: white;

        box-shadow: 0 8px 25px rgba(23, 32, 51, .15);
    }

    .client-welcome-text {
        min-width: 0;
    }

    .welcome-small {
        display: block;
        margin-bottom: 7px;

        color: #aeb9cb;

        font-size: 11px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .client-welcome h1 {
        margin: 0;

        font-size: 29px;
        font-weight: 800;
    }

    .client-welcome p {
        margin: 9px 0 0;

        color: #c8d0dd;

        font-size: 13px;
        line-height: 1.6;
    }

    .welcome-action {
        flex-shrink: 0;
    }

    .welcome-action a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        padding: 12px 16px;

        border-radius: 10px;

        background: white;
        color: #172033;

        text-decoration: none;

        font-size: 12px;
        font-weight: 800;

        transition: .2s ease;
    }

    .welcome-action a:hover {
        transform: translateY(-2px);
        color: #172033;
    }


    /* =========================================================
       STATISTIQUES
       ========================================================= */

    .client-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 17px;

        margin-bottom: 25px;
    }

    .client-stat-card {
        padding: 20px;

        background: white;

        border-radius: 15px;

        border: 1px solid #edf0f5;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .stat-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .stat-card-title {
        color: #788397;

        font-size: 11px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .stat-card-icon {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 17px;
    }

    .stat-card-value {
        margin-top: 15px;

        color: #172033;

        font-size: 27px;
        font-weight: 800;
    }

    .stat-card-info {
        margin-top: 6px;

        color: #8892a4;

        font-size: 11px;
    }


    /* =========================================================
       GRILLE PRINCIPALE
       ========================================================= */

    .client-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, .8fr);

        gap: 20px;

        margin-bottom: 25px;
    }

    .client-card {
        overflow: hidden;

        background: white;

        border-radius: 16px;

        border: 1px solid #edf0f5;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .client-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 18px 20px;

        border-bottom: 1px solid #edf0f5;
    }

    .client-card-header h2 {
        margin: 0;

        color: #172033;

        font-size: 16px;
        font-weight: 800;
    }

    .client-card-header a {
        color: #2563eb;

        text-decoration: none;

        font-size: 11px;
        font-weight: 700;
    }

    .client-card-body {
        padding: 20px;
    }


    /* =========================================================
       COMMANDES
       ========================================================= */

    .order-item {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 16px 20px;

        border-bottom: 1px solid #f0f2f6;
    }

    .order-item:last-child {
        border-bottom: none;
    }

    .order-left {
        min-width: 0;
    }

    .order-number {
        display: block;

        color: #172033;

        font-size: 13px;
        font-weight: 800;
    }

    .order-date {
        display: block;

        margin-top: 4px;

        color: #8892a4;

        font-size: 10px;
    }

    .order-statuses {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;

        margin-top: 9px;
    }

    .client-badge {
        display: inline-flex;
        align-items: center;

        padding: 4px 8px;

        border-radius: 30px;

        font-size: 9px;
        font-weight: 800;
    }

    .client-badge-warning {
        background: #fff7ed;
        color: #c2410c;
    }

    .client-badge-success {
        background: #ecfdf3;
        color: #15803d;
    }

    .client-badge-danger {
        background: #fef2f2;
        color: #b91c1c;
    }

    .client-badge-info {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .order-right {
        flex-shrink: 0;

        text-align: right;
    }

    .order-total {
        margin-bottom: 7px;

        color: #172033;

        font-size: 14px;
        font-weight: 800;
    }

    .order-detail {
        color: #2563eb;

        text-decoration: none;

        font-size: 10px;
        font-weight: 700;
    }

    .order-detail:hover {
        text-decoration: underline;
    }


    /* =========================================================
       PANIER
       ========================================================= */

    .cart-summary {
        text-align: center;
    }

    .cart-icon {
        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 13px;

        border-radius: 15px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 25px;
    }

    .cart-summary h3 {
        margin: 0;

        font-size: 16px;
        font-weight: 800;
    }

    .cart-count {
        margin-top: 6px;

        color: #7d8799;

        font-size: 12px;
    }

    .cart-total-client {
        margin-top: 17px;

        color: #172033;

        font-size: 25px;
        font-weight: 900;
    }

    .cart-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 100%;

        margin-top: 18px;

        padding: 11px;

        border-radius: 10px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;
    }

    .cart-button:hover {
        background: #263653;
        color: white;
    }


    /* =========================================================
       PROFIL
       ========================================================= */

    .profile-box {
        display: flex;
        align-items: center;

        gap: 14px;
    }

    .profile-avatar-client {
        width: 54px;
        height: 54px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 50%;

        background: #eff4ff;
        color: #2563eb;

        font-size: 17px;
        font-weight: 900;
    }

    .profile-name {
        font-size: 14px;
        font-weight: 800;
    }

    .profile-email {
        margin-top: 4px;

        color: #8791a3;

        font-size: 11px;
    }

    .profile-button {
        display: inline-flex;

        margin-top: 16px;

        padding: 9px 12px;

        border-radius: 9px;

        background: #eff4ff;
        color: #2563eb;

        text-decoration: none;

        font-size: 10px;
        font-weight: 800;
    }

    .profile-button:hover {
        background: #e2ebff;
        color: #1d4ed8;
    }


    /* =========================================================
       ACTIVITE
       ========================================================= */

    .activity-row {
        margin-bottom: 17px;
    }

    .activity-row:last-child {
        margin-bottom: 0;
    }

    .activity-label {
        display: flex;
        justify-content: space-between;

        margin-bottom: 7px;

        font-size: 11px;
        font-weight: 700;
    }

    .activity-label span:last-child {
        color: #7d8799;
    }

    .activity-progress {
        width: 100%;
        height: 7px;

        border-radius: 20px;

        background: #edf0f5;

        overflow: hidden;
    }

    .activity-progress-bar {
        height: 100%;

        border-radius: inherit;

        background: #2563eb;
    }


    /* =========================================================
       MES LIVRAISONS
       ========================================================= */

    .client-deliveries-section {
        margin-bottom: 25px;
    }

    .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 18px;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;

        gap: 6px;

        margin-bottom: 5px;

        color: #2563eb;

        font-size: 11px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .section-heading h2 {
        margin: 0;

        color: #172033;

        font-size: 20px;
        font-weight: 800;
    }

    .section-heading p {
        margin: 5px 0 0;

        color: #7d8799;

        font-size: 11px;
    }

    .delivery-dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 17px;
    }

    .delivery-dashboard-card {
        overflow: hidden;

        background: white;

        border-radius: 15px;

        border: 1px solid #edf0f5;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .delivery-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 16px 18px;

        border-bottom: 1px solid #edf0f5;
    }

    .delivery-label {
        display: block;

        margin-bottom: 3px;

        color: #8993a5;

        font-size: 9px;

        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .delivery-card-top strong {
        color: #172033;

        font-size: 12px;
        font-weight: 800;
    }

    .delivery-status {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 9px;

        border-radius: 30px;

        font-size: 9px;
        font-weight: 800;

        white-space: nowrap;
    }

    .status-waiting {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-progress {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .status-delivered {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-cancelled {
        background: #fef2f2;
        color: #b91c1c;
    }

    .status-to-organize {
        background: #fefce8;
        color: #a16207;
    }

    .delivery-card-content {
        padding: 17px 18px;
    }

    .delivery-info-line {
        display: flex;
        align-items: center;

        gap: 11px;

        margin-bottom: 13px;
    }

    .delivery-info-line:last-child {
        margin-bottom: 0;
    }

    .delivery-info-icon {
        width: 35px;
        height: 35px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 15px;
    }

    .delivery-info-line span {
        display: block;

        margin-bottom: 2px;

        color: #8993a5;

        font-size: 9px;
    }

    .delivery-info-line strong {
        display: block;

        color: #172033;

        font-size: 11px;
    }

    .delivery-empty-content {
        display: flex;
        align-items: center;

        gap: 13px;

        min-height: 90px;
    }

    .delivery-empty-icon {
        width: 45px;
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 20px;
    }

    .delivery-empty-content h3 {
        margin: 0 0 4px;

        color: #172033;

        font-size: 13px;
        font-weight: 800;
    }

    .delivery-empty-content p {
        margin: 0;

        color: #7d8799;

        font-size: 10px;
        line-height: 1.5;
    }

    .delivery-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;

        padding: 13px 18px;

        background: #fafbfc;

        border-top: 1px solid #edf0f5;
    }

    .delivery-order-total span {
        display: block;

        margin-bottom: 2px;

        color: #8993a5;

        font-size: 9px;
    }

    .delivery-order-total strong {
        color: #172033;

        font-size: 13px;
        font-weight: 900;
    }

    .delivery-actions .btn {
        border-radius: 8px;

        font-size: 10px;
        font-weight: 800;
    }

    .delivery-dashboard-empty {
        grid-column: 1 / -1;

        padding: 35px 20px;

        text-align: center;

        background: white;

        border: 1px dashed #d8dfeb;
        border-radius: 15px;
    }

    .delivery-empty-big-icon {
        width: 55px;
        height: 55px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 12px;

        border-radius: 15px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 24px;
    }

    .delivery-dashboard-empty h3 {
        margin: 0 0 5px;

        color: #172033;

        font-size: 15px;
        font-weight: 800;
    }

    .delivery-dashboard-empty p {
        max-width: 500px;

        margin: 0 auto 15px;

        color: #7d8799;

        font-size: 10px;
        line-height: 1.5;
    }


    /* =========================================================
       ACTIONS RAPIDES
       ========================================================= */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 15px;
    }

    .quick-action {
        display: block;

        padding: 19px;

        background: white;

        border-radius: 15px;

        border: 1px solid #edf0f5;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);

        text-decoration: none;

        transition: .2s ease;
    }

    .quick-action:hover {
        transform: translateY(-3px);

        border-color: #dbe4ff;
    }

    .quick-action-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 13px;

        border-radius: 11px;

        background: #f4f6fa;
        color: #2563eb;

        font-size: 18px;
    }

    .quick-action h3 {
        margin: 0;

        color: #172033;

        font-size: 13px;
        font-weight: 800;
    }

    .quick-action p {
        margin: 6px 0 0;

        color: #8791a3;

        font-size: 10px;
        line-height: 1.5;
    }


    /* =========================================================
       EMPTY
       ========================================================= */

    .client-empty {
        padding: 35px 20px;

        text-align: center;

        color: #8993a5;
    }

    .client-empty i {
        display: block;

        margin-bottom: 9px;

        font-size: 30px;
    }

    .client-empty strong {
        display: block;

        color: #172033;

        font-size: 13px;
    }

    .client-empty span {
        display: block;

        margin-top: 5px;

        font-size: 10px;
    }

    .client-empty a {
        display: inline-flex;

        margin-top: 14px;

        padding: 9px 13px;

        border-radius: 9px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 800;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1200px) {

        .client-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .quick-actions {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @media (max-width: 900px) {

        .client-grid {
            grid-template-columns: 1fr;
        }

        .delivery-dashboard-grid {
            grid-template-columns: 1fr;
        }

        .client-welcome {
            align-items: flex-start;
            flex-direction: column;
        }

        .welcome-action {
            width: 100%;
        }

        .welcome-action a {
            width: 100%;
        }

    }


    @media (max-width: 600px) {

        .client-stats,
        .quick-actions {
            grid-template-columns: 1fr;
        }

        .client-welcome {
            padding: 22px;
        }

        .client-welcome h1 {
            font-size: 23px;
        }

        .order-item {
            align-items: flex-start;
            flex-direction: column;
        }

        .order-right {
            width: 100%;

            text-align: left;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .delivery-card-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .delivery-card-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .delivery-actions {
            width: 100%;
        }

        .delivery-actions .btn {
            width: 100%;
        }

    }

</style>

<div class="client-dashboard">


{# =========================================================
   BIENVENUE
   ========================================================= #}

<section class="client-welcome">

    <div class="client-welcome-text">

        <span class="welcome-small">
            Espace client
        </span>

        <h1>
            Bonjour {{ user.prenom }} {{ user.nom }}
        </h1>

        <p>
            Bienvenue dans votre espace personnel.
            Consultez vos commandes, votre panier et votre activité.
        </p>

    </div>


    <div class="welcome-action">

        <a href="{{ path('app_client_produit_index') }}">
            <i class="bi bi-bag"></i>
            Voir les produits
        </a>

    </div>

</section>


{# =========================================================
   STATISTIQUES
   ========================================================= #}

<section class="client-stats">


    <div class="client-stat-card">

        <div class="stat-card-top">

            <span class="stat-card-title">
                Commandes
            </span>

            <div class="stat-card-icon">
                <i class="bi bi-receipt"></i>
            </div>

        </div>

        <div class="stat-card-value">
            {{ nombreCommandes }}
        </div>

        <div class="stat-card-info">
            Commandes passées
        </div>

    </div>


    <div class="client-stat-card">

        <div class="stat-card-top">

            <span class="stat-card-title">
                En attente
            </span>

            <div class="stat-card-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>

        </div>

        <div class="stat-card-value">
            {{ commandesEnAttente }}
        </div>

        <div class="stat-card-info">
            Commandes en traitement
        </div>

    </div>


    <div class="client-stat-card">

        <div class="stat-card-top">

            <span class="stat-card-title">
                Confirmées
            </span>

            <div class="stat-card-icon">
                <i class="bi bi-check-circle"></i>
            </div>

        </div>

        <div class="stat-card-value">
            {{ commandesConfirmees }}
        </div>

        <div class="stat-card-info">
            Commandes validées
        </div>

    </div>


    <div class="client-stat-card">

        <div class="stat-card-top">

            <span class="stat-card-title">
                Total
            </span>

            <div class="stat-card-icon">
                <i class="bi bi-cash-stack"></i>
            </div>

        </div>

        <div
            class="stat-card-value"
            style="font-size: 21px;"
        >
            {{ totalCommandes|number_format(0, ',', ' ') }} Ar
        </div>

        <div class="stat-card-info">
            Montant cumulé
        </div>

    </div>

</section>


{# =========================================================
   GRILLE PRINCIPALE
   ========================================================= #}

<section class="client-grid">


    {# =====================================================
       DERNIERES COMMANDES
       ===================================================== #}

    <div class="client-card">

        <div class="client-card-header">

            <h2>
                Mes dernières commandes
            </h2>

            <a href="{{ path('app_client_commandes') }}">
                Voir toutes
            </a>

        </div>


        {% if dernieresCommandes is not empty %}

            {% for commande in dernieresCommandes %}

                {% set paiement = paiements[commande.id] ?? null %}
                {% set livraison = livraisons[commande.id] ?? null %}


                <div class="order-item">

                    <div class="order-left">

                        <span class="order-number">
                            {{ commande.numero }}
                        </span>

                        <span class="order-date">
                            {{ commande.createdAt|date('d/m/Y à H:i') }}
                        </span>


                        <div class="order-statuses">


                            {# =================================================
                               STATUT COMMANDE
                               ================================================= #}

                            {% if commande.statut == 'EN_ATTENTE' %}

                                <span class="client-badge client-badge-warning">
                                    Commande en attente
                                </span>

                            {% elseif commande.statut == 'CONFIRMEE' %}

                                <span class="client-badge client-badge-success">
                                    Commande confirmée
                                </span>

                            {% elseif commande.statut == 'ANNULEE' %}

                                <span class="client-badge client-badge-danger">
                                    Commande annulée
                                </span>

                            {% endif %}


                            {# =================================================
                               STATUT PAIEMENT
                               ================================================= #}

                            {% if paiement %}

                                {% if paiement.statut == 'PAYE' %}

                                    <span class="client-badge client-badge-success">
                                        Paiement payé
                                    </span>

                                {% elseif paiement.statut == 'EN_ATTENTE' %}

                                    <span class="client-badge client-badge-warning">
                                        Paiement en attente
                                    </span>

                                {% elseif paiement.statut == 'REFUSE' %}

                                    <span class="client-badge client-badge-danger">
                                        Paiement refusé
                                    </span>

                                {% endif %}

                            {% endif %}


                            {# =================================================
                               STATUT LIVRAISON
                               ================================================= #}

                            {% if livraison %}

                                {% if livraison.statut == 'EN_ATTENTE' %}

                                    <span class="client-badge client-badge-warning">
                                        Livraison en attente
                                    </span>

                                {% elseif livraison.statut == 'EN_COURS' %}

                                    <span class="client-badge client-badge-info">
                                        Livraison en cours
                                    </span>

                                {% elseif livraison.statut == 'LIVREE' %}

                                    <span class="client-badge client-badge-success">
                                        Livrée
                                    </span>

                                {% elseif livraison.statut == 'ANNULEE' %}

                                    <span class="client-badge client-badge-danger">
                                        Livraison annulée
                                    </span>

                                {% endif %}

                            {% endif %}

                        </div>

                    </div>


                    <div class="order-right">

                        <div class="order-total">
                            {{ commande.total|number_format(0, ',', ' ') }} Ar
                        </div>

                        <a
                            href="{{ path('app_client_commande_confirmation', {
                                id: commande.id
                            }) }}"
                            class="order-detail"
                        >
                            Voir le détail →
                        </a>

                    </div>

                </div>

            {% endfor %}


        {% else %}

            <div class="client-empty">

                <i class="bi bi-bag-x"></i>

                <strong>
                    Vous n'avez aucune commande
                </strong>

                <span>
                    Commencez vos achats pour créer votre première commande.
                </span>

                <a href="{{ path('app_client_produit_index') }}">
                    Découvrir les produits
                </a>

            </div>

        {% endif %}

    </div>


    {# =====================================================
       COLONNE DROITE
       ===================================================== #}

    <div>


        {# =================================================
           PANIER
           ================================================= #}

        <div class="client-card mb-3">

            <div class="client-card-header">

                <h2>
                    Mon panier
                </h2>

                <i class="bi bi-cart3 text-primary"></i>

            </div>


            <div class="client-card-body cart-summary">

                <div class="cart-icon">
                    <i class="bi bi-cart3"></i>
                </div>

                <h3>
                    {{ panierQuantity }} article(s)
                </h3>

                <div class="cart-count">
                    Produits actuellement dans votre panier
                </div>

                <div class="cart-total-client">
                    {{ panierTotal|number_format(0, ',', ' ') }} Ar
                </div>

                <a
                    href="{{ path('app_client_cart') }}"
                    class="cart-button"
                >
                    Ouvrir le panier
                </a>

            </div>

        </div>


        {# =================================================
           PROFIL
           ================================================= #}

        <div class="client-card mb-3">

            <div class="client-card-header">

                <h2>
                    Mon profil
                </h2>

                <i class="bi bi-person-circle text-primary"></i>

            </div>


            <div class="client-card-body">

                {% set initials = '' %}

                {% if user.prenom %}
                    {% set initials = initials ~ user.prenom|slice(0, 1)|upper %}
                {% endif %}

                {% if user.nom %}
                    {% set initials = initials ~ user.nom|slice(0, 1)|upper %}
                {% endif %}


                <div class="profile-box">

                    <div class="profile-avatar-client">
                        {{ initials|default('CL') }}
                    </div>

                    <div>

                        <div class="profile-name">
                            {{ user.prenom }} {{ user.nom }}
                        </div>

                        <div class="profile-email">
                            {{ user.email }}
                        </div>

                    </div>

                </div>


                <a
                    href="{{ path('app_client_profile') }}"
                    class="profile-button"
                >
                    Gérer mon profil
                </a>

            </div>

        </div>


        {# =================================================
           ACTIVITE
           ================================================= #}

        <div class="client-card">

            <div class="client-card-header">

                <h2>
                    Mon activité
                </h2>

            </div>


            <div class="client-card-body">

                {% set totalBase = nombreCommandes > 0 ? nombreCommandes : 1 %}


                <div class="activity-row">

                    <div class="activity-label">

                        <span>
                            Commandes confirmées
                        </span>

                        <span>
                            {{ commandesConfirmees }}
                        </span>

                    </div>


                    <div class="activity-progress">

                        <div
                            class="activity-progress-bar"
                            style="width: {{ ((commandesConfirmees / totalBase) * 100)|round }}%;"
                        ></div>

                    </div>

                </div>


                <div class="activity-row">

                    <div class="activity-label">

                        <span>
                            Paiements effectués
                        </span>

                        <span>
                            {{ paiementsPayes }}
                        </span>

                    </div>


                    <div class="activity-progress">

                        <div
                            class="activity-progress-bar"
                            style="width: {{ ((paiementsPayes / totalBase) * 100)|round }}%;"
                        ></div>

                    </div>

                </div>


                <div class="activity-row">

                    <div class="activity-label">

                        <span>
                            Livraisons terminées
                        </span>

                        <span>
                            {{ livraisonsLivrees }}
                        </span>

                    </div>


                    <div class="activity-progress">

                        <div
                            class="activity-progress-bar"
                            style="width: {{ ((livraisonsLivrees / totalBase) * 100)|round }}%;"
                        ></div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


{# =========================================================
   MES LIVRAISONS
   ========================================================= #}

<section class="client-deliveries-section">


    <div class="section-heading">

        <div>

            <span class="section-kicker">
                <i class="bi bi-truck"></i>
                Suivi
            </span>

            <h2>
                Mes livraisons
            </h2>

            <p>
                Suivez l'état de livraison de vos dernières commandes.
            </p>

        </div>


        <a
            href="{{ path('app_client_commandes') }}"
            class="btn btn-outline-primary"
        >
            <i class="bi bi-receipt"></i>
            Voir mes commandes
        </a>

    </div>


    <div class="delivery-dashboard-grid">


        {% set livraisonTrouvee = false %}


        {% for commande in dernieresCommandes %}

            {% set livraison = livraisons[commande.id] ?? null %}
            {% set paiement = paiements[commande.id] ?? null %}


            {% if livraison or commande.statut == 'CONFIRMEE' %}

                {% set livraisonTrouvee = true %}


                <div class="delivery-dashboard-card">


                    {# =================================================
                       EN-TETE
                       ================================================= #}

                    <div class="delivery-card-top">

                        <div>

                            <span class="delivery-label">
                                Commande
                            </span>

                            <strong>
                                {{ commande.numero }}
                            </strong>

                        </div>


                        {% if livraison %}

                            {% if livraison.statut == 'EN_ATTENTE' %}

                                <span class="delivery-status status-waiting">
                                    <i class="bi bi-clock"></i>
                                    En attente
                                </span>

                            {% elseif livraison.statut == 'EN_COURS' %}

                                <span class="delivery-status status-progress">
                                    <i class="bi bi-truck"></i>
                                    En cours
                                </span>

                            {% elseif livraison.statut == 'LIVREE' %}

                                <span class="delivery-status status-delivered">
                                    <i class="bi bi-check-circle"></i>
                                    Livrée
                                </span>

                            {% elseif livraison.statut == 'ANNULEE' %}

                                <span class="delivery-status status-cancelled">
                                    <i class="bi bi-x-circle"></i>
                                    Annulée
                                </span>

                            {% endif %}

                        {% else %}

                            <span class="delivery-status status-to-organize">
                                <i class="bi bi-exclamation-circle"></i>
                                À organiser
                            </span>

                        {% endif %}

                    </div>


                    {# =================================================
                       CONTENU
                       ================================================= #}

                    <div class="delivery-card-content">


                        {% if livraison %}


                            {# DESTINATION #}

                            <div class="delivery-info-line">

                                <div class="delivery-info-icon">
                                    <i class="bi bi-geo-alt"></i>
                                </div>

                                <div>

                                    <span>
                                        Destination
                                    </span>

                                    <strong>
                                        {{ livraison.ville ?: 'Ville non renseignée' }}
                                    </strong>

                                </div>

                            </div>


                            {# MODE LIVRAISON #}

                            <div class="delivery-info-line">

                                <div class="delivery-info-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>

                                <div>

                                    <span>
                                        Mode
                                    </span>

                                    <strong>

                                        {% if livraison.modeLivraison == 'DOMICILE' %}

                                            Livraison à domicile

                                        {% elseif livraison.modeLivraison == 'POINT_RELAIS' %}

                                            Point relais

                                        {% elseif livraison.modeLivraison == 'RETRAIT' %}

                                            Retrait

                                        {% else %}

                                            {{ livraison.modeLivraison }}

                                        {% endif %}

                                    </strong>

                                </div>

                            </div>


                            {# DATE LIVRAISON #}

                            {% if livraison.dateLivraison %}

                                <div class="delivery-info-line">

                                    <div class="delivery-info-icon">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>

                                    <div>

                                        <span>
                                            Date de livraison
                                        </span>

                                        <strong>
                                            {{ livraison.dateLivraison|date('d/m/Y H:i') }}
                                        </strong>

                                    </div>

                                </div>

                            {% endif %}


                            {# ADRESSE #}

                            {% if livraison.adresseLivraison %}

                                <div class="delivery-info-line">

                                    <div class="delivery-info-icon">
                                        <i class="bi bi-house"></i>
                                    </div>

                                    <div>

                                        <span>
                                            Adresse
                                        </span>

                                        <strong>
                                            {{ livraison.adresseLivraison }}
                                        </strong>

                                    </div>

                                </div>

                            {% endif %}


                        {% else %}


                            <div class="delivery-empty-content">

                                <div class="delivery-empty-icon">
                                    <i class="bi bi-truck"></i>
                                </div>

                                <div>

                                    <h3>
                                        Livraison non configurée
                                    </h3>

                                    <p>
                                        Votre commande est confirmée.
                                        Organisez maintenant votre livraison.
                                    </p>

                                </div>

                            </div>


                        {% endif %}

                    </div>


                    {# =================================================
                       PIED DE CARTE
                       ================================================= #}

                    <div class="delivery-card-footer">


                        <div class="delivery-order-total">

                            <span>
                                Total
                            </span>

                            <strong>
                                {{ commande.total|number_format(0, ',', ' ') }} Ar
                            </strong>

                        </div>


                        <div class="delivery-actions">


                            {% if not livraison
                                and commande.statut == 'CONFIRMEE'
                                and paiement
                                and paiement.statut == 'PAYE'
                            %}

                                <a
                                    href="{{ path('app_client_livraison_new', {
                                        id: commande.id
                                    }) }}"
                                    class="btn btn-primary"
                                >
                                    <i class="bi bi-truck"></i>
                                    Organiser la livraison
                                </a>


                            {% else %}

                                <a
                                    href="{{ path('app_client_commande_confirmation', {
                                        id: commande.id
                                    }) }}"
                                    class="btn btn-outline-primary"
                                >
                                    <i class="bi bi-eye"></i>
                                    Voir la commande
                                </a>

                            {% endif %}


                        </div>

                    </div>

                </div>

            {% endif %}

        {% endfor %}


        {# =================================================
           AUCUNE LIVRAISON
           ================================================= #}

        {% if not livraisonTrouvee %}

            <div class="delivery-dashboard-empty">

                <div class="delivery-empty-big-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <h3>
                    Aucune livraison à afficher
                </h3>

                <p>
                    Vos informations de livraison apparaîtront ici
                    lorsqu'une commande sera confirmée.
                </p>

                <a
                    href="{{ path('app_client_commandes') }}"
                    class="btn btn-primary"
                >
                    <i class="bi bi-receipt"></i>
                    Consulter mes commandes
                </a>

            </div>

        {% endif %}


    </div>

</section>


{# =========================================================
   ACTIONS RAPIDES
   ========================================================= #}

