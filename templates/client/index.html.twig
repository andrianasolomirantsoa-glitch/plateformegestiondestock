    <div class="client-card-header px-0 border-0 mb-2">

        <h2>
            Accès rapides
        </h2>

    </div>


    <div class="quick-actions">


        {# PRODUITS #}

        <a
            href="{{ path('app_client_produit_index') }}"
            class="quick-action"
        >

            <div class="quick-action-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h3>
                Produits
            </h3>

            <p>
                Parcourir les produits disponibles.
            </p>

        </a>


        {# PANIER #}

        <a
            href="{{ path('app_client_cart') }}"
            class="quick-action"
        >

            <div class="quick-action-icon">
                <i class="bi bi-cart3"></i>
            </div>

            <h3>
                Mon panier
            </h3>

            <p>
                Vérifier et modifier vos articles.
            </p>

        </a>


        {# COMMANDES #}

        <a
            href="{{ path('app_client_commandes') }}"
            class="quick-action"
        >

            <div class="quick-action-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <h3>
                Mes commandes
            </h3>

            <p>
                Consulter votre historique de commandes.
            </p>

        </a>


        {# PROFIL #}

        <a
            href="{{ path('app_client_profile') }}"
            class="quick-action"
        >

            <div class="quick-action-icon">
                <i class="bi bi-person"></i>
            </div>

            <h3>
                Mon profil
            </h3>

            <p>
                Modifier vos informations personnelles.
            </p>

        </a>


    </div>

</section>


</div>

{% endblock %}
