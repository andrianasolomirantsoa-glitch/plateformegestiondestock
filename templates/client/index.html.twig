{% extends 'base.html.twig' %}

{% block title %}Mon espace client | Jumbo Score{% endblock %}

{% block body %}

<style>
/* =========================================================
   DASHBOARD CLIENT - JUMBO SCORE
   ========================================================= */

.client-dashboard {
    --red: #d71920;
    --red-dark: #b5121b;
    --yellow: #ffdc36;
    --navy: #172554;
    --text: #202b40;
    --muted: #778197;
    --border: #e9edf3;
    --surface: #ffffff;
    --background: #f5f7fb;

    max-width: 1500px;
    margin: 0 auto;
    padding-bottom: 40px;
    color: var(--text);
}

.client-dashboard *,
.client-dashboard *::before,
.client-dashboard *::after {
    box-sizing: border-box;
}

.client-dashboard a {
    transition: .2s ease;
}

.client-dashboard a:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
}

/* =========================================================
   EN-TETE BOUTIQUE
   ========================================================= */

.jumbo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 17px 24px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 15px 15px 0 0;
}

.jumbo-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
}

.jumbo-brand img {
    width: auto;
    max-width: 185px;
    height: 48px;
    object-fit: contain;
}

.jumbo-brand-text {
    color: var(--red);
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -.8px;
}

.jumbo-search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    max-width: 570px;
    min-width: 0;
    padding: 12px 15px;
    background: #f7f8fb;
    border: 1px solid #e4e8ef;
    border-radius: 9px;
    color: var(--muted);
    font-size: 12px;
}

.jumbo-search i {
    color: var(--red);
    font-size: 17px;
}

.jumbo-tools {
    display: flex;
    align-items: center;
    gap: 22px;
}

.jumbo-tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--navy);
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
}

.jumbo-tool > i {
    color: var(--red);
    font-size: 22px;
}

.jumbo-cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 23px;
    height: 23px;
    padding: 0 6px;
    background: var(--yellow);
    color: var(--navy);
    border-radius: 50px;
    font-size: 10px;
    font-weight: 900;
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.jumbo-nav {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    padding: 0 18px;
    background: var(--navy);
    border-radius: 0 0 13px 13px;
    margin-bottom: 24px;
}

.jumbo-nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 13px;
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
}

.jumbo-nav a:hover,
.jumbo-nav a.active {
    color: var(--yellow);
    background: rgba(255,255,255,.06);
}

/* =========================================================
   BANNIERE BIENVENUE
   ========================================================= */

.client-welcome {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    overflow: hidden;
    padding: 34px;
    margin-bottom: 24px;
    color: #fff;
    background: linear-gradient(120deg, #b5121b 0%, #e5232b 70%, #ed363d 100%);
    border-radius: 18px;
    box-shadow: 0 10px 28px rgba(215,25,32,.12);
}

.client-welcome::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    right: 10%;
    top: -140px;
    border: 35px solid rgba(255,255,255,.06);
    border-radius: 50%;
    pointer-events: none;
}

.client-welcome-text {
    position: relative;
    z-index: 1;
    min-width: 0;
}

.welcome-small {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--yellow);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.client-welcome h1 {
    margin: 0;
    font-size: clamp(23px, 3vw, 34px);
    font-weight: 900;
    letter-spacing: -.7px;
}

.client-welcome p {
    max-width: 620px;
    margin: 10px 0 0;
    color: #ffe4e5;
    font-size: 13px;
    line-height: 1.8;
}

.welcome-action {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
}

.welcome-action a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 19px;
    background: var(--yellow);
    color: var(--navy);
    text-decoration: none;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 900;
}

.welcome-action a:hover {
    background: #ffe977;
    transform: translateY(-2px);
}

/* =========================================================
   STATISTIQUES
   ========================================================= */

.client-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 17px;
    margin-bottom: 26px;
}

.client-stat-card {
    min-width: 0;
    padding: 21px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(23,37,84,.035);
    transition: .2s ease;
}

.client-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(23,37,84,.07);
}

.stat-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.stat-card-title {
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
}

.stat-card-icon {
    width: 43px;
    height: 43px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff0f0;
    color: var(--red);
    border-radius: 12px;
    font-size: 19px;
}

.stat-card-value {
    margin-top: 16px;
    color: var(--navy);
    font-size: 29px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

.stat-card-info {
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
}

/* =========================================================
   GRILLE PRINCIPALE
   ========================================================= */

.client-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(270px, .8fr);
    gap: 22px;
    margin-bottom: 30px;
}

.client-card {
    min-width: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(23,37,84,.035);
}

.client-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 19px 21px;
    border-bottom: 1px solid var(--border);
}

.client-card-header h2 {
    margin: 0;
    color: var(--navy);
    font-size: 15px;
    font-weight: 900;
}

.client-card-header > i {
    color: var(--red);
    font-size: 19px;
}

.client-card-header a {
    color: var(--red);
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

.client-card-header a:hover {
    text-decoration: underline;
}

.client-card-body {
    padding: 21px;
}

/* =========================================================
   COMMANDES
   ========================================================= */

.order-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 18px 21px;
    border-bottom: 1px solid #f0f2f6;
}

.order-item:last-child {
    border-bottom: none;
}

.order-left {
    min-width: 0;
}

.order-number {
    display: block;
    color: var(--navy);
    font-size: 13px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

.order-date {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
}

.order-statuses {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}

.client-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 30px;
    font-size: 9px;
    font-weight: 800;
}

.client-badge-warning {
    background: #fff7ed;
    color: #c2410c;
}

.client-badge-success {
    background: #ecfdf3;
    color: #15803d;
}

.client-badge-danger {
    background: #fef2f2;
    color: #b91c1c;
}

.client-badge-info {
    background: #eff6ff;
    color: #1d4ed8;
}

.order-right {
    flex-shrink: 0;
    text-align: right;
}

.order-total {
    margin-bottom: 8px;
    color: var(--navy);
    font-size: 14px;
    font-weight: 900;
}

.order-detail {
    color: var(--red);
    text-decoration: none;
    font-size: 10px;
    font-weight: 800;
}

.order-detail:hover {
    text-decoration: underline;
}

/* =========================================================
   ETAT VIDE
   ========================================================= */

.client-empty {
    padding: 38px 20px;
    text-align: center;
    color: var(--muted);
}

.client-empty > i {
    display: block;
    margin-bottom: 12px;
    color: var(--red);
    font-size: 35px;
}

.client-empty strong {
    display: block;
    color: var(--navy);
    font-size: 14px;
}

.client-empty span {
    display: block;
    margin-top: 7px;
    font-size: 11px;
    line-height: 1.7;
}

.client-empty a {
    display: inline-flex;
    margin-top: 16px;
    padding: 11px 15px;
    background: var(--red);
    color: #fff;
    text-decoration: none;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 800;
}

/* =========================================================
   PANIER
   ========================================================= */

.cart-summary {
    text-align: center;
}

.cart-icon {
    width: 62px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    border-radius: 17px;
    background: #fff0f0;
    color: var(--red);
    font-size: 26px;
}

.cart-summary h3 {
    margin: 0;
    color: var(--navy);
    font-size: 16px;
    font-weight: 900;
}

.cart-count {
    margin-top: 7px;
    color: var(--muted);
    font-size: 11px;
}

.cart-total-client {
    margin-top: 18px;
    color: var(--navy);
    font-size: 25px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

.cart-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 18px;
    padding: 13px;
    background: var(--red);
    color: #fff;
    text-decoration: none;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 900;
}

.cart-button:hover {
    background: var(--red-dark);
    color: #fff;
}

/* =========================================================
   PROFIL
   ========================================================= */

.profile-box {
    display: flex;
    align-items: center;
    gap: 13px;
}

.profile-avatar-client {
    width: 53px;
    height: 53px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff0f0;
    color: var(--red);
    font-size: 17px;
    font-weight: 900;
}

.profile-name {
    color: var(--navy);
    font-size: 13px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

.profile-email {
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
    overflow-wrap: anywhere;
}

.profile-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    padding: 10px 13px;
    background: #fff0f0;
    color: var(--red);
    border-radius: 8px;
    text-decoration: none;
    font-size: 10px;
    font-weight: 900;
}

.profile-button:hover {
    background: #ffe0e0;
    color: var(--red-dark);
}

/* =========================================================
   ACTIVITE
   ========================================================= */

.activity-row {
    margin-bottom: 19px;
}

.activity-row:last-child {
    margin-bottom: 0;
}

.activity-label {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 800;
}

.activity-label span:last-child {
    color: var(--muted);
}

.activity-progress {
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: 20px;
    background: #edf0f5;
}

.activity-progress-bar {
    height: 100%;
    border-radius: inherit;
    background: var(--red);
}

/* =========================================================
   LIVRAISONS
   ========================================================= */

.client-deliveries-section {
    margin-bottom: 30px;
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
}

.section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    color: var(--red);
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.section-heading h2 {
    margin: 0;
    color: var(--navy);
    font-size: 22px;
    font-weight: 900;
}

.section-heading p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

.delivery-dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 17px;
}

.delivery-dashboard-card {
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(23,37,84,.035);
}

.delivery-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 17px 19px;
    border-bottom: 1px solid var(--border);
}

.delivery-label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: .06em;
}

.delivery-card-top strong {
    color: var(--navy);
    font-size: 12px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

.delivery-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 9px;
    border-radius: 30px;
    font-size: 9px;
    font-weight: 900;
    white-space: nowrap;
}

.status-waiting {
    background: #fff7ed;
    color: #c2410c;
}

.status-progress {
    background: #eff6ff;
    color: #1d4ed8;
}

.status-delivered {
    background: #ecfdf3;
    color: #15803d;
}

.status-cancelled {
    background: #fef2f2;
    color: #b91c1c;
}

.status-to-organize {
    background: #fefce8;
    color: #a16207;
}

.delivery-card-content {
    padding: 18px 19px;
}

.delivery-info-line {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.delivery-info-line:last-child {
    margin-bottom: 0;
}

.delivery-info-icon {
    width: 37px;
    height: 37px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 10px;
    background: #fff0f0;
    color: var(--red);
    font-size: 16px;
}

.delivery-info-line span {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 9px;
}

.delivery-info-line strong {
    display: block;
    color: var(--navy);
    font-size: 11px;
    overflow-wrap: anywhere;
}

.delivery-empty-content {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 105px;
}

.delivery-empty-icon,
.delivery-empty-big-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #fff0f0;
    color: var(--red);
    border-radius: 13px;
}

.delivery-empty-icon {
    width: 46px;
    height: 46px;
    font-size: 20px;
}

.delivery-empty-content h3 {
    margin: 0 0 5px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 900;
}

.delivery-empty-content p {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.7;
}

.delivery-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 19px;
    background: #fafbfc;
    border-top: 1px solid var(--border);
}

.delivery-order-total span {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 9px;
}

.delivery-order-total strong {
    color: var(--navy);
    font-size: 13px;
    font-weight: 900;
}

.delivery-actions .btn {
    border-radius: 8px;
    font-size: 10px;
    font-weight: 800;
}

.delivery-actions .btn-primary {
    background: var(--red);
    border-color: var(--red);
}

.delivery-actions .btn-primary:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);
}

.delivery-dashboard-empty {
    grid-column: 1 / -1;
    padding: 38px 20px;
    text-align: center;
    background: #fff;
    border: 1px dashed #d5dce8;
    border-radius: 14px;
}

.delivery-empty-big-icon {
    width: 58px;
    height: 58px;
    margin: 0 auto 14px;
    font-size: 25px;
}

.delivery-dashboard-empty h3 {
    margin: 0 0 7px;
    color: var(--navy);
    font-size: 15px;
    font-weight: 900;
}

.delivery-dashboard-empty p {
    max-width: 480px;
    margin: 0 auto 17px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

/* =========================================================
   ACTIONS RAPIDES
   ========================================================= */

.quick-section {
    margin-top: 30px;
}

.quick-heading {
    margin-bottom: 17px;
}

.quick-heading h2 {
    margin: 0;
    color: var(--navy);
    font-size: 21px;
    font-weight: 900;
}

.quick-heading p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 11px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.quick-action {
    display: block;
    min-width: 0;
    padding: 21px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(23,37,84,.035);
}

.quick-action:hover {
    transform: translateY(-3px);
    border-color: #f2bfc1;
    box-shadow: 0 9px 25px rgba(23,37,84,.07);
}

.quick-action-icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    background: #fff0f0;
    color: var(--red);
    border-radius: 12px;
    font-size: 20px;
}

.quick-action h3 {
    margin: 0;
    color: var(--navy);
    font-size: 13px;
    font-weight: 900;
}

.quick-action p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.7;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1150px) {
    .client-stats,
    .quick-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .client-grid {
        grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr);
    }
}

@media (max-width: 850px) {
    .jumbo-header {
        flex-wrap: wrap;
        gap: 15px;
    }

    .jumbo-search {
        order: 3;
        flex-basis: 100%;
        max-width: none;
    }

    .jumbo-nav {
        overflow-x: auto;
        flex-wrap: nowrap;
    }

    .jumbo-nav a {
        flex-shrink: 0;
    }

    .client-grid {
        grid-template-columns: 1fr;
    }

    .delivery-dashboard-grid {
        grid-template-columns: 1fr;
    }

    .client-welcome {
        align-items: flex-start;
        flex-direction: column;
        padding: 26px;
    }

    .welcome-action,
    .welcome-action a {
        width: 100%;
    }
}

@media (max-width: 600px) {
    .client-dashboard {
        padding-bottom: 24px;
    }

    .jumbo-header {
        padding: 14px;
    }

    .jumbo-brand img {
        max-width: 140px;
        height: 40px;
    }

    .jumbo-brand-text {
        font-size: 21px;
    }

    .jumbo-tools {
        gap: 13px;
    }

    .jumbo-tool {
        gap: 5px;
    }

    .jumbo-tool > i {
        font-size: 19px;
    }

    .jumbo-tool > span:not(.jumbo-cart-count) {
        display: none;
    }

    .jumbo-nav {
        margin-bottom: 18px;
        padding: 0 7px;
    }

    .jumbo-nav a {
        padding: 13px 11px;
        font-size: 11px;
    }

    .client-welcome {
        padding: 23px;
        margin-bottom: 18px;
    }

    .client-welcome h1 {
        font-size: 24px;
    }

    .client-stats,
    .quick-actions {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .client-stat-card {
        padding: 17px;
    }

    .stat-card-value {
        font-size: 25px;
    }

    .client-grid {
        gap: 16px;
        margin-bottom: 24px;
    }

    .client-card-header,
    .client-card-body {
        padding: 16px;
    }

    .order-item {
        align-items: flex-start;
        flex-direction: column;
        padding: 17px 16px;
    }

    .order-right {
        width: 100%;
        text-align: left;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .section-heading .btn {
        width: 100%;
    }

    .delivery-card-top {
        align-items: flex-start;
        flex-direction: column;
    }

    .delivery-card-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .delivery-actions,
    .delivery-actions .btn {
        width: 100%;
    }

    .quick-action {
        padding: 18px;
    }
}
</style>

<div class="client-dashboard">

    {# =====================================================
       EN-TETE BOUTIQUE
       ===================================================== #}

    <header class="jumbo-header">

        <a href="{{ path('app_home') }}" class="jumbo-brand">
            {# Remplacer par le chemin réel du logo #}
            <img
                src="{{ asset('images/jumbo-score-logo.png') }}"
                alt="Jumbo Score"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            >
            <span class="jumbo-brand-text" style="display:none;">
                JUMBO SCORE
            </span>
        </a>

        <div class="jumbo-search">
            <i class="bi bi-search"></i>
            <span>Bienvenue dans votre espace client</span>
        </div>

        <div class="jumbo-tools">

            <a href="{{ path('app_client_profile') }}"
               class="jumbo-tool">
                <i class="bi bi-person-circle"></i>
                <span>Mon compte</span>
            </a>

            <a href="{{ path('app_client_cart') }}"
               class="jumbo-tool">
                <i class="bi bi-cart3"></i>
                <span>Panier</span>
                <strong class="jumbo-cart-count">
                    {{ panierQuantity }}
                </strong>
            </a>

        </div>

    </header>

    {# =====================================================
       NAVIGATION
       ===================================================== #}

    <nav class="jumbo-nav" aria-label="Navigation client">

        <a href="{{ path('app_home') }}">
            <i class="bi bi-house"></i>
            Accueil
        </a>

        <a href="{{ path('app_client_produit_index') }}">
            <i class="bi bi-grid"></i>
            Produits
        </a>

        <a href="{{ path('app_client_commandes') }}">
            <i class="bi bi-receipt"></i>
            Mes commandes
        </a>

        <a href="{{ path('app_client_cart') }}">
            <i class="bi bi-basket"></i>
            Mon panier
        </a>

        <a href="{{ path('app_client_profile') }}">
            <i class="bi bi-person"></i>
            Mon compte
        </a>

    </nav>

    {# =====================================================
       BIENVENUE
       ===================================================== #}

    <section class="client-welcome">

        <div class="client-welcome-text">

            <span class="welcome-small">
                <i class="bi bi-stars"></i>
                VOTRE ESPACE CLIENT
            </span>

            <h1>
                Bonjour {{ user.prenom }} {{ user.nom }} !
            </h1>

            <p>
                Bienvenue dans votre espace personnel.
                Retrouvez vos commandes, gérez votre panier
                et suivez vos livraisons en toute simplicité.
            </p>

        </div>

        <div class="welcome-action">
            <a href="{{ path('app_client_produit_index') }}">
                <i class="bi bi-bag"></i>
                Découvrir les produits
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </section>

    {# =====================================================
       STATISTIQUES
       ===================================================== #}

    <section class="client-stats">

        <div class="client-stat-card">

            <div class="stat-card-top">
                <span class="stat-card-title">Commandes</span>
                <div class="stat-card-icon">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>

            <div class="stat-card-value">
                {{ nombreCommandes }}
            </div>

            <div class="stat-card-info">
                Commandes passées
            </div>

        </div>

        <div class="client-stat-card">

            <div class="stat-card-top">
                <span class="stat-card-title">En attente</span>
                <div class="stat-card-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>

            <div class="stat-card-value">
                {{ commandesEnAttente }}
            </div>

            <div class="stat-card-info">
                Commandes en attente
            </div>

        </div>

        <div class="client-stat-card">

            <div class="stat-card-top">
                <span class="stat-card-title">Confirmées</span>
                <div class="stat-card-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>

            <div class="stat-card-value">
                {{ commandesConfirmees }}
            </div>

            <div class="stat-card-info">
                Commandes validées
            </div>

        </div>

        <div class="client-stat-card">

            <div class="stat-card-top">
                <span class="stat-card-title">Mes dépenses</span>
                <div class="stat-card-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>

            <div class="stat-card-value" style="font-size:21px;">
                {{ totalCommandes|number_format(0, ',', ' ') }} Ar
            </div>

            <div class="stat-card-info">
                Montant cumulé des commandes
            </div>

        </div>

    </section>

    {# =====================================================
       COMMANDES + COLONNE DROITE
       ===================================================== #}

    <section class="client-grid">

        {# DERNIERES COMMANDES #}

        <div class="client-card">

            <div class="client-card-header">
                <h2>
                    <i class="bi bi-receipt-cutoff"
                       style="color:#d71920;margin-right:7px;"></i>
                    Mes dernières commandes
                </h2>

                <a href="{{ path('app_client_commandes') }}">
                    Voir toutes <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            {% if dernieresCommandes is not empty %}

                {% for commande in dernieresCommandes %}

                    {% set paiement = paiements[commande.id] ?? null %}
                    {% set livraison = livraisons[commande.id] ?? null %}

                    <div class="order-item">

                        <div class="order-left">

                            <span class="order-number">
                                {{ commande.numero }}
                            </span>

                            <span class="order-date">
                                <i class="bi bi-calendar3"></i>
                                {{ commande.createdAt|date('d/m/Y à H:i') }}
                            </span>

                            <div class="order-statuses">

                                {# STATUT COMMANDE #}

                                {% if commande.statut == 'EN_ATTENTE' %}
                                    <span class="client-badge client-badge-warning">
                                        <i class="bi bi-clock"></i>
                                        Commande en attente
                                    </span>
                                {% elseif commande.statut == 'CONFIRMEE' %}
                                    <span class="client-badge client-badge-success">
                                        <i class="bi bi-check-circle"></i>
                                        Confirmée
                                    </span>
                                {% elseif commande.statut == 'ANNULEE' %}
                                    <span class="client-badge client-badge-danger">
                                        <i class="bi bi-x-circle"></i>
                                        Annulée
                                    </span>
                                {% endif %}

                                {# STATUT PAIEMENT #}

                                {% if paiement %}
                                    {% if paiement.statut == 'PAYE' %}
                                        <span class="client-badge client-badge-success">
                                            Paiement payé
                                        </span>
                                    {% elseif paiement.statut == 'EN_ATTENTE' %}
                                        <span class="client-badge client-badge-warning">
                                            Paiement en attente
                                        </span>
                                    {% elseif paiement.statut == 'REFUSE' %}
                                        <span class="client-badge client-badge-danger">
                                            Paiement refusé
                                        </span>
                                    {% endif %}
                                {% endif %}

                                {# STATUT LIVRAISON #}

                                {% if livraison %}
                                    {% if livraison.statut == 'EN_ATTENTE' %}
                                        <span class="client-badge client-badge-warning">
                                            Livraison en attente
                                        </span>
                                    {% elseif livraison.statut == 'EN_COURS' %}
                                        <span class="client-badge client-badge-info">
                                            Livraison en cours
                                        </span>
                                    {% elseif livraison.statut == 'LIVREE' %}
                                        <span class="client-badge client-badge-success">
                                            Livrée
                                        </span>
                                    {% elseif livraison.statut == 'ANNULEE' %}
                                        <span class="client-badge client-badge-danger">
                                            Livraison annulée
                                        </span>
                                    {% endif %}
                                {% endif %}

                            </div>

                        </div>

                        <div class="order-right">

                            <div class="order-total">
                                {{ commande.total|number_format(0, ',', ' ') }} Ar
                            </div>

                            <a
                                href="{{ path('app_client_commande_confirmation', {
                                    id: commande.id
                                }) }}"
                                class="order-detail"
                            >
                                Voir le détail
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                <div class="client-empty">
                    <i class="bi bi-bag-x"></i>

                    <strong>
                        Aucune commande pour le moment
                    </strong>

                    <span>
                        Découvrez notre catalogue et passez
                        votre première commande.
                    </span>

                    <a href="{{ path('app_client_produit_index') }}">
                        Découvrir les produits
                    </a>
                </div>

            {% endif %}

        </div>

        {# COLONNE DROITE #}

        <div>

            {# PANIER #}

            <div class="client-card" style="margin-bottom:17px;">

                <div class="client-card-header">
                    <h2>Mon panier</h2>
                    <i class="bi bi-cart3"></i>
                </div>

                <div class="client-card-body cart-summary">

                    <div class="cart-icon">
                        <i class="bi bi-basket2"></i>
                    </div>

                    <h3>
                        {{ panierQuantity }} article(s)
                    </h3>

                    <div class="cart-count">
                        Produits actuellement dans votre panier
                    </div>

                    <div class="cart-total-client">
                        {{ panierTotal|number_format(0, ',', ' ') }} Ar
                    </div>

                    <a href="{{ path('app_client_cart') }}"
                       class="cart-button">
                        <i class="bi bi-cart3"></i>
                        Ouvrir mon panier
                    </a>

                </div>

            </div>

            {# PROFIL #}

            <div class="client-card" style="margin-bottom:17px;">

                <div class="client-card-header">
                    <h2>Mon profil</h2>
                    <i class="bi bi-person-circle"></i>
                </div>

                <div class="client-card-body">

                    {% set initials = '' %}

                    {% if user.prenom %}
                        {% set initials = initials ~ user.prenom|slice(0, 1)|upper %}
                    {% endif %}

                    {% if user.nom %}
                        {% set initials = initials ~ user.nom|slice(0, 1)|upper %}
                    {% endif %}

                    <div class="profile-box">

                        <div class="profile-avatar-client">
                            {{ initials|default('CL') }}
                        </div>

                        <div>
                            <div class="profile-name">
                                {{ user.prenom }} {{ user.nom }}
                            </div>

                            <div class="profile-email">
                                {{ user.email }}
                            </div>
                        </div>

                    </div>

                    <a href="{{ path('app_client_profile') }}"
                       class="profile-button">
                        <i class="bi bi-pencil-square"></i>
                        Gérer mon profil
                    </a>

                </div>

            </div>

            {# ACTIVITE #}

            <div class="client-card">

                <div class="client-card-header">
                    <h2>Mon activité</h2>
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div class="client-card-body">

                    {% set totalBase = nombreCommandes > 0 ? nombreCommandes : 1 %}

                    {% set pctConfirmes =
                        nombreCommandes > 0
                        ? ((commandesConfirmees / totalBase) * 100)|round
                        : 0
                    %}

                    {% set pctPayes =
                        nombreCommandes > 0
                        ? ((paiementsPayes / totalBase) * 100)|round
                        : 0
                    %}

                    {% set pctLivrees =
                        nombreCommandes > 0
                        ? ((livraisonsLivrees / totalBase) * 100)|round
                        : 0
                    %}

                    <div class="activity-row">
                        <div class="activity-label">
                            <span>Commandes confirmées</span>
                            <span>{{ commandesConfirmees }}</span>
                        </div>

                        <div class="activity-progress">
                            <div class="activity-progress-bar"
                                 style="width:{{ min(100, pctConfirmes) }}%;">
                            </div>
                        </div>
                    </div>

                    <div class="activity-row">
                        <div class="activity-label">
                            <span>Paiements effectués</span>
                            <span>{{ paiementsPayes }}</span>
                        </div>

                        <div class="activity-progress">
                            <div class="activity-progress-bar"
                                 style="width:{{ min(100, pctPayes) }}%;">
                            </div>
                        </div>
                    </div>

                    <div class="activity-row">
                        <div class="activity-label">
                            <span>Livraisons terminées</span>
                            <span>{{ livraisonsLivrees }}</span>
                        </div>

                        <div class="activity-progress">
                            <div class="activity-progress-bar"
                                 style="width:{{ min(100, pctLivrees) }}%;">
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>

    {# =====================================================
       MES LIVRAISONS
       ===================================================== #}

    <section class="client-deliveries-section">

        <div class="section-heading">

            <div>
                <span class="section-kicker">
                    <i class="bi bi-truck"></i>
                    SERVICE DE LIVRAISON
                </span>

                <h2>Mes livraisons</h2>

                <p>
                    Suivez l'évolution de vos commandes et
                    retrouvez vos informations de livraison.
                </p>
            </div>

            <a href="{{ path('app_client_commandes') }}"
               class="btn btn-outline-primary">
                <i class="bi bi-receipt"></i>
                Voir mes commandes
            </a>

        </div>

        <div class="delivery-dashboard-grid">

            {% set livraisonTrouvee = false %}

            {% for commande in dernieresCommandes %}

                {% set livraison = livraisons[commande.id] ?? null %}
                {% set paiement = paiements[commande.id] ?? null %}

                {% if livraison or commande.statut == 'CONFIRMEE' %}

                    {% set livraisonTrouvee = true %}

                    <div class="delivery-dashboard-card">

                        {# ENTETE #}

                        <div class="delivery-card-top">

                            <div>
                                <span class="delivery-label">
                                    Commande
                                </span>

                                <strong>{{ commande.numero }}</strong>
                            </div>

                            {% if livraison %}

                                {% if livraison.statut == 'EN_ATTENTE' %}
                                    <span class="delivery-status status-waiting">
                                        <i class="bi bi-clock"></i>
                                        En attente
                                    </span>
                                {% elseif livraison.statut == 'EN_COURS' %}
                                    <span class="delivery-status status-progress">
                                        <i class="bi bi-truck"></i>
                                        En cours
                                    </span>
                                {% elseif livraison.statut == 'LIVREE' %}
                                    <span class="delivery-status status-delivered">
                                        <i class="bi bi-check-circle"></i>
                                        Livrée
                                    </span>
                                {% elseif livraison.statut == 'ANNULEE' %}
                                    <span class="delivery-status status-cancelled">
                                        <i class="bi bi-x-circle"></i>
                                        Annulée
                                    </span>
                                {% else %}
                                    <span class="delivery-status status-waiting">
                                        {{ livraison.statut }}
                                    </span>
                                {% endif %}

                            {% else %}

                                <span class="delivery-status status-to-organize">
                                    <i class="bi bi-exclamation-circle"></i>
                                    À organiser
                                </span>

                            {% endif %}

                        </div>

                        {# CONTENU #}

                        <div class="delivery-card-content">

                            {% if livraison %}

                                <div class="delivery-info-line">
                                    <div class="delivery-info-icon">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>

                                    <div>
                                        <span>Destination</span>
                                        <strong>
                                            {{ livraison.ville ?: 'Ville non renseignée' }}
                                        </strong>
                                    </div>
                                </div>

                                <div class="delivery-info-line">
                                    <div class="delivery-info-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    <div>
                                        <span>Mode de livraison</span>
                                        <strong>
                                            {% if livraison.modeLivraison == 'DOMICILE' %}
                                                Livraison à domicile
                                            {% elseif livraison.modeLivraison == 'POINT_RELAIS' %}
                                                Point relais
                                            {% elseif livraison.modeLivraison == 'RETRAIT' %}
                                                Retrait
                                            {% else %}
                                                {{ livraison.modeLivraison }}
                                            {% endif %}
                                        </strong>
                                    </div>
                                </div>

                                {% if livraison.dateLivraison %}
                                    <div class="delivery-info-line">
                                        <div class="delivery-info-icon">
                                            <i class="bi bi-calendar-check"></i>
                                        </div>

                                        <div>
                                            <span>Date de livraison</span>
                                            <strong>
                                                {{ livraison.dateLivraison|date('d/m/Y H:i') }}
                                            </strong>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if livraison.adresseLivraison %}
                                    <div class="delivery-info-line">
                                        <div class="delivery-info-icon">
                                            <i class="bi bi-house"></i>
                                        </div>

                                        <div>
                                            <span>Adresse</span>
                                            <strong>
                                                {{ livraison.adresseLivraison }}
                                            </strong>
                                        </div>
                                    </div>
                                {% endif %}

                            {% else %}

                                <div class="delivery-empty-content">
                                    <div class="delivery-empty-icon">
                                        <i class="bi bi-truck"></i>
                                    </div>

                                    <div>
                                        <h3>Livraison à organiser</h3>
                                        <p>
                                            Votre commande est confirmée.
                                            Consultez les possibilités
                                            de livraison disponibles.
                                        </p>
                                    </div>
                                </div>

                            {% endif %}

                        </div>

                        {# PIED #}

                        <div class="delivery-card-footer">

                            <div class="delivery-order-total">
                                <span>Total de la commande</span>
                                <strong>
                                    {{ commande.total|number_format(0, ',', ' ') }} Ar
                                </strong>
                            </div>

                            <div class="delivery-actions">

                                {% if not livraison
                                    and commande.statut == 'CONFIRMEE'
                                    and paiement
                                    and paiement.statut == 'PAYE'
                                %}

                                    <a
                                        href="{{ path('app_client_livraison_new', {
                                            id: commande.id
                                        }) }}"
                                        class="btn btn-primary"
                                    >
                                        <i class="bi bi-truck"></i>
                                        Organiser la livraison
                                    </a>

                                {% else %}

                                    <a
                                        href="{{ path('app_client_commande_confirmation', {
                                            id: commande.id
                                        }) }}"
                                        class="btn btn-outline-primary"
                                    >
                                        <i class="bi bi-eye"></i>
                                        Voir la commande
                                    </a>

                                {% endif %}

                            </div>

                        </div>

                    </div>

                {% endif %}

            {% endfor %}

            {% if not livraisonTrouvee %}

                <div class="delivery-dashboard-empty">

                    <div class="delivery-empty-big-icon">
                        <i class="bi bi-truck"></i>
                    </div>

                    <h3>Aucune livraison à afficher</h3>

                    <p>
                        Vos informations de livraison apparaîtront
                        ici lorsqu'une commande sera confirmée.
                    </p>

                    <a href="{{ path('app_client_commandes') }}"
                       class="btn btn-outline-primary">
                        <i class="bi bi-receipt"></i>
                        Consulter mes commandes
                    </a>

                </div>

            {% endif %}

        </div>

    </section>

    {# =====================================================
       ACCES RAPIDES
       ===================================================== #}

    <section class="quick-section">

        <div class="quick-heading">
            <h2>Comment pouvons-nous vous aider ?</h2>
            <p>
                Retrouvez rapidement les services de votre espace client.
            </p>
        </div>

        <div class="quick-actions">

            <a href="{{ path('app_client_produit_index') }}"
               class="quick-action">

                <div class="quick-action-icon">
                    <i class="bi bi-shop"></i>
                </div>

                <h3>Découvrir les produits</h3>

                <p>
                    Parcourez notre catalogue et découvrez les produits.
                </p>

            </a>

            <a href="{{ path('app_client_cart') }}"
               class="quick-action">

                <div class="quick-action-icon">
                    <i class="bi bi-cart3"></i>
                </div>

                <h3>Mon panier</h3>

                <p>
                    Vérifiez vos articles et consultez votre panier.
                </p>

            </a>

            <a href="{{ path('app_client_commandes') }}"
               class="quick-action">

                <div class="quick-action-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3>Mes commandes</h3>

                <p>
                    Retrouvez vos commandes et leur historique.
                </p>

            </a>

            <a href="{{ path('app_client_profile') }}"
               class="quick-action">

                <div class="quick-action-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <h3>Mon profil</h3>

                <p>
                    Gérez vos informations personnelles.
                </p>

            </a>

        </div>

    </section>

</div>

{% endblock %}
