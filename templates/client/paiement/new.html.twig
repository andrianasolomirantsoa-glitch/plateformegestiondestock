{% extends 'base.html.twig' %}

{% block title %}
    Paiement - {{ commande.numero }}
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>
            <h1 class="page-title">
                Paiement de la commande
            </h1>

            <p class="dashboard-subtitle">
                Déclarez le paiement de votre commande.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<div class="container py-4">

    <div class="mb-4">

        <a
            href="{{ path(
                'app_client_commande_confirmation',
                {'id': commande.id}
            ) }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Retour à la commande
        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <i
                            class="bi bi-credit-card text-primary"
                            style="font-size: 60px;"
                        ></i>

                        <h2 class="mt-3">
                            Déclarer votre paiement
                        </h2>

                        <p class="text-muted">
                            Commande {{ commande.numero }}
                        </p>

                    </div>

                    <div class="alert alert-primary">

                        <div class="d-flex justify-content-between">

                            <span>
                                Montant à payer
                            </span>

                            <strong class="fs-4">
                                {{ commande.total|number_format(2, ',', ' ') }}
                                Ar
                            </strong>

                        </div>

                    </div>

                    <form
                        method="post"
                    >

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('paiement_' ~ commande.id) }}"
                        >

                        <div class="mb-4">

                            <label
                                for="mode"
                                class="form-label"
                            >
                                Mode de paiement
                            </label>

                            <select
                                name="mode"
                                id="mode"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    -- Sélectionnez un mode --
                                </option>

                                <option value="ESPECES">
                                    Espèces
                                </option>

                                <option value="MOBILE_MONEY">
                                    Mobile Money
                                </option>

                                <option value="VIREMENT">
                                    Virement bancaire
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label
                                for="reference"
                                class="form-label"
                            >
                                Référence du paiement
                                <span class="text-muted">
                                    (facultatif)
                                </span>
                            </label>

                            <input
                                type="text"
                                name="reference"
                                id="reference"
                                class="form-control"
                                maxlength="100"
                                placeholder="Exemple : numéro de transaction"
                            >

                            <small class="text-muted">
                                Pour Mobile Money ou virement,
                                vous pouvez renseigner le numéro de transaction.
                            </small>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-success btn-lg w-100"
                        >
                            <i class="bi bi-check-circle"></i>
                            Déclarer le paiement
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}

