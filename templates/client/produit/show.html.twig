{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} | Jumbo Score Madagascar{% endblock %}

{% block body %}

<style>
.client-product-detail {
    --jumbo-navy: #17213e;
    --jumbo-red: #ed1c24;
    --jumbo-yellow: #ffc900;
    --jumbo-text: #202b42;
    --jumbo-muted: #788196;
    --jumbo-border: #e8ebf1;
    --jumbo-bg: #f6f7fa;

    max-width: 1500px;
    margin: 0 auto;
    padding-bottom: 30px;
    color: var(--jumbo-text);
}

.client-product-detail *,
.client-product-detail *::before,
.client-product-detail *::after {
    box-sizing: border-box;
}

.client-product-detail a {
    text-decoration: none;
}

/* Bandeau supérieur */

.product-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 18px;
    margin-bottom: 20px;
    border-radius: 8px;
    background: var(--jumbo-navy);
    color: white;
    font-size: 11px;
}

.product-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: white;
    font-weight: 850;
}

.product-brand-logo {
    width: 43px;
    height: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    border-radius: 8px;
    background: white;
}

.product-brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 3px;
}

.product-brand-logo i {
    color: var(--jumbo-red);
    font-size: 24px;
}

.product-brand small {
    display: block;
    margin-top: 4px;
    color: #cbd2e0;
    font-size: 9px;
    font-weight: 500;
}

.product-topbar-link {
    color: white;
    font-weight: 750;
}

.product-topbar-link:hover {
    color: var(--jumbo-yellow);
}

/* Fil d'Ariane */

.product-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
    color: var(--jumbo-muted);
    font-size: 11px;
}

.product-breadcrumb a {
    color: var(--jumbo-navy);
    font-weight: 750;
}

.product-breadcrumb a:hover {
    color: var(--jumbo-red);
}

/* Carte principale */

.product-detail-card {
    overflow: hidden;
    border: 1px solid var(--jumbo-border);
    border-radius: 16px;
    background: white;
    box-shadow: 0 6px 24px rgba(23,33,62,.055);
}

.product-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 510px;
}

/* Visuel du produit */

.product-detail-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 510px;
    padding: 40px;
    overflow: hidden;
    background:
        radial-gradient(circle at 50% 40%, #fff 0%, #f9fafc 63%),
        #f5f6f9;
    border-right: 1px solid #f0f1f4;
}

.product-detail-visual::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -115px;
    bottom: -135px;
    border: 35px solid rgba(237,28,36,.055);
    border-radius: 50%;
    pointer-events: none;
}

.product-visual-box {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 410px);
    height: 390px;
    padding: 20px;
    overflow: hidden;
    border: 1px solid #f0f1f4;
    border-radius: 16px;
    background: white;
    box-shadow: 0 15px 38px rgba(23,33,62,.075);
}

.product-real-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform .3s ease;
}

.product-visual-box:hover .product-real-image {
    transform: scale(1.04);
}

.product-visual-placeholder {
    width: 115px;
    height: 115px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 25px;
    background: #fff0f0;
    color: var(--jumbo-red);
}

.product-visual-placeholder i {
    font-size: 55px;
}

.product-stock-badge {
    position: absolute;
    z-index: 2;
    top: 20px;
    left: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 11px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 900;
}

.stock-available {
    background: #e8f7ee;
    color: #168044;
}

.stock-low {
    background: #fff3d6;
    color: #a55a00;
}

.stock-empty {
    background: #ffe8e8;
    color: #c51c24;
}

.product-image-reference {
    position: absolute;
    z-index: 2;
    left: 20px;
    bottom: 18px;
    padding: 8px 11px;
    border: 1px solid #e7eaf0;
    border-radius: 6px;
    background: rgba(255,255,255,.95);
    color: #687286;
    font-size: 10px;
    font-weight: 800;
}

/* Informations produit */

.product-detail-info {
    display: flex;
    flex-direction: column;
    padding: 38px;
}

.product-category-label {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    padding: 7px 10px;
    margin-bottom: 15px;
    border-radius: 5px;
    background: #fff0f0;
    color: var(--jumbo-red);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.product-detail-info h1 {
    margin: 0;
    color: var(--jumbo-navy);
    font-size: clamp(25px, 3vw, 35px);
    font-weight: 900;
    line-height: 1.25;
    overflow-wrap: anywhere;
}

.product-reference {
    margin-top: 10px;
    color: #8992a3;
    font-size: 11px;
}

.product-reference strong {
    color: #5c667a;
}

.product-price-block {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 25px;
}

.product-detail-price {
    color: var(--jumbo-red);
    font-size: clamp(27px, 3vw, 35px);
    font-weight: 950;
    line-height: 1.2;
}

.product-detail-unit {
    color: var(--jumbo-muted);
    font-size: 12px;
}

.product-description {
    padding-top: 21px;
    margin-top: 22px;
    border-top: 1px solid #edf0f5;
}

.product-description-title {
    margin-bottom: 9px;
    color: var(--jumbo-navy);
    font-size: 13px;
    font-weight: 900;
}

.product-description-text {
    color: #737e91;
    font-size: 12px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

/* Informations de stock */

.product-stock-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
    margin-top: 22px;
}

.stock-info-item {
    padding: 14px;
    border: 1px solid #e9ecf2;
    border-radius: 9px;
    background: #f8f9fb;
}

.stock-info-label {
    display: block;
    color: #8791a3;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.stock-info-value {
    display: block;
    margin-top: 7px;
    color: var(--jumbo-navy);
    font-size: 13px;
    font-weight: 900;
    overflow-wrap: anywhere;
}

/* Ajout au panier */

.add-cart-section {
    margin-top: auto;
    padding-top: 25px;
}

.quantity-label {
    display: block;
    margin-bottom: 8px;
    color: var(--jumbo-navy);
    font-size: 11px;
    font-weight: 850;
}

.quantity-control {
    display: flex;
    width: 100%;
    height: 44px;
    margin-bottom: 12px;
}

.quantity-button {
    width: 45px;
    flex-shrink: 0;
    border: 1px solid #dfe4ec;
    background: #f8fafc;
    color: var(--jumbo-navy);
    font-size: 19px;
    font-weight: 800;
    cursor: pointer;
    transition: .2s;
}

.quantity-button:first-child {
    border-radius: 8px 0 0 8px;
}

.quantity-button:last-child {
    border-radius: 0 8px 8px 0;
}

.quantity-button:hover:not(:disabled) {
    background: #fff0f0;
    color: var(--jumbo-red);
}

.quantity-button:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.quantity-input {
    flex: 1;
    min-width: 0;
    border: 1px solid #dfe4ec;
    border-right: 0;
    border-left: 0;
    background: white;
    color: var(--jumbo-navy);
    text-align: center;
    font-size: 14px;
    font-weight: 850;
    outline: none;
}

.quantity-input:focus {
    background: #fffafa;
}

.add-cart-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border: 0;
    border-radius: 8px;
    background: var(--jumbo-red);
    color: white;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
    transition: .2s ease;
}

.add-cart-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: green;
    box-shadow: 0 6px 15px rgba(237,28,36,.18);
}

.add-cart-button:disabled {
    background: #eceef2;
    color: #929aaa;
    cursor: not-allowed;
}

.stock-message {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: 11px;
    color: #818b9d;
    font-size: 10px;
    line-height: 1.6;
}

.stock-message i {
    color: var(--jumbo-red);
}

/* Bandeau inférieur */

.product-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 19px;
}

.product-benefit {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 17px;
    border: 1px solid var(--jumbo-border);
    border-radius: 11px;
    background: white;
    box-shadow: 0 3px 12px rgba(23,33,62,.025);
}

.product-benefit-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 9px;
    background: #fff0f0;
    color: var(--jumbo-red);
    font-size: 17px;
}

.product-benefit strong {
    display: block;
    color: var(--jumbo-navy);
    font-size: 11px;
    font-weight: 900;
}

.product-benefit span {
    display: block;
    margin-top: 4px;
    color: #8791a3;
    font-size: 10px;
    line-height: 1.5;
}

/* Retour catalogue */

.product-back-bottom {
    display: flex;
    justify-content: center;
    margin-top: 22px;
}

.product-back-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 17px;
    border: 1px solid #e0e4eb;
    border-radius: 8px;
    background: white;
    color: var(--jumbo-navy);
    font-size: 11px;
    font-weight: 850;
    transition: .2s;
}

.product-back-button:hover {
    border-color: var(--jumbo-red);
    color: var(--jumbo-red);
}

/* Responsive */

@media (max-width: 1000px) {
    .product-detail-grid {
        grid-template-columns: 1fr;
    }

    .product-detail-visual {
        min-height: 390px;
        border-right: 0;
        border-bottom: 1px solid #f0f1f4;
    }

    .product-visual-box {
        width: min(100%, 370px);
        height: 330px;
    }

    .product-benefits {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .product-topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-detail-visual {
        min-height: 300px;
        padding: 22px;
    }

    .product-visual-box {
        height: 245px;
        padding: 12px;
    }

    .product-stock-badge {
        top: 12px;
        left: 12px;
        font-size: 9px;
    }

    .product-image-reference {
        left: 12px;
        bottom: 12px;
    }

    .product-detail-info {
        padding: 25px 20px;
    }

    .product-stock-info {
        grid-template-columns: 1fr;
    }

    .product-detail-info h1 {
        font-size: 25px;
    }

    .product-detail-price {
        font-size: 28px;
    }

    .product-benefit {
        padding: 14px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .client-product-detail *,
    .client-product-detail *::before,
    .client-product-detail *::after {
        transition: none !important;
    }
}
</style>

<div class="client-product-detail">

    {# Bandeau Jumbo Score : remplace le chemin du logo si nécessaire #}
    <div class="product-topbar">
        <div class="product-brand">
            <div class="product-brand-logo">
                {# Place ton logo dans public/images/jumbo-score-logo.png #}
                <img
                    src="{{ asset('images/jumbo-score-logo.png') }}"
                    alt="Logo Jumbo Score"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
                >
                <i class="bi bi-shop" style="display:none" aria-hidden="true"></i>
            </div>

            <div>
                Jumbo Score Madagascar
                <small>Votre catalogue de produits</small>
            </div>
        </div>

        <a href="{{ path('app_client_cart') }}" class="product-topbar-link">
            <i class="bi bi-cart3"></i>
            Mon panier
            {% if panierQuantity is defined and panierQuantity > 0 %}
                ({{ panierQuantity }})
            {% endif %}
        </a>
    </div>

    {# Fil d'Ariane #}
    <nav class="product-breadcrumb" aria-label="Fil d’Ariane">
        <a href="{{ path('app_client_produit_index') }}">
            <i class="bi bi-house"></i>
            Catalogue
        </a>
        <i class="bi bi-chevron-right"></i>
        {% if produit.categorie %}
            <span>{{ produit.categorie.nom }}</span>
            <i class="bi bi-chevron-right"></i>
        {% endif %}
        <span>{{ produit.nom }}</span>
    </nav>

    {# Détail du produit #}
    <section class="product-detail-card">
        <div class="product-detail-grid">

            {# Image #}
            <div class="product-detail-visual">

                {% if produit.quantiteStock <= 0 %}
                    <span class="product-stock-badge stock-empty">
                        <i class="bi bi-x-circle-fill"></i>
                        Rupture de stock
                    </span>
                {% elseif produit.quantiteStock <= produit.seuilAlerte %}
                    <span class="product-stock-badge stock-low">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Stock limité
                    </span>
                {% else %}
                    <span class="product-stock-badge stock-available">
                        <i class="bi bi-check-circle-fill"></i>
                        Disponible
                    </span>
                {% endif %}

                <div class="product-visual-box">
                    {% if produit.image %}
                        <img
                            src="{{ asset('images/produits/' ~ produit.image) }}"
                            alt="{{ produit.nom }}"
                            class="product-real-image"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        >
                        <div class="product-visual-placeholder" style="display:none">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    {% else %}
                        <div class="product-visual-placeholder">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    {% endif %}
                </div>

                <div class="product-image-reference">
                    <i class="bi bi-upc-scan"></i>
                    Réf. {{ produit.reference|default('Non renseignée') }}
                </div>
            </div>

            {# Informations #}
            <div class="product-detail-info">

                {% if produit.categorie %}
                    <div class="product-category-label">
                        <i class="bi bi-tag-fill"></i>
                        {{ produit.categorie.nom }}
                    </div>
                {% endif %}

                <h1>{{ produit.nom }}</h1>

                <div class="product-reference">
                    Référence produit :
                    <strong>{{ produit.reference|default('Non renseignée') }}</strong>
                </div>

                <div class="product-price-block">
                    <span class="product-detail-price">
                        {{ produit.prixVente|number_format(0, ',', ' ') }} Ar
                    </span>
                    <span class="product-detail-unit">
                        / {{ produit.unite|default('unité') }}
                    </span>
                </div>

                <div class="product-description">
                    <div class="product-description-title">
                        <i class="bi bi-info-circle"></i>
                        À propos de ce produit
                    </div>

                    <div class="product-description-text">
                        {% if produit.description %}
                            {{ produit.description }}
                        {% else %}
                            Aucune description détaillée n'est disponible
                            pour ce produit pour le moment.
                        {% endif %}
                    </div>
                </div>

                <div class="product-stock-info">
                    <div class="stock-info-item">
                        <span class="stock-info-label">Disponibilité</span>
                        <span class="stock-info-value">
                            {% if produit.quantiteStock <= 0 %}
                                Indisponible
                            {% elseif produit.quantiteStock <= produit.seuilAlerte %}
                                Stock limité
                            {% else %}
                                En stock
                            {% endif %}
                        </span>
                    </div>

                    <div class="stock-info-item">
                        <span class="stock-info-label">Quantité disponible</span>
                        <span class="stock-info-value">
                            {{ produit.quantiteStock }}
                            {{ produit.unite|default('unité') }}(s)
                        </span>
                    </div>
                </div>

                {# Formulaire d'ajout au panier #}
                <div class="add-cart-section">
                    {% if produit.quantiteStock > 0 %}
                        <form
                            method="post"
                            action="{{ path('app_client_cart_add', {id: produit.id}) }}"
                            id="addToCartForm"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('ajouter_panier') }}"
                            >

                            <label for="quantity" class="quantity-label">
                                <i class="bi bi-basket"></i>
                                Choisissez la quantité
                            </label>

                            <div class="quantity-control">
                                <button
                                    type="button"
                                    class="quantity-button"
                                    id="decreaseQuantity"
                                    aria-label="Diminuer la quantité"
                                >−</button>

                                <input
                                    type="number"
                                    id="quantity"
                                    name="quantite"
                                    class="quantity-input"
                                    value="1"
                                    min="1"
                                    max="{{ produit.quantiteStock }}"
                                    required
                                >

                                <button
                                    type="button"
                                    class="quantity-button"
                                    id="increaseQuantity"
                                    aria-label="Augmenter la quantité"
                                >+</button>
                            </div>

                            <button type="submit" class="add-cart-button">
                                <i class="bi bi-cart-plus-fill"></i>
                                Ajouter au panier
                            </button>

                            <div class="stock-message">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>
                                    {{ produit.quantiteStock }}
                                    unité(s) actuellement disponible(s).
                                </span>
                            </div>
                        </form>
                    {% else %}
                        <button type="button" class="add-cart-button" disabled>
                            <i class="bi bi-cart-x-fill"></i>
                            Produit indisponible
                        </button>

                        <div class="stock-message">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>
                                Ce produit pourra être commandé après
                                le réapprovisionnement du stock.
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {# Avantages #}
    <section class="product-benefits" aria-label="Informations de service">
        <div class="product-benefit">
            <div class="product-benefit-icon">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <strong>Stock actualisé</strong>
                <span>Disponibilité affichée selon les données du système.</span>
            </div>
        </div>

        <div class="product-benefit">
            <div class="product-benefit-icon">
                <i class="bi bi-cart-check"></i>
            </div>
            <div>
                <strong>Panier pratique</strong>
                <span>Choisissez la quantité avant d'ajouter le produit.</span>
            </div>
        </div>

        <div class="product-benefit">
            <div class="product-benefit-icon">
                <i class="bi bi-truck"></i>
            </div>
            <div>
                <strong>Suivi de commande</strong>
                <span>Retrouvez les informations depuis votre espace client.</span>
            </div>
        </div>
    </section>

    <div class="product-back-bottom">
        <a href="{{ path('app_client_produit_index') }}" class="product-back-button">
            <i class="bi bi-arrow-left"></i>
            Retour au catalogue
        </a>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const quantityInput = document.getElementById('quantity');
    const decreaseButton = document.getElementById('decreaseQuantity');
    const increaseButton = document.getElementById('increaseQuantity');

    if (!quantityInput || !decreaseButton || !increaseButton) {
        return;
    }

    const min = Number(quantityInput.min) || 1;
    const max = Number(quantityInput.max) || 1;

    function normalizeQuantity() {
        let value = Number.parseInt(quantityInput.value, 10);

        if (!Number.isFinite(value)) {
            value = min;
        }

        value = Math.max(min, Math.min(max, value));
        quantityInput.value = value;

        decreaseButton.disabled = value <= min;
        increaseButton.disabled = value >= max;
    }

    decreaseButton.addEventListener('click', function () {
        quantityInput.value = (Number.parseInt(quantityInput.value, 10) || min) - 1;
        normalizeQuantity();
    });

    increaseButton.addEventListener('click', function () {
        quantityInput.value = (Number.parseInt(quantityInput.value, 10) || min) + 1;
        normalizeQuantity();
    });

    quantityInput.addEventListener('input', normalizeQuantity);
    quantityInput.addEventListener('change', normalizeQuantity);
    quantityInput.addEventListener('blur', normalizeQuantity);

    normalizeQuantity();
});
</script>

{% endblock %}
