{% extends 'base.html.twig' %}

{% block title %}Mes commandes - Jumbo Score{% endblock %}

{% block body %}

<style>
    :root {
        --jumbo-navy: #17213e;
        --jumbo-navy-light: #26365b;
        --jumbo-red: #ed1c24;
        --jumbo-yellow: #ffc900;
        --orders-text: #202b42;
        --orders-muted: #788196;
        --orders-border: #e8ebf1;
        --orders-bg: #f6f7fa;
    }

    .client-orders-page {
        max-width: 1450px;
        margin: 0 auto;
        padding-bottom: 30px;
        color: var(--orders-text);
    }

    /* BANDEAU JUMBO SCORE */
    .jumbo-orders-brand {
        position: relative;
        display: flex;
        align-items: center;
        gap: 20px;
        min-height: 125px;
        padding: 22px 26px;
        margin-bottom: 27px;
        overflow: hidden;
        background: linear-gradient(115deg, var(--jumbo-navy), var(--jumbo-navy-light));
        border: 1px solid rgba(255, 201, 0, .45);
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(23, 33, 62, .12);
    }

    .jumbo-orders-brand::before {
        content: "";
        position: absolute;
        right: -45px;
        top: -85px;
        width: 230px;
        height: 230px;
        border: 25px solid rgba(255, 201, 0, .09);
        border-radius: 50%;
        pointer-events: none;
    }

    .jumbo-orders-logo {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 110px;
        height: 82px;
        padding: 8px;
        background: #fff;
        border-bottom: 4px solid var(--jumbo-yellow);
        border-radius: 12px;
    }

    .jumbo-orders-logo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .jumbo-orders-brand-text {
        position: relative;
        z-index: 1;
        flex: 1;
        min-width: 0;
    }

    .jumbo-orders-eyebrow {
        display: block;
        margin-bottom: 6px;
        color: var(--jumbo-yellow);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .15em;
    }

    .jumbo-orders-brand-text strong {
        display: block;
        color: #fff;
        font-size: 23px;
        font-weight: 900;
    }

    .jumbo-orders-brand-text p {
        margin: 6px 0 0;
        color: #d9e1f0;
        font-size: 11px;
    }

    .jumbo-orders-brand-badge {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 10px 13px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 10px;
        background: rgba(255,255,255,.08);
        color: #fff;
        font-size: 10px;
        font-weight: 800;
    }

    .jumbo-orders-brand-badge i {
        color: var(--jumbo-yellow);
        font-size: 15px;
    }

    /* HEADER */
    .orders-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 23px;
    }

    .orders-header small {
        display: block;
        margin-bottom: 5px;
        color: var(--orders-muted);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .orders-header h1 {
        margin: 0;
        color: var(--jumbo-navy);
        font-size: 29px;
        font-weight: 900;
    }

    .orders-header p {
        margin: 7px 0 0;
        color: var(--orders-muted);
        font-size: 12px;
    }

    .new-order-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 14px;
        border: 1px solid var(--jumbo-red);
        border-radius: 10px;
        background: var(--jumbo-red);
        color: #fff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: .2s ease;
    }

    .new-order-button:hover {
        background: #c9151c;
        border-color: #c9151c;
        color: #fff;
        transform: translateY(-1px);
    }

    /* STATISTIQUES */
    .orders-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 21px;
    }

    .order-stat {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 17px;
        background: #fff;
        border: 1px solid var(--orders-border);
        border-radius: 14px;
        box-shadow: 0 2px 11px rgba(15,23,42,.04);
        transition: .2s ease;
    }

    .order-stat:hover {
        border-color: rgba(237, 28, 36, .3);
        transform: translateY(-2px);
    }

    .order-stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border: 1px solid #ffe58a;
        border-radius: 11px;
        background: #fff7d6;
        color: var(--jumbo-navy);
        font-size: 17px;
    }

    .order-stat-value {
        color: var(--jumbo-navy);
        font-size: 21px;
        font-weight: 900;
    }

    .order-stat-label {
        margin-top: 3px;
        color: #8892a4;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    /* RECHERCHE ET FILTRE */
    .orders-toolbar {
        display: grid;
        grid-template-columns: minmax(250px, 1fr) 200px;
        gap: 12px;
        padding: 14px;
        margin-bottom: 20px;
        background: #fff;
        border: 1px solid var(--orders-border);
        border-radius: 14px;
        box-shadow: 0 2px 11px rgba(15,23,42,.04);
    }

    .search-container {
        position: relative;
    }

    .search-container i {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #8d97a8;
        font-size: 14px;
    }

    .orders-search,
    .orders-filter {
        box-sizing: border-box;
        width: 100%;
        height: 42px;
        border: 1px solid #e0e5ec;
        border-radius: 9px;
        background: #f9fafc;
        color: #344054;
        font-size: 11px;
        outline: none;
        transition: .2s ease;
    }

    .orders-search {
        padding: 0 13px 0 37px;
    }

    .orders-filter {
        padding: 0 12px;
    }

    .orders-search:focus,
    .orders-filter:focus {
        border-color: var(--jumbo-yellow);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(255,201,0,.15);
    }

    /* LISTE DES COMMANDES */
    .orders-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .order-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--orders-border);
        border-radius: 16px;
        box-shadow: 0 3px 14px rgba(15,23,42,.045);
        transition: .2s ease;
    }

    .order-card:hover {
        border-color: rgba(237, 28, 36, .3);
        box-shadow: 0 7px 23px rgba(15,23,42,.07);
    }

    .order-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
        border-top: 3px solid var(--jumbo-yellow);
    }

    .order-card-number {
        color: var(--jumbo-navy);
        font-size: 14px;
        font-weight: 900;
    }

    .order-card-date {
        margin-top: 5px;
        color: #8a94a6;
        font-size: 9px;
    }

    /* STATUTS */
    .main-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 850;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-confirmed {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-cancelled {
        background: #fef2f2;
        color: #b91c1c;
    }

    .status-default {
        background: #f3f4f6;
        color: #475467;
    }

    /* INFORMATIONS COMMANDE */
    .order-card-body {
        padding: 18px 20px;
    }

    .order-info-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr 1fr;
        gap: 16px;
    }

    .order-info-label {
        display: block;
        margin-bottom: 7px;
        color: #929bab;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .order-info-value {
        color: #344054;
        font-size: 11px;
        font-weight: 800;
    }

    .order-total-client {
        color: var(--jumbo-navy);
        font-size: 16px;
        font-weight: 900;
    }

    /* BADGES PAIEMENT ET LIVRAISON */
    .client-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 850;
    }

    .client-status-success {
        background: #ecfdf3;
        color: #15803d;
    }

    .client-status-warning {
        background: #fff7ed;
        color: #c2410c;
    }

    .client-status-danger {
        background: #fef2f2;
        color: #b91c1c;
    }

    .client-status-info {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .client-status-neutral {
        background: #f3f4f6;
        color: #667085;
    }

    /* PROGRESSION */
    .order-progress {
        margin-top: 19px;
    }

    .progress-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 7px;
    }

    .progress-top span {
        color: #8791a3;
        font-size: 9px;
        font-weight: 700;
    }

    .progress-line {
        width: 100%;
        height: 7px;
        background: #eef1f5;
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: inherit;
        background: var(--jumbo-red);
        transition: width .3s ease;
    }

    .progress-fill.cancelled {
        background: #dc2626;
    }

    /* ACTIONS */
    .order-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 20px;
        background: #fafbfd;
        border-top: 1px solid #edf0f5;
    }

    .order-footer-message {
        color: #8a94a6;
        font-size: 9px;
    }

    .order-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .order-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 11px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        transition: .2s ease;
    }

    .order-action-primary {
        background: var(--jumbo-navy);
        color: #fff;
    }

    .order-action-primary:hover {
        background: var(--jumbo-navy-light);
        color: #fff;
    }

    .order-action-success {
        background: #fff5c2;
        color: var(--jumbo-navy);
        border: 1px solid #ffe17a;
    }

    .order-action-success:hover {
        background: var(--jumbo-yellow);
        color: var(--jumbo-navy);
    }

    .order-action-secondary {
        background: #eff4ff;
        color: #2563eb;
    }

    .order-action-secondary:hover {
        background: #e1ebff;
        color: #1d4ed8;
    }

    /* AUCUNE COMMANDE / AUCUN RÉSULTAT */
    .orders-empty {
        display: none;
        padding: 65px 25px;
        background: #fff;
        border: 1px solid var(--orders-border);
        border-radius: 16px;
        text-align: center;
    }

    .orders-empty i {
        display: block;
        margin-bottom: 12px;
        color: #a5aebb;
        font-size: 38px;
    }

    .orders-empty strong {
        display: block;
        color: var(--jumbo-navy);
        font-size: 16px;
        font-weight: 850;
    }

    .orders-empty span {
        display: block;
        margin-top: 6px;
        color: #8a94a6;
        font-size: 10px;
    }

    .orders-empty a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 17px;
        padding: 10px 14px;
        border-radius: 9px;
        background: var(--jumbo-red);
        color: #fff;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
    }

    .orders-empty a:hover {
        background: #c9151c;
        color: #fff;
    }

    /* RESPONSIVE */
    @media (max-width: 1100px) {
        .orders-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .order-info-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 800px) {
        .jumbo-orders-brand {
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 14px;
            padding: 18px;
        }

        .jumbo-orders-logo {
            width: 78px;
            height: 65px;
        }

        .jumbo-orders-brand-text {
            flex-basis: calc(100% - 100px);
        }

        .jumbo-orders-brand-text strong {
            font-size: 18px;
        }

        .jumbo-orders-brand-badge {
            margin-left: 0;
        }

        .orders-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .new-order-button {
            width: 100%;
            box-sizing: border-box;
        }

        .orders-toolbar {
            grid-template-columns: 1fr;
        }

        .order-card-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 600px) {
        .orders-stats {
            grid-template-columns: 1fr;
        }

        .order-info-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 12px;
        }

        .order-card-header,
        .order-card-body,
        .order-card-footer {
            padding-left: 14px;
            padding-right: 14px;
        }

        .order-card-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .order-actions {
            width: 100%;
        }

        .order-action-button {
            flex: 1;
        }

        .progress-top {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 360px) {
        .order-info-grid {
            grid-template-columns: 1fr;
        }

        .jumbo-orders-brand-text strong {
            font-size: 16px;
        }
    }
</style>

<div class="client-orders-page">

    {# BANDEAU JUMBO SCORE #}
    <div class="jumbo-orders-brand">
        <div class="jumbo-orders-logo">
            <img
                src="{{ asset('images/jumbo-score-logo.png') }}"
                alt="Logo Jumbo Score Madagascar"
            >
        </div>

        <div class="jumbo-orders-brand-text">
            <span class="jumbo-orders-eyebrow">JUMBO SCORE MADAGASCAR</span>
            <strong>Votre espace commandes</strong>
            <p>Retrouvez vos achats et suivez leur évolution en toute simplicité.</p>
        </div>

        <div class="jumbo-orders-brand-badge">
            <i class="bi bi-bag-check"></i>
            Espace client
        </div>
    </div>

    {# HEADER #}
    <div class="orders-header">
        <div>
            <small>Espace client</small>
            <h1>Mes commandes</h1>
            <p>Retrouvez l'historique et suivez l'état de vos commandes.</p>
        </div>

        <a href="{{ path('app_client_produit_index') }}" class="new-order-button">
            <i class="bi bi-plus-circle"></i>
            Nouvelle commande
        </a>
    </div>

    {# CALCUL DES STATISTIQUES #}
    {% set totalCommandes = commandes|length %}
    {% set totalAttente = 0 %}
    {% set totalConfirmees = 0 %}
    {% set totalAnnulees = 0 %}

    {% for commande in commandes %}
        {% if commande.statut == 'EN_ATTENTE' %}
            {% set totalAttente = totalAttente + 1 %}
        {% endif %}

        {% if commande.statut == 'CONFIRMEE' %}
            {% set totalConfirmees = totalConfirmees + 1 %}
        {% endif %}

        {% if commande.statut == 'ANNULEE' %}
            {% set totalAnnulees = totalAnnulees + 1 %}
        {% endif %}
    {% endfor %}

    {# STATISTIQUES #}
    <section class="orders-stats">
        <div class="order-stat">
            <div class="order-stat-icon"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="order-stat-value">{{ totalCommandes }}</div>
                <div class="order-stat-label">Toutes les commandes</div>
            </div>
        </div>

        <div class="order-stat">
            <div class="order-stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="order-stat-value">{{ totalAttente }}</div>
                <div class="order-stat-label">En attente</div>
            </div>
        </div>

        <div class="order-stat">
            <div class="order-stat-icon"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="order-stat-value">{{ totalConfirmees }}</div>
                <div class="order-stat-label">Confirmées</div>
            </div>
        </div>

        <div class="order-stat">
            <div class="order-stat-icon"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="order-stat-value">{{ totalAnnulees }}</div>
                <div class="order-stat-label">Annulées</div>
            </div>
        </div>
    </section>

    {# RECHERCHE ET FILTRE #}
    <div class="orders-toolbar">
        <div class="search-container">
            <i class="bi bi-search"></i>
            <input
                type="text"
                id="orderSearch"
                class="orders-search"
                placeholder="Rechercher par numéro de commande..."
                autocomplete="off"
            >
        </div>

        <select id="orderFilter" class="orders-filter">
            <option value="">Tous les statuts</option>
            <option value="EN_ATTENTE">En attente</option>
            <option value="CONFIRMEE">Confirmée</option>
            <option value="ANNULEE">Annulée</option>
        </select>
    </div>

    {# LISTE DES COMMANDES #}
    {% if commandes is not empty %}

        <div class="orders-list" id="ordersList">

            {% for commande in commandes %}

                {% set paiement = paiements[commande.id] ?? null %}
                {% set livraison = livraisons[commande.id] ?? null %}

                {# PROGRESSION #}
                {% if commande.statut == 'EN_ATTENTE' %}
                    {% set progress = 25 %}
                {% elseif commande.statut == 'CONFIRMEE' %}
                    {% if livraison and livraison.statut == 'LIVREE' %}
                        {% set progress = 100 %}
                    {% elseif livraison and livraison.statut == 'EN_COURS' %}
                        {% set progress = 80 %}
                    {% elseif paiement and paiement.statut == 'PAYE' %}
                        {% set progress = 65 %}
                    {% else %}
                        {% set progress = 50 %}
                    {% endif %}
                {% elseif commande.statut == 'ANNULEE' %}
                    {% set progress = 100 %}
                {% else %}
                    {% set progress = 35 %}
                {% endif %}

                <article
                    class="order-card"
                    data-number="{{ commande.numero|lower }}"
                    data-status="{{ commande.statut }}"
                >
                    {# HEADER COMMANDE #}
                    <div class="order-card-header">
                        <div>
                            <div class="order-card-number">
                                <i class="bi bi-receipt me-1"></i>
                                {{ commande.numero }}
                            </div>

                            <div class="order-card-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                {{ commande.createdAt|date('d/m/Y à H:i') }}
                            </div>
                        </div>

                        <div>
                            {% if commande.statut == 'EN_ATTENTE' %}
                                <span class="main-status status-pending">
                                    <i class="bi bi-hourglass-split"></i>
                                    En attente
                                </span>
                            {% elseif commande.statut == 'CONFIRMEE' %}
                                <span class="main-status status-confirmed">
                                    <i class="bi bi-check-circle"></i>
                                    Confirmée
                                </span>
                            {% elseif commande.statut == 'ANNULEE' %}
                                <span class="main-status status-cancelled">
                                    <i class="bi bi-x-circle"></i>
                                    Annulée
                                </span>
                            {% else %}
                                <span class="main-status status-default">
                                    {{ commande.statut }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    {# CORPS DE LA COMMANDE #}
                    <div class="order-card-body">
                        <div class="order-info-grid">

                            <div>
                                <span class="order-info-label">Montant total</span>
                                <div class="order-total-client">
                                    {{ commande.total|number_format(0, ',', ' ') }} Ar
                                </div>
                            </div>

                            <div>
                                <span class="order-info-label">Paiement</span>

                                {% if paiement %}
                                    {% if paiement.statut == 'PAYE' %}
                                        <span class="client-status client-status-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Payé
                                        </span>
                                    {% elseif paiement.statut == 'EN_ATTENTE' %}
                                        <span class="client-status client-status-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            En attente
                                        </span>
                                    {% elseif paiement.statut == 'REFUSE' %}
                                        <span class="client-status client-status-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Refusé
                                        </span>
                                    {% else %}
                                        <span class="client-status client-status-neutral">
                                            {{ paiement.statut }}
                                        </span>
                                    {% endif %}
                                {% else %}
                                    <span class="client-status client-status-neutral">
                                        Non effectué
                                    </span>
                                {% endif %}
                            </div>

                            <div>
                                <span class="order-info-label">Livraison</span>

                                {% if livraison %}
                                    {% if livraison.statut == 'LIVREE' %}
                                        <span class="client-status client-status-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Livrée
                                        </span>
                                    {% elseif livraison.statut == 'EN_COURS' %}
                                        <span class="client-status client-status-info">
                                            <i class="bi bi-truck me-1"></i>
                                            En cours
                                        </span>
                                    {% elseif livraison.statut == 'EN_ATTENTE' %}
                                        <span class="client-status client-status-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            En attente
                                        </span>
                                    {% elseif livraison.statut == 'ANNULEE' %}
                                        <span class="client-status client-status-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Annulée
                                        </span>
                                    {% else %}
                                        <span class="client-status client-status-neutral">
                                            {{ livraison.statut }}
                                        </span>
                                    {% endif %}
                                {% else %}
                                    <span class="client-status client-status-neutral">
                                        Non configurée
                                    </span>
                                {% endif %}
                            </div>

                            <div>
                                <span class="order-info-label">Date</span>
                                <span class="order-info-value">
                                    {{ commande.createdAt|date('d/m/Y') }}
                                </span>
                            </div>

                        </div>

                        {# PROGRESSION #}
                        <div class="order-progress">
                            <div class="progress-top">
                                <span>Progression de la commande</span>

                                {% if commande.statut == 'ANNULEE' %}
                                    <span>Commande annulée</span>
                                {% elseif livraison and livraison.statut == 'LIVREE' %}
                                    <span>Commande terminée</span>
                                {% elseif livraison and livraison.statut == 'EN_COURS' %}
                                    <span>Livraison en cours</span>
                                {% elseif paiement and paiement.statut == 'PAYE' %}
                                    <span>Paiement validé</span>
                                {% elseif commande.statut == 'CONFIRMEE' %}
                                    <span>Commande confirmée</span>
                                {% else %}
                                    <span>En attente de validation</span>
                                {% endif %}
                            </div>

                            <div class="progress-line">
                                <div
                                    class="progress-fill {% if commande.statut == 'ANNULEE' %}cancelled{% endif %}"
                                    style="width: {{ progress }}%;"
                                ></div>
                            </div>
                        </div>
                    </div>

                    {# FOOTER ET ACTIONS #}
                    <div class="order-card-footer">
                        <div class="order-footer-message">
                            {% if paiement and paiement.statut == 'PAYE' %}
                                <i class="bi bi-shield-check me-1"></i>
                                Paiement confirmé
                            {% elseif paiement %}
                                <i class="bi bi-clock me-1"></i>
                                Paiement en traitement
                            {% else %}
                                <i class="bi bi-info-circle me-1"></i>
                                Aucun paiement enregistré
                            {% endif %}
                        </div>

                        <div class="order-actions">

                            {# PAIEMENT #}
                            {% if commande.statut == 'CONFIRMEE' and paiement is null %}
                                <a
                                    href="{{ path('app_client_paiement_new', {
                                        id: commande.id
                                    }) }}"
                                    class="order-action-button order-action-success"
                                >
                                    <i class="bi bi-credit-card me-1"></i>
                                    Payer
                                </a>
                            {% endif %}

                            {# LIVRAISON #}
                            {% if commande.statut == 'CONFIRMEE'
                                and paiement
                                and paiement.statut == 'PAYE'
                                and livraison is null %}
                                <a
                                    href="{{ path('app_client_livraison_new', {
                                        id: commande.id
                                    }) }}"
                                    class="order-action-button order-action-success"
                                >
                                    <i class="bi bi-truck me-1"></i>
                                    Livraison
                                </a>
                            {% endif %}

                            {# DÉTAIL #}
                            <a
                                href="{{ path('app_client_commande_confirmation', {
                                    id: commande.id
                                }) }}"
                                class="order-action-button order-action-primary"
                            >
                                <i class="bi bi-eye me-1"></i>
                                Voir le détail
                            </a>

                        </div>
                    </div>
                </article>

            {% endfor %}
        </div>

        {# AUCUN RÉSULTAT DE RECHERCHE #}
        <div class="orders-empty" id="ordersEmpty">
            <i class="bi bi-search"></i>
            <strong>Aucune commande trouvée</strong>
            <span>Essayez de modifier votre recherche ou le filtre.</span>
        </div>

    {% else %}

        {# AUCUNE COMMANDE #}
        <div class="orders-empty" style="display:block;">
            <i class="bi bi-receipt"></i>
            <strong>Vous n'avez encore aucune commande</strong>
            <span>
                Découvrez les produits disponibles et commencez vos achats.
            </span>

            <a href="{{ path('app_client_produit_index') }}">
                <i class="bi bi-shop"></i>
                Découvrir les produits
            </a>
        </div>

    {% endif %}
</div>

{# RECHERCHE ET FILTRE #}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('orderSearch');
    const filter = document.getElementById('orderFilter');
    const list = document.getElementById('ordersList');
    const empty = document.getElementById('ordersEmpty');

    if (!searchInput || !filter || !list || !empty) {
        return;
    }

    const orders = Array.from(list.querySelectorAll('.order-card'));

    function filterOrders() {
        const search = searchInput.value.trim().toLowerCase();
        const selectedStatus = filter.value;
        let visibleCount = 0;

        orders.forEach(function (order) {
            const number = order.dataset.number || '';
            const status = order.dataset.status || '';

            const matchesSearch =
                search === '' || number.includes(search);

            const matchesStatus =
                selectedStatus === '' || status === selectedStatus;

            if (matchesSearch && matchesStatus) {
                order.style.display = '';
                visibleCount++;
            } else {
                order.style.display = 'none';
            }
        });

        empty.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', filterOrders);
    filter.addEventListener('change', filterOrders);

    filterOrders();
});
</script>

{% endblock %}
