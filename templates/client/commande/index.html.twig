{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}

<style>

    /* =========================================================
       PAGE COMMANDES CLIENT
       ========================================================= */

    .client-orders-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .orders-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 23px;
    }

    .orders-header small {
        display: block;

        margin-bottom: 5px;

        color: #7d8799;

        font-size: 10px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .12em;
    }

    .orders-header h1 {
        margin: 0;

        color: #172033;

        font-size: 29px;
        font-weight: 800;
    }

    .orders-header p {
        margin: 7px 0 0;

        color: #7f899c;

        font-size: 12px;
    }

    .new-order-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 11px 14px;

        border-radius: 10px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s ease;
    }

    .new-order-button:hover {
        background: #263653;
        color: white;

        transform: translateY(-1px);
    }

    /* =========================================================
       STATISTIQUES
       ========================================================= */

    .orders-stats {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 15px;

        margin-bottom: 21px;
    }

    .order-stat {
        display: flex;
        align-items: center;

        gap: 12px;

        padding: 17px;

        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 14px;

        box-shadow: 0 2px 11px rgba(15,23,42,.04);
    }

    .order-stat-icon {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 16px;
    }

    .order-stat-value {
        color: #172033;

        font-size: 20px;
        font-weight: 900;
    }

    .order-stat-label {
        margin-top: 3px;

        color: #8892a4;

        font-size: 9px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .03em;
    }

    /* =========================================================
       BARRE DE RECHERCHE
       ========================================================= */

    .orders-toolbar {
        display: grid;

        grid-template-columns: minmax(250px, 1fr) 200px;

        gap: 12px;

        padding: 14px;

        margin-bottom: 20px;

        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 14px;

        box-shadow: 0 2px 11px rgba(15,23,42,.04);
    }

    .search-container {
        position: relative;
    }

    .search-container i {
        position: absolute;

        left: 13px;
        top: 50%;

        transform: translateY(-50%);

        color: #8d97a8;

        font-size: 14px;
    }

    .orders-search,
    .orders-filter {
        width: 100%;
        height: 42px;

        border: 1px solid #e0e5ec;
        border-radius: 9px;

        background: #f9fafc;

        color: #344054;

        font-size: 11px;

        outline: none;

        transition: .2s ease;
    }

    .orders-search {
        padding: 0 13px 0 37px;
    }

    .orders-filter {
        padding: 0 12px;
    }

    .orders-search:focus,
    .orders-filter:focus {
        border-color: #9dbbff;

        background: white;

        box-shadow: 0 0 0 3px rgba(37,99,235,.08);
    }

    /* =========================================================
       COMMANDE CARD
       ========================================================= */

    .orders-list {
        display: flex;

        flex-direction: column;

        gap: 15px;
    }

    .order-card {
        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 16px;

        box-shadow: 0 3px 14px rgba(15,23,42,.045);

        overflow: hidden;

        transition: .2s ease;
    }

    .order-card:hover {
        border-color: #dce5fa;

        box-shadow: 0 7px 23px rgba(15,23,42,.07);
    }

    .order-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        padding: 17px 20px;

        border-bottom: 1px solid #edf0f5;
    }

    .order-card-number {
        color: #172033;

        font-size: 14px;
        font-weight: 900;
    }

    .order-card-date {
        margin-top: 5px;

        color: #8a94a6;

        font-size: 9px;
    }

    .main-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 6px 9px;

        border-radius: 999px;

        font-size: 9px;
        font-weight: 850;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-confirmed {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-cancelled {
        background: #fef2f2;
        color: #b91c1c;
    }

    .status-default {
        background: #f3f4f6;
        color: #475467;
    }

    /* =========================================================
       CORPS COMMANDE
       ========================================================= */

    .order-card-body {
        padding: 18px 20px;
    }

    .order-info-grid {
        display: grid;

        grid-template-columns: 1.2fr 1fr 1fr 1fr;

        gap: 16px;
    }

    .order-info-label {
        display: block;

        margin-bottom: 5px;

        color: #929bab;

        font-size: 8px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .order-info-value {
        color: #344054;

        font-size: 11px;
        font-weight: 800;
    }

    .order-total-client {
        color: #172033;

        font-size: 16px;
        font-weight: 900;
    }

    /* =========================================================
       BADGES
       ========================================================= */

    .client-status {
        display: inline-flex;

        padding: 5px 8px;

        border-radius: 999px;

        font-size: 8px;
        font-weight: 850;
    }

    .client-status-success {
        background: #ecfdf3;
        color: #15803d;
    }

    .client-status-warning {
        background: #fff7ed;
        color: #c2410c;
    }

    .client-status-danger {
        background: #fef2f2;
        color: #b91c1c;
    }

    .client-status-info {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .client-status-neutral {
        background: #f3f4f6;
        color: #667085;
    }

    /* =========================================================
       PROGRESSION
       ========================================================= */

    .order-progress {
        margin-top: 19px;
    }

    .progress-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 7px;
    }

    .progress-top span {
        color: #8791a3;

        font-size: 9px;
        font-weight: 700;
    }

    .progress-line {
        width: 100%;
        height: 7px;

        background: #eef1f5;

        border-radius: 999px;

        overflow: hidden;
    }

    .progress-fill {
        height: 100%;

        border-radius: inherit;

        background: #2563eb;

        transition: width .3s ease;
    }

    .progress-fill.cancelled {
        background: #dc2626;
    }

    /* =========================================================
       FOOTER COMMANDE
       ========================================================= */

    .order-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 13px 20px;

        background: #fafbfd;

        border-top: 1px solid #edf0f5;
    }

    .order-actions {
        display: flex;
        align-items: center;

        gap: 8px;
    }

    .order-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 34px;

        padding: 0 10px;

        border-radius: 8px;

        text-decoration: none;

        font-size: 9px;
        font-weight: 800;

        transition: .2s ease;
    }

    .order-action-primary {
        background: #172033;
        color: white;
    }

    .order-action-primary:hover {
        background: #263653;
        color: white;
    }

    .order-action-secondary {
        background: #eff4ff;
        color: #2563eb;
    }

    .order-action-secondary:hover {
        background: #e1ebff;
        color: #1d4ed8;
    }

    .order-action-success {
        background: #ecfdf3;
        color: #15803d;
    }

    .order-action-success:hover {
        background: #dcfce7;
        color: #166534;
    }

    /* =========================================================
       EMPTY
       ========================================================= */

    .orders-empty {
        display: none;

        padding: 65px 25px;

        background: white;

        border: 1px solid #e8ebf1;
        border-radius: 16px;

        text-align: center;
    }

    .orders-empty i {
        display: block;

        margin-bottom: 12px;

        color: #a5aebb;

        font-size: 38px;
    }

    .orders-empty strong {
        display: block;

        color: #172033;

        font-size: 16px;
        font-weight: 850;
    }

    .orders-empty span {
        display: block;

        margin-top: 6px;

        color: #8a94a6;

        font-size: 10px;
    }

    .orders-empty a {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        margin-top: 17px;

        padding: 10px 14px;

        border-radius: 9px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 800;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1100px) {

        .orders-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .order-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @media (max-width: 800px) {

        .orders-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .new-order-button {
            width: 100%;

            justify-content: center;
        }

        .orders-toolbar {
            grid-template-columns: 1fr;
        }

        .order-card-header {
            align-items: flex-start;

            flex-direction: column;
        }

    }

    @media (max-width: 600px) {

        .orders-stats {
            grid-template-columns: 1fr;
        }

        .order-info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .order-card-footer {
            align-items: flex-start;

            flex-direction: column;
        }

        .order-actions {
            width: 100%;
        }

        .order-action-button {
            flex: 1;
        }

    }

</style>


<div class="client-orders-page">

    {# =========================================================
       HEADER
       ========================================================= #}

    <div class="orders-header">

        <div>

            <small>
                Espace client
            </small>

            <h1>
                Mes commandes
            </h1>

            <p>
                Retrouvez l'historique et suivez l'état de vos commandes.
            </p>

        </div>


        <a
            href="{{ path('app_client_produit_index') }}"
            class="new-order-button"
        >
            <i class="bi bi-plus-circle"></i>
            Nouvelle commande
        </a>

    </div>


    {# =========================================================
       CALCUL DES STATISTIQUES
       ========================================================= #}

    {% set totalCommandes = commandes|length %}
    {% set totalAttente = 0 %}
    {% set totalConfirmees = 0 %}
    {% set totalAnnulees = 0 %}

    {% for commande in commandes %}

        {% if commande.statut == 'EN_ATTENTE' %}
            {% set totalAttente = totalAttente + 1 %}
        {% endif %}

        {% if commande.statut == 'CONFIRMEE' %}
            {% set totalConfirmees = totalConfirmees + 1 %}
        {% endif %}

        {% if commande.statut == 'ANNULEE' %}
            {% set totalAnnulees = totalAnnulees + 1 %}
        {% endif %}

    {% endfor %}


    {# =========================================================
       STATISTIQUES
       ========================================================= #}

    <section class="orders-stats">

        <div class="order-stat">

            <div class="order-stat-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <div>

                <div class="order-stat-value">
                    {{ totalCommandes }}
                </div>

                <div class="order-stat-label">
                    Toutes les commandes
                </div>

            </div>

        </div>


        <div class="order-stat">

            <div class="order-stat-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>

                <div class="order-stat-value">
                    {{ totalAttente }}
                </div>

                <div class="order-stat-label">
                    En attente
                </div>

            </div>

        </div>


        <div class="order-stat">

            <div class="order-stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>

                <div class="order-stat-value">
                    {{ totalConfirmees }}
                </div>

                <div class="order-stat-label">
                    Confirmées
                </div>

            </div>

        </div>


        <div class="order-stat">

            <div class="order-stat-icon">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>

                <div class="order-stat-value">
                    {{ totalAnnulees }}
                </div>

                <div class="order-stat-label">
                    Annulées
                </div>

            </div>

        </div>

    </section>


    {# =========================================================
       RECHERCHE / FILTRE
       ========================================================= #}

    <div class="orders-toolbar">

        <div class="search-container">

            <i class="bi bi-search"></i>

            <input
                type="text"
                id="orderSearch"
                class="orders-search"
                placeholder="Rechercher par numéro de commande..."
                autocomplete="off"
            >

        </div>


        <select
            id="orderFilter"
            class="orders-filter"
        >

            <option value="">
                Tous les statuts
            </option>

            <option value="EN_ATTENTE">
                En attente
            </option>

            <option value="CONFIRMEE">
                Confirmée
            </option>

            <option value="ANNULEE">
                Annulée
            </option>

        </select>

    </div>


    {# =========================================================
       LISTE DES COMMANDES
       ========================================================= #}

    {% if commandes is not empty %}

        <div
            class="orders-list"
            id="ordersList"
        >

            {% for commande in commandes %}

                {% set paiement = paiements[commande.id] ?? null %}
                {% set livraison = livraisons[commande.id] ?? null %}


                {# PROGRESSION #}

                {% if commande.statut == 'EN_ATTENTE' %}

                    {% set progress = 25 %}

                {% elseif commande.statut == 'CONFIRMEE' %}

                    {% if livraison and livraison.statut == 'LIVREE' %}

                        {% set progress = 100 %}

                    {% elseif livraison and livraison.statut == 'EN_COURS' %}

                        {% set progress = 80 %}

                    {% elseif paiement and paiement.statut == 'PAYE' %}

                        {% set progress = 65 %}

                    {% else %}

                        {% set progress = 50 %}

                    {% endif %}

                {% elseif commande.statut == 'ANNULEE' %}

                    {% set progress = 100 %}

                {% else %}

                    {% set progress = 35 %}

                {% endif %}


                <article
                    class="order-card"
                    data-number="{{ commande.numero|lower }}"
                    data-status="{{ commande.statut }}"
                >

                    {# =================================================
                       HEADER COMMANDE
                       ================================================= #}

                    <div class="order-card-header">

                        <div>

                            <div class="order-card-number">

                                <i class="bi bi-receipt me-1"></i>

                                {{ commande.numero }}

                            </div>

                            <div class="order-card-date">

                                <i class="bi bi-calendar3 me-1"></i>

                                {{ commande.createdAt|date('d/m/Y à H:i') }}

                            </div>

                        </div>


                        {# STATUT COMMANDE #}

                        <div>

                            {% if commande.statut == 'EN_ATTENTE' %}

                                <span class="main-status status-pending">
                                    <i class="bi bi-hourglass-split"></i>
                                    En attente
                                </span>

                            {% elseif commande.statut == 'CONFIRMEE' %}

                                <span class="main-status status-confirmed">
                                    <i class="bi bi-check-circle"></i>
                                    Confirmée
                                </span>

                            {% elseif commande.statut == 'ANNULEE' %}

                                <span class="main-status status-cancelled">
                                    <i class="bi bi-x-circle"></i>
                                    Annulée
                                </span>

                            {% else %}

                                <span class="main-status status-default">
                                    {{ commande.statut }}
                                </span>

                            {% endif %}

                        </div>

                    </div>


                    {# =================================================
                       CORPS
                       ================================================= #}

                    <div class="order-card-body">

                        <div class="order-info-grid">

                            {# TOTAL #}

                            <div>

                                <span class="order-info-label">
                                    Montant total
                                </span>

                                <div class="order-total-client">
                                    {{ commande.total|number_format(0, ',', ' ') }} Ar
                                </div>

                            </div>


                            {# PAIEMENT #}

                            <div>

                                <span class="order-info-label">
                                    Paiement
                                </span>

                                {% if paiement %}

                                    {% if paiement.statut == 'PAYE' %}

                                        <span class="client-status client-status-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Payé
                                        </span>

                                    {% elseif paiement.statut == 'EN_ATTENTE' %}

                                        <span class="client-status client-status-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            En attente
                                        </span>

                                    {% elseif paiement.statut == 'REFUSE' %}

                                        <span class="client-status client-status-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Refusé
                                        </span>

                                    {% else %}

                                        <span class="client-status client-status-neutral">
                                            {{ paiement.statut }}
                                        </span>

                                    {% endif %}

                                {% else %}

                                    <span class="client-status client-status-neutral">
                                        Non effectué
                                    </span>

                                {% endif %}

                            </div>


                            {# LIVRAISON #}

                            <div>

                                <span class="order-info-label">
                                    Livraison
                                </span>

                                {% if livraison %}

                                    {% if livraison.statut == 'LIVREE' %}

                                        <span class="client-status client-status-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Livrée
                                        </span>

                                    {% elseif livraison.statut == 'EN_COURS' %}

                                        <span class="client-status client-status-info">
                                            <i class="bi bi-truck me-1"></i>
                                            En cours
                                        </span>

                                    {% elseif livraison.statut == 'EN_ATTENTE' %}

                                        <span class="client-status client-status-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            En attente
                                        </span>

                                    {% elseif livraison.statut == 'ANNULEE' %}

                                        <span class="client-status client-status-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Annulée
                                        </span>

                                    {% else %}

                                        <span class="client-status client-status-neutral">
                                            {{ livraison.statut }}
                                        </span>

                                    {% endif %}

                                {% else %}

                                    <span class="client-status client-status-neutral">
                                        Non configurée
                                    </span>

                                {% endif %}

                            </div>


                            {# DATE #}

                            <div>

                                <span class="order-info-label">
                                    Date
                                </span>

                                <span class="order-info-value">
                                    {{ commande.createdAt|date('d/m/Y') }}
                                </span>

                            </div>

                        </div>


                        {# =================================================
                           PROGRESSION
                           ================================================= #}

                        <div class="order-progress">

                            <div class="progress-top">

                                <span>
                                    Progression de la commande
                                </span>

                                {% if commande.statut == 'ANNULEE' %}

                                    <span>
                                        Commande annulée
                                    </span>

                                {% elseif livraison and livraison.statut == 'LIVREE' %}

                                    <span>
                                        Commande terminée
                                    </span>

                                {% elseif livraison and livraison.statut == 'EN_COURS' %}

                                    <span>
                                        Livraison en cours
                                    </span>

                                {% elseif paiement and paiement.statut == 'PAYE' %}

                                    <span>
                                        Paiement validé
                                    </span>

                                {% elseif commande.statut == 'CONFIRMEE' %}

                                    <span>
                                        Commande confirmée
                                    </span>

                                {% else %}

                                    <span>
                                        En attente de validation
                                    </span>

                                {% endif %}

                            </div>


                            <div class="progress-line">

                                <div
                                    class="progress-fill {% if commande.statut == 'ANNULEE' %}cancelled{% endif %}"
                                    style="width: {{ progress }}%;"
                                ></div>

                            </div>

                        </div>

                    </div>


                    {# =================================================
                       FOOTER ACTIONS
                       ================================================= #}

                    <div class="order-card-footer">

                        <div
                            style="
                                color:#8a94a6;
                                font-size:9px;
                            "
                        >

                            {% if paiement and paiement.statut == 'PAYE' %}

                                <i class="bi bi-shield-check me-1"></i>
                                Paiement confirmé

                            {% elseif paiement %}

                                <i class="bi bi-clock me-1"></i>
                                Paiement en traitement

                            {% else %}

                                <i class="bi bi-info-circle me-1"></i>
                                Aucun paiement enregistré

                            {% endif %}

                        </div>


                        <div class="order-actions">

                            {# PAIEMENT #}

                            {% if commande.statut == 'CONFIRMEE'
                                and paiement is null %}

                                <a
                                    href="{{ path('app_client_paiement_new', {
                                        id: commande.id
                                    }) }}"
                                    class="order-action-button order-action-success"
                                >

                                    <i class="bi bi-credit-card me-1"></i>

                                    Payer

                                </a>

                            {% endif %}


                            {# LIVRAISON #}

                            {% if commande.statut == 'CONFIRMEE'
                                and paiement
                                and paiement.statut == 'PAYE'
                                and livraison is null %}

                                <a
                                    href="{{ path('app_client_livraison_new', {
                                        id: commande.id
                                    }) }}"
                                    class="order-action-button order-action-success"
                                >

                                    <i class="bi bi-truck me-1"></i>

                                    Livraison

                                </a>

                            {% endif %}


                            {# DETAIL #}

                            <a
                                href="{{ path('app_client_commande_confirmation', {
                                    id: commande.id
                                }) }}"
                                class="order-action-button order-action-primary"
                            >

                                <i class="bi bi-eye me-1"></i>

                                Voir le détail

                            </a>

                        </div>

                    </div>

                </article>

            {% endfor %}

        </div>


        {# =========================================================
           AUCUN RESULTAT DE RECHERCHE
           ========================================================= #}

        <div
            class="orders-empty"
            id="ordersEmpty"
        >

            <i class="bi bi-search"></i>

            <strong>
                Aucune commande trouvée
            </strong>

            <span>
                Essayez de modifier votre recherche ou le filtre.
            </span>

        </div>


    {% else %}

        {# =========================================================
           AUCUNE COMMANDE
           ========================================================= #}

        <div class="orders-empty" style="display:block;">

            <i class="bi bi-receipt"></i>

            <strong>
                Vous n'avez encore aucune commande
            </strong>

            <span>
                Découvrez les produits disponibles et commencez vos achats.
            </span>

            <a href="{{ path('app_client_produit_index') }}">

                <i class="bi bi-shop"></i>

                Découvrir les produits

            </a>

        </div>

    {% endif %}

</div>


{# =============================================================
   RECHERCHE + FILTRE
   ============================================================= #}

<script>

    document.addEventListener('DOMContentLoaded', function () {

        const searchInput =
            document.getElementById('orderSearch');

        const filter =
            document.getElementById('orderFilter');

        const list =
            document.getElementById('ordersList');

        const empty =
            document.getElementById('ordersEmpty');


        if (!searchInput || !filter || !list || !empty) {
            return;
        }


        const orders =
            Array.from(
                list.querySelectorAll('.order-card')
            );


        function filterOrders() {

            const search =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const selectedStatus =
                filter.value;


            let visibleCount = 0;


            orders.forEach(function (order) {

                const number =
                    order.dataset.number || '';

                const status =
                    order.dataset.status || '';


                const matchesSearch =
                    search === '' ||
                    number.includes(search);


                const matchesStatus =
                    selectedStatus === '' ||
                    status === selectedStatus;


                if (matchesSearch && matchesStatus) {

                    order.style.display = '';

                    visibleCount++;

                } else {

                    order.style.display = 'none';

                }

            });


            empty.style.display =
                visibleCount === 0
                    ? 'block'
                    : 'none';

        }


        searchInput.addEventListener(
            'input',
            filterOrders
        );


        filter.addEventListener(
            'change',
            filterOrders
        );


        filterOrders();

    });

</script>

{% endblock %}
