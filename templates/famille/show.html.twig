{% extends 'base.html.twig' %}

{% block title %}Détail de la famille{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <a href="{{ path('app_famille_index') }}" class="text-decoration-none">
                <i class="fas fa-arrow-left me-2"></i>Retour aux familles
            </a>
            <h2 class="fw-bold mt-3 mb-1">{{ famille.nom }}</h2>
            <p class="text-muted mb-0">Détails et produits associés à cette famille.</p>
        </div>
        <a href="{{ path('app_famille_edit', {id: famille.id}) }}" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Modifier
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nom :</strong> {{ famille.nom }}</p>
                    <p><strong>Catégorie :</strong> {{ famille.categorie.nom }}</p>
                    <p><strong>Description :</strong> {{ famille.description ?: 'Aucune description' }}</p>
                    <p class="mb-0">
                        <strong>Statut :</strong>
                        {% if famille.actif %}
                            <span class="badge bg-success">Active</span>
                        {% else %}
                            <span class="badge bg-secondary">Inactive</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Produits associés</h5>
                </div>
                <div class="card-body">
                    {% if famille.produits|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Référence</th>
                                        <th>Produit</th>
                                        <th>Stock</th>
                                        <th>Prix de vente</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for produit in famille.produits %}
                                        <tr>
                                            <td>{{ produit.reference }}</td>
                                            <td>{{ produit.nom }}</td>
                                            <td>{{ produit.quantiteStock }}</td>
                                            <td>{{ produit.prixVente|number_format(0, ',', ' ') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center py-4 mb-0">
                            Aucun produit associé à cette famille.
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
