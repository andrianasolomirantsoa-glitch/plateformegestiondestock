{% extends 'base.html.twig' %}

{% block title %}Ajouter une famille{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="{{ path('app_famille_index') }}" class="text-decoration-none">
            <i class="fas fa-arrow-left me-2"></i>Retour aux familles
        </a>
        <h2 class="fw-bold mt-3 mb-1">Ajouter une famille</h2>
        <p class="text-muted">Associez une nouvelle famille à une catégorie.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Informations de la famille</h5>
        </div>
        <div class="card-body p-4">
            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.categorie) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(form.description) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(form.actif) }}
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('app_famille_index') }}" class="btn btn-light">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
