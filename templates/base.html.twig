<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}Gestion de Stock{% endblock %}
    </title>

    {# CSS personnel #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {# Bootstrap #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {# Bootstrap Icons #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <style>

        /* =========================================================
           GLOBAL
           ========================================================= */

        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #172033;
        }

        /* =========================================================
           NAVBAR PRINCIPALE
           ========================================================= */

        .main-navbar {
            background: #172033;
            min-height: 70px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.12);
        }

        .navbar-container {
            width: 100%;
            padding: 0 25px;
        }

        /* Logo */

        .brand {
            color: white;
            font-size: 21px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand:hover {
            color: white;
        }

        .brand-icon {
            font-size: 25px;
            margin-right: 8px;
            vertical-align: middle;
        }

        /* =========================================================
           MENU
           ========================================================= */

        .main-menu {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-left: 30px;
        }

        .main-menu .nav-link {
            color: #b9c1d0;
            padding: 10px 13px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .main-menu .nav-link i {
            margin-right: 5px;
        }

        .main-menu .nav-link:hover {
            color: white;
            background: #263653;
        }

        .main-menu .nav-link.active {
            color: white;
            background: #34466b;
        }

        .main-menu .nav-link.disabled {
            color: #697386;
            cursor: not-allowed;
            opacity: 0.6;
        }

        /* =========================================================
           UTILISATEUR
           ========================================================= */

        .user-section {
            display: flex;
            align-items: center;
            margin-left: auto;
            gap: 12px;
        }

        .user-info {
            color: #dce2ec;
            font-size: 14px;
            white-space: nowrap;
        }

        .user-info i {
            font-size: 18px;
            margin-right: 5px;
        }

        .logout-btn {
            border-radius: 8px;
            font-size: 13px;
            padding: 7px 12px;
        }

        /* =========================================================
           CONTENU
           ========================================================= */

        .content {
            padding: 30px;
            max-width: 1600px;
            margin: auto;
        }

        .page-title {
            font-weight: 700;
            color: #172033;
        }

        /* =========================================================
           CARDS
           ========================================================= */

        .card {
            border: 0;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        }

        /* =========================================================
           TABLEAUX
           ========================================================= */

        .table th {
            white-space: nowrap;
        }

        /* =========================================================
           BADGES STOCK
           ========================================================= */

        .badge-stock-normal {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-stock-low {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-stock-empty {
            background: #fee2e2;
            color: #991b1b;
        }

        /* =========================================================
           BOUTON MENU MOBILE
           ========================================================= */

        .mobile-menu-btn {
            color: white;
            border: 1px solid #4a5872;
        }

        .mobile-menu-btn:hover {
            background: #263653;
            color: white;
        }

        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @media (max-width: 1199px) {

            .main-menu {
                margin-left: 10px;
            }

            .main-menu .nav-link {
                padding: 9px 9px;
                font-size: 13px;
            }

            .user-info {
                display: none;
            }
        }

        @media (max-width: 991px) {

            .navbar-container {
                padding: 0 15px;
            }

            .main-menu {
                margin-left: 0;
                padding: 15px 0;
            }

            .main-menu .nav-link {
                margin-bottom: 4px;
            }

            .user-section {
                margin-left: 0;
                padding-bottom: 15px;
            }

            .content {
                padding: 20px;
            }
        }

        @media (max-width: 575px) {

            .content {
                padding: 15px;
            }

            .brand {
                font-size: 18px;
            }

            .brand-icon {
                font-size: 21px;
            }
        }

    </style>

    {% block stylesheets %}{% endblock %}
</head>


<body>

{# ==============================================================
   MENU HORIZONTAL
   ============================================================== #}

<nav class="navbar navbar-expand-lg main-navbar">

    <div class="navbar-container">

        <div class="d-flex align-items-center">

            {# LOGO #}

            <a
                href="{{ path('app_dashboard') }}"
                class="brand"
            >
                <i class="bi bi-box-seam brand-icon"></i>
                Gestion Stock
            </a>


            {# BOUTON MOBILE #}

            <button
                class="navbar-toggler mobile-menu-btn ms-auto"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainMenu"
                aria-controls="mainMenu"
                aria-expanded="false"
                aria-label="Ouvrir le menu"
            >
                <i class="bi bi-list fs-4"></i>
            </button>

        </div>


        {# ==========================================================
           MENU
           ========================================================== #}

        <div
            class="collapse navbar-collapse"
            id="mainMenu"
        >

            <div class="main-menu">

                {# TABLEAU DE BORD #}

                <a
                    href="{{ path('app_dashboard') }}"
                    class="nav-link
                    {% if app.request.attributes.get('_route') == 'app_dashboard' %}
                        active
                    {% endif %}"
                >
                    <i class="bi bi-speedometer2"></i>
                    Tableau de bord
                </a>


                {# PRODUITS #}

                <a
                    href="{{ path('app_produit_index') }}"
                    class="nav-link
                    {% if app.request.attributes.get('_route') starts with 'app_produit_' %}
                        active
                    {% endif %}"
                >
                    <i class="bi bi-box"></i>
                    Produits
                </a>


                {# CATEGORIES #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-tags"></i>
                    Catégories
                </a>


                {# ENTREES #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-arrow-down-circle"></i>
                    Entrées
                </a>


                {# SORTIES #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-arrow-up-circle"></i>
                    Sorties
                </a>


                {# CLIENTS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-people"></i>
                    Clients
                </a>


                {# FOURNISSEURS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-truck"></i>
                    Fournisseurs
                </a>


                {# UTILISATEURS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-person"></i>
                    Utilisateurs
                </a>

            </div>


            {# ======================================================
               UTILISATEUR / DECONNEXION
               ====================================================== #}

            <div class="user-section">

                {% if app.user %}

                    <span class="user-info">

                        <i class="bi bi-person-circle"></i>

                        {{ app.user.prenom }}
                        {{ app.user.nom }}

                    </span>


                    <a
                        href="{{ path('app_logout') }}"
                        class="btn btn-outline-danger logout-btn"
                    >
                        <i class="bi bi-box-arrow-right"></i>
                        Déconnexion
                    </a>

                {% endif %}

            </div>

        </div>

    </div>

</nav>


{# ==============================================================
   CONTENU PRINCIPAL
   ============================================================== #}

<main>

    <div class="content">

        {# ==========================================================
           MESSAGES FLASH
           ========================================================== #}

        {% for label, messages in app.flashes %}

            {% for message in messages %}

                <div
                    class="alert
                    alert-{{ label == 'error' ? 'danger' : label }}
                    alert-dismissible
                    fade
                    show"
                    role="alert"
                >

                    {{ message }}

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fermer"
                    ></button>

                </div>

            {% endfor %}

        {% endfor %}


        {# ==========================================================
           TITRE DE LA PAGE
           ========================================================== #}

        {% block header_title %}{% endblock %}


        {# ==========================================================
           CONTENU DE LA PAGE
           ========================================================== #}

        {% block body %}{% endblock %}

    </div>

</main>


{# ==============================================================
   BOOTSTRAP JS
   ============================================================== #}

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


{% block javascripts %}{% endblock %}

</body>

</html>