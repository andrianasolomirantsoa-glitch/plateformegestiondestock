<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        {% block title %}NEXA{% endblock %}
    </title>

    <meta
        name="theme-color"
        content="#070b17"
    >

    {# =========================================================
       BOOTSTRAP
       ========================================================= #}

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {# =========================================================
       BOOTSTRAP ICONS
       ========================================================= #}

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    {# =========================================================
       STYLE NEXA
       ========================================================= #}

    <style>

        :root {
            --nex-bg: #070b17;
            --nex-bg-2: #0b1120;
            --nex-bg-3: #10182b;

            --nex-cyan: #22d3ee;
            --nex-blue: #3b82f6;
            --nex-violet: #8b5cf6;
            --nex-purple: #a855f7;

            --nex-white: #ffffff;
            --nex-text: #e2e8f0;
            --nex-muted: #94a3b8;

            --nex-border: rgba(255,255,255,.08);
        }


        /* =====================================================
           GLOBAL
           ===================================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;

            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            color: #172033;

            background:
                radial-gradient(
                    circle at 10% 0%,
                    rgba(34, 211, 238, .035),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 10%,
                    rgba(139, 92, 246, .035),
                    transparent 30%
                ),
                #f5f7fb;
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           NAVBAR
           ===================================================== */

        .nex-navbar {
            position: sticky;
            top: 0;
            z-index: 1050;

            min-height: 76px;

            background:
                radial-gradient(
                    circle at 5% 0%,
                    rgba(34,211,238,.11),
                    transparent 25%
                ),
                radial-gradient(
                    circle at 85% 0%,
                    rgba(139,92,246,.13),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    #070b17 0%,
                    #0a1020 50%,
                    #080d19 100%
                );

            border-bottom: 1px solid rgba(255,255,255,.07);

            box-shadow:
                0 10px 35px rgba(0,0,0,.30),
                0 0 35px rgba(59,130,246,.05);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .nex-navbar::after {
            content: "";

            position: absolute;

            left: 0;
            right: 0;
            bottom: -1px;

            height: 1px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(34,211,238,.8),
                    rgba(139,92,246,.8),
                    transparent
                );

            box-shadow:
                0 0 8px rgba(34,211,238,.5),
                0 0 15px rgba(139,92,246,.25);
        }

        .nex-navbar .container,
        .nex-navbar .container-fluid {
            min-height: 76px;
        }


        /* =====================================================
           LOGO
           ===================================================== */

        .nex-brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;

            margin-right: 26px;

            color: #ffffff !important;
        }

        .nex-logo-icon {
            width: 44px;
            height: 44px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background:
                linear-gradient(
                    135deg,
                    rgba(34,211,238,.16),
                    rgba(139,92,246,.20)
                );

            border: 1px solid rgba(34,211,238,.36);

            color: var(--nex-cyan);

            box-shadow:
                0 0 10px rgba(34,211,238,.18),
                0 0 25px rgba(139,92,246,.08),
                inset 0 0 15px rgba(139,92,246,.06);

            transition: .25s ease;
        }

        .nex-logo-icon i {
            font-size: 1.25rem;
        }

        .nex-brand:hover .nex-logo-icon {
            transform: scale(1.04);

            border-color: rgba(34,211,238,.70);

            box-shadow:
                0 0 12px rgba(34,211,238,.42),
                0 0 28px rgba(139,92,246,.15);
        }

        .nex-logo-text {
            font-size: 1.18rem;
            font-weight: 900;

            letter-spacing: .20em;

            color: #ffffff;

            text-shadow:
                0 0 7px rgba(255,255,255,.10),
                0 0 18px rgba(34,211,238,.10);
        }


        /* =====================================================
           NAVIGATION
           ===================================================== */

        .nex-navbar .navbar-nav {
            gap: 4px;
        }

        .nex-navbar .nav-link {
            position: relative;

            min-height: 46px;

            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 0 14px !important;

            color: #cbd5e1 !important;

            font-size: .91rem;
            font-weight: 600;

            border-radius: 12px;

            transition: .22s ease;
        }

        .nex-navbar .nav-link i {
            font-size: 1rem;

            transition: .22s ease;
        }

        .nex-navbar .nav-link:hover {
            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    rgba(34,211,238,.08),
                    rgba(139,92,246,.09)
                );

            box-shadow:
                inset 0 0 0 1px rgba(255,255,255,.035),
                0 0 18px rgba(34,211,238,.05);

            transform: translateY(-1px);
        }

        .nex-navbar .nav-link:hover i {
            color: var(--nex-cyan);

            text-shadow:
                0 0 8px rgba(34,211,238,.45);
        }


        /* =====================================================
           LIEN ACTIF
           ===================================================== */

        .nex-navbar .nav-link.nex-active {
            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    rgba(34,211,238,.12),
                    rgba(139,92,246,.14)
                );

            box-shadow:
                inset 0 0 0 1px rgba(34,211,238,.13),
                0 0 18px rgba(34,211,238,.06);
        }

        .nex-navbar .nav-link.nex-active i {
            color: var(--nex-cyan);

            text-shadow:
                0 0 8px rgba(34,211,238,.48);
        }

        .nex-navbar .nav-link.nex-active::after {
            content: "";

            position: absolute;

            left: 14px;
            right: 14px;
            bottom: 5px;

            height: 2px;

            border-radius: 20px;

            background:
                linear-gradient(
                    90deg,
                    var(--nex-cyan),
                    var(--nex-violet)
                );

            box-shadow:
                0 0 7px rgba(34,211,238,.55),
                0 0 12px rgba(139,92,246,.30);
        }


        /* =====================================================
           DROPDOWN
           ===================================================== */

        .nex-navbar .dropdown-menu {
            margin-top: 12px !important;

            min-width: 245px;

            padding: 8px;

            background:
                linear-gradient(
                    145deg,
                    rgba(10,16,32,.98),
                    rgba(7,11,23,.98)
                );

            border: 1px solid rgba(255,255,255,.08);

            border-radius: 17px;

            box-shadow:
                0 20px 45px rgba(0,0,0,.48),
                0 0 30px rgba(59,130,246,.07);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .nex-navbar .dropdown-item {
            display: flex;
            align-items: center;
            gap: 11px;

            padding: 11px 13px;

            color: #cbd5e1;

            font-size: .90rem;
            font-weight: 500;

            border-radius: 11px;

            transition: .20s ease;
        }

        .nex-navbar .dropdown-item i {
            width: 20px;

            text-align: center;

            color: #64748b;

            transition: .20s ease;
        }

        .nex-navbar .dropdown-item:hover,
        .nex-navbar .dropdown-item:focus {
            color: #ffffff;

            background:
                linear-gradient(
                    135deg,
                    rgba(34,211,238,.10),
                    rgba(139,92,246,.10)
                );

            transform: translateX(2px);
        }

        .nex-navbar .dropdown-item:hover i {
            color: var(--nex-cyan);

            text-shadow:
                0 0 7px rgba(34,211,238,.42);
        }

        .nex-navbar .dropdown-divider {
            border-color: rgba(255,255,255,.07);
        }


        /* =====================================================
           PANIER
           ===================================================== */

        .nex-cart-link {
            position: relative;
        }

        .nex-cart-badge {
            position: absolute;

            top: 3px;
            right: 3px;

            min-width: 19px;
            height: 19px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 0 5px;

            border-radius: 999px;

            background:
                linear-gradient(
                    135deg,
                    var(--nex-cyan),
                    var(--nex-violet)
                );

            color: #ffffff;

            border: 2px solid #0a1020;

            font-size: .64rem;
            font-weight: 800;

            box-shadow:
                0 0 7px rgba(34,211,238,.45),
                0 0 15px rgba(139,92,246,.18);
        }


        /* =====================================================
           UTILISATEUR
           ===================================================== */

        .nex-user-zone {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nex-user-pill {
            display: flex;
            align-items: center;
            gap: 10px;

            min-height: 46px;

            padding: 5px 12px 5px 6px;

            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.045),
                    rgba(255,255,255,.018)
                );

            border: 1px solid rgba(255,255,255,.07);

            transition: .22s ease;
        }

        .nex-user-pill:hover {
            border-color: rgba(34,211,238,.18);

            box-shadow:
                0 0 18px rgba(34,211,238,.05);
        }

        .nex-user-avatar {
            width: 35px;
            height: 35px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background:
                linear-gradient(
                    135deg,
                    var(--nex-cyan),
                    var(--nex-violet)
                );

            color: white;

            box-shadow:
                0 0 10px rgba(34,211,238,.20),
                0 0 16px rgba(139,92,246,.12);
        }

        .nex-user-info {
            display: flex;
            flex-direction: column;

            line-height: 1.1;
        }

        .nex-user-name {
            max-width: 150px;

            color: #f8fafc;

            font-size: .82rem;
            font-weight: 700;

            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .nex-user-role {
            margin-top: 4px;

            font-size: .68rem;
        }


        /* =====================================================
           BADGE ROLE
           ===================================================== */

        .nex-role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;

            padding: 4px 8px;

            border-radius: 999px;

            font-size: .65rem;
            font-weight: 700;
        }

        .nex-role-badge.admin {
            color: #cffafe;

            background: rgba(34,211,238,.08);

            border: 1px solid rgba(34,211,238,.20);
        }

        .nex-role-badge.client {
            color: #ede9fe;

            background: rgba(139,92,246,.08);

            border: 1px solid rgba(139,92,246,.20);
        }


        /* =====================================================
           DECONNEXION
           ===================================================== */

        .nex-logout {
            width: 43px;
            height: 43px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            color: #94a3b8;

            background:
                rgba(255,255,255,.025);

            border: 1px solid rgba(255,255,255,.07);

            transition: .22s ease;
        }

        .nex-logout:hover {
            color: #ffffff;

            background:
                rgba(239,68,68,.09);

            border-color:
                rgba(239,68,68,.25);

            box-shadow:
                0 0 16px rgba(239,68,68,.08);
        }


        /* =====================================================
           BOUTON MOBILE
           ===================================================== */

        .nex-toggler {
            width: 45px;
            height: 42px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            border: 1px solid rgba(255,255,255,.10);

            background:
                rgba(255,255,255,.035);

            color: #ffffff;

            box-shadow: none !important;
        }

        .nex-toggler:hover {
            color: var(--nex-cyan);

            border-color: rgba(34,211,238,.25);

            box-shadow:
                0 0 15px rgba(34,211,238,.07) !important;
        }


        /* =====================================================
           ALERTS
           ===================================================== */

        .nex-alert-zone {
            width: min(1400px, calc(100% - 30px));

            margin: 22px auto 0;
        }

        .nex-alert {
            border-radius: 15px;

            box-shadow:
                0 8px 25px rgba(15,23,42,.05);
        }


        /* =====================================================
           MAIN
           ===================================================== */

        .nex-main {
            min-height: calc(100vh - 76px);

            padding: 25px 0 45px;
        }

        .nex-content {
            width: min(1400px, calc(100% - 30px));

            margin: 0 auto;
        }


        /* =====================================================
           SCROLLBAR
           ===================================================== */

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #eef1f6;
        }

        ::-webkit-scrollbar-thumb {
            border-radius: 20px;

            background:
                linear-gradient(
                    180deg,
                    var(--nex-cyan),
                    var(--nex-violet)
                );
        }

        ::-webkit-scrollbar-thumb:hover {
            background:
                linear-gradient(
                    180deg,
                    var(--nex-blue),
                    var(--nex-purple)
                );
        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @media (max-width: 1199.98px) {

            .nex-navbar .navbar-collapse {
                margin-top: 12px;

                padding: 12px;

                border-radius: 18px;

                background:
                    linear-gradient(
                        145deg,
                        rgba(11,17,32,.98),
                        rgba(7,11,23,.98)
                    );

                border:
                    1px solid rgba(255,255,255,.07);

                box-shadow:
                    0 20px 35px rgba(0,0,0,.35);
            }

            .nex-navbar .nav-link {
                width: 100%;
            }

            .nex-navbar .dropdown-menu {
                margin-top: 4px !important;
            }

            .nex-user-zone {
                margin-top: 10px;

                padding-top: 10px;

                border-top:
                    1px solid rgba(255,255,255,.07);

                justify-content: space-between;
            }

        }


        @media (max-width: 575.98px) {

            .nex-brand {
                margin-right: 0;
            }

            .nex-logo-icon {
                width: 40px;
                height: 40px;
            }

            .nex-logo-text {
                font-size: 1rem;
            }

            .nex-user-info {
                display: none;
            }

            .nex-user-pill {
                padding-right: 6px;
            }

            .nex-content {
                width: calc(100% - 20px);
            }

            .nex-alert-zone {
                width: calc(100% - 20px);
            }

        }

    </style>

    {% block stylesheets %}{% endblock %}

</head>


<body>


{# =============================================================
   ROUTE COURANTE
   ============================================================= #}

{% set current_route = app.request.attributes.get('_route')|default('') %}


{# =============================================================
   NAVBAR
   ============================================================= #}

<nav class="navbar navbar-expand-xl nex-navbar">

    <div class="container-fluid px-3 px-lg-4">


        {# =====================================================
           LOGO
           ===================================================== #}

        {% if is_granted('ROLE_ADMIN') %}

            <a
                href="{{ path('app_stock_dashboard') }}"
                class="navbar-brand nex-brand"
            >

                <span class="nex-logo-icon">
                    <i class="bi bi-boxes"></i>
                </span>

                <span class="nex-logo-text">
                    NEXA
                </span>

            </a>

        {% else %}

            <a
                href="{{ path('app_client_home') }}"
                class="navbar-brand nex-brand"
            >

                <span class="nex-logo-icon">
                    <i class="bi bi-boxes"></i>
                </span>

                <span class="nex-logo-text">
                    NEXA
                </span>

            </a>

        {% endif %}


        {# =====================================================
           MOBILE BUTTON
           ===================================================== #}

        <button
            class="navbar-toggler nex-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#nexMainNavbar"
            aria-controls="nexMainNavbar"
            aria-expanded="false"
            aria-label="Ouvrir le menu"
        >

            <i class="bi bi-list fs-4"></i>

        </button>


        <div
            class="collapse navbar-collapse"
            id="nexMainNavbar"
        >


            {# =================================================
               ADMIN
               ================================================= #}

            {% if is_granted('ROLE_ADMIN') %}

                <ul class="navbar-nav me-auto mb-2 mb-xl-0">


                    {# DASHBOARD #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_stock_dashboard') }}"
                            class="nav-link
                            {% if current_route == 'app_stock_dashboard' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-grid-1x2-fill"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>

                    </li>


                    {# =================================================
                       STOCK
                       ================================================= #}

                    <li class="nav-item dropdown">

                        <a
                            href="#"
                            class="nav-link dropdown-toggle
                            {% if current_route starts with 'app_produit_'
                                or current_route starts with 'app_categorie_'
                                or current_route starts with 'app_entree_stock_'
                                or current_route starts with 'app_sortie_stock_'
                                or current_route starts with 'app_fournisseur_'
                                or current_route starts with 'app_mouvement_stock_'
                                or current_route == 'app_stock_dashboard'
                            %}
                                nex-active
                            {% endif %}"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >

                            <i class="bi bi-box-seam-fill"></i>

                            <span>
                                Stock
                            </span>

                        </a>


                        <ul class="dropdown-menu">


                            <li>

                                <a
                                    href="{{ path('app_produit_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-box2-fill"></i>

                                    <span>
                                        Produits
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_categorie_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-tags-fill"></i>

                                    <span>
                                        Catégories
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_fournisseur_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-truck"></i>

                                    <span>
                                        Fournisseurs
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_entree_stock_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-box-arrow-in-down"></i>

                                    <span>
                                        Entrées stock
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_sortie_stock_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-box-arrow-up"></i>

                                    <span>
                                        Sorties stock
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_mouvement_stock_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-arrow-left-right"></i>

                                    <span>
                                        Mouvements
                                    </span>

                                </a>

                            </li>


                            <li>

                                <hr class="dropdown-divider">

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_stock_dashboard') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-bar-chart-fill"></i>

                                    <span>
                                        Tableau de stock
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </li>


                    {# =================================================
                       VENTES
                       ================================================= #}

                    <li class="nav-item dropdown">

                        <a
                            href="#"
                            class="nav-link dropdown-toggle
                            {% if current_route starts with 'app_admin_commande_'
                                or current_route starts with 'app_admin_client_'
                            %}
                                nex-active
                            {% endif %}"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >

                            <i class="bi bi-cart-check-fill"></i>

                            <span>
                                Ventes
                            </span>

                        </a>


                        <ul class="dropdown-menu">


                            <li>

                                <a
                                    href="{{ path('app_admin_commande_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-receipt"></i>

                                    <span>
                                        Commandes
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a
                                    href="{{ path('app_admin_client_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-people-fill"></i>

                                    <span>
                                        Clients
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </li>


                    {# =================================================
                       ADMINISTRATION
                       ================================================= #}

                    <li class="nav-item dropdown">

                        <a
                            href="#"
                            class="nav-link dropdown-toggle
                            {% if current_route starts with 'app_admin_user_' %}
                                nex-active
                            {% endif %}"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >

                            <i class="bi bi-shield-lock-fill"></i>

                            <span>
                                Administration
                            </span>

                        </a>


                        <ul class="dropdown-menu">


                            <li>

                                <a
                                    href="{{ path('app_admin_user_index') }}"
                                    class="dropdown-item"
                                >

                                    <i class="bi bi-person-gear"></i>

                                    <span>
                                        Utilisateurs
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </li>


                </ul>


            {# =====================================================
               CLIENT
               ===================================================== #}

            {% else %}

                <ul class="navbar-nav me-auto mb-2 mb-xl-0">


                    {# DASHBOARD CLIENT #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_client_home') }}"
                            class="nav-link
                            {% if current_route == 'app_client_home' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-grid-1x2-fill"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>

                    </li>


                    {# PRODUITS CLIENT #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_client_produit_index') }}"
                            class="nav-link
                            {% if current_route starts with 'app_client_produit_' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-shop"></i>

                            <span>
                                Produits
                            </span>

                        </a>

                    </li>


                    {# PANIER CLIENT #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_client_cart') }}"
                            class="nav-link nex-cart-link
                            {% if current_route starts with 'app_client_cart' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-cart3"></i>

                            <span>
                                Panier
                            </span>


                            {% if panier_count is defined and panier_count > 0 %}

                                <span class="nex-cart-badge">
                                    {{ panier_count }}
                                </span>

                            {% endif %}

                        </a>

                    </li>


                    {# COMMANDES CLIENT #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_client_commandes') }}"
                            class="nav-link
                            {% if current_route starts with 'app_client_commande' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-receipt"></i>

                            <span>
                                Mes commandes
                            </span>

                        </a>

                    </li>


                    {# PROFIL CLIENT #}

                    <li class="nav-item">

                        <a
                            href="{{ path('app_client_profile') }}"
                            class="nav-link
                            {% if current_route starts with 'app_client_profile' %}
                                nex-active
                            {% endif %}"
                        >

                            <i class="bi bi-person-circle"></i>

                            <span>
                                Mon profil
                            </span>

                        </a>

                    </li>


                </ul>

            {% endif %}


            {# =====================================================
               USER CONNECTÉ
               ===================================================== #}

            {% if app.user %}

                <div class="nex-user-zone">


                    <div class="nex-user-pill">


                        <span class="nex-user-avatar">

                            <i class="bi bi-person-fill"></i>

                        </span>


                        <span class="nex-user-info">


                            <span class="nex-user-name">

                                {{ app.user.email|split('@')|first }}

                            </span>


                            <span class="nex-user-role">


                                {% if is_granted('ROLE_ADMIN') %}

                                    <span class="nex-role-badge admin">

                                        <i class="bi bi-shield-check"></i>

                                        Administrateur

                                    </span>

                                {% else %}

                                    <span class="nex-role-badge client">

                                        <i class="bi bi-person-check"></i>

                                        Client

                                    </span>

                                {% endif %}


                            </span>


                        </span>


                    </div>


                    {# LOGOUT #}

                    <a
                        href="{{ path('app_logout') }}"
                        class="nex-logout"
                        title="Déconnexion"
                        aria-label="Déconnexion"
                    >

                        <i class="bi bi-box-arrow-right"></i>

                    </a>


                </div>

            {% endif %}


        </div>

    </div>

</nav>


{# =============================================================
   FLASH MESSAGES
   ============================================================= #}

{% if app.flashes|length > 0 %}

    <div class="nex-alert-zone">

        {% for label, messages in app.flashes %}

            {% for message in messages %}

                <div
                    class="alert
                    {% if label == 'success' %}
                        alert-success
                    {% elseif label == 'danger' or label == 'error' %}
                        alert-danger
                    {% elseif label == 'warning' %}
                        alert-warning
                    {% else %}
                        alert-info
                    {% endif %}
                    alert-dismissible
                    fade
                    show
                    nex-alert
                    mb-2"
                    role="alert"
                >

                    <div class="d-flex align-items-center gap-2">


                        {% if label == 'success' %}

                            <i class="bi bi-check-circle-fill"></i>

                        {% elseif label == 'danger' or label == 'error' %}

                            <i class="bi bi-x-circle-fill"></i>

                        {% elseif label == 'warning' %}

                            <i class="bi bi-exclamation-triangle-fill"></i>

                        {% else %}

                            <i class="bi bi-info-circle-fill"></i>

                        {% endif %}


                        <span>
                            {{ message }}
                        </span>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fermer"
                    ></button>

                </div>

            {% endfor %}

        {% endfor %}

    </div>

{% endif %}


{# =============================================================
   CONTENU PRINCIPAL
   ============================================================= #}

<main class="nex-main">

    <div class="nex-content">

        {% block header_title %}{% endblock %}

        {% block body %}{% endblock %}

    </div>

</main>


{# =============================================================
   BOOTSTRAP JAVASCRIPT
   ============================================================= #}

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


{% block javascripts %}{% endblock %}

</body>

</html>

