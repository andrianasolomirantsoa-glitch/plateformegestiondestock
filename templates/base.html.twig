<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}Gestion de Stock{% endblock %}
    </title>
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background: #172033;
        }

        .sidebar .brand {
            font-size: 21px;
            font-weight: bold;
            color: white;
        }

        .sidebar .nav-link {
            color: #b9c1d0;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: .2s;
        }

        .sidebar .nav-link:hover {
            background: #263653;
            color: white;
        }

        .sidebar .nav-link.active {
            background: #263653;
            color: white;
        }

        .sidebar .nav-link.disabled {
            color: #697386;
            cursor: not-allowed;
            opacity: .7;
        }

        .topbar {
            background: white;
            border-bottom: 1px solid #e5e7eb;
            padding: 15px 25px;
        }

        .content {
            padding: 25px;
        }

        .page-title {
            font-weight: 700;
            color: #172033;
        }

        .card {
            border: 0;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
        }

        .table th {
            white-space: nowrap;
        }

        .badge-stock-normal {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-stock-low {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-stock-empty {
            background: #fee2e2;
            color: #991b1b;
        }

        @media (max-width: 767px) {
            .sidebar {
                min-height: auto;
            }

            .content {
                padding: 15px;
            }

            .topbar {
                padding: 15px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<div class="container-fluid">
    <div class="row">

        {# ==========================================================
           SIDEBAR
           ========================================================== #}

        <aside class="col-md-3 col-lg-2 p-3 sidebar">

            <div class="brand mb-4">
                <i class="bi bi-box-seam"></i>
                Gestion Stock
            </div>

            <nav class="nav flex-column">

                {# DASHBOARD #}

                <a
                    href="{{ path('app_dashboard') }}"
                    class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}"
                >
                    <i class="bi bi-speedometer2 me-2"></i>
                    Tableau de bord
                </a>


                {# PRODUITS #}

                <a
                    href="{{ path('app_produit_index') }}"
                    class="nav-link {% if app.request.attributes.get('_route') starts with 'app_produit_' %}active{% endif %}"
                >
                    <i class="bi bi-box me-2"></i>
                    Produits
                </a>


                {# CATEGORIES
                   Route pas encore créée
                #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-tags me-2"></i>
                    Catégories
                </a>


                {# ENTREES #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-arrow-down-circle me-2"></i>
                    Entrées de stock
                </a>


                {# SORTIES #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-arrow-up-circle me-2"></i>
                    Sorties de stock
                </a>


                {# CLIENTS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-people me-2"></i>
                    Clients
                </a>


                {# FOURNISSEURS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-truck me-2"></i>
                    Fournisseurs
                </a>


                <hr class="text-secondary">


                {# UTILISATEURS #}

                <a
                    href="#"
                    class="nav-link disabled"
                    onclick="return false;"
                    title="Module en préparation"
                >
                    <i class="bi bi-person me-2"></i>
                    Utilisateurs
                </a>

            </nav>

        </aside>


        {# ==========================================================
           CONTENU PRINCIPAL
           ========================================================== #}

        <main class="col-md-9 col-lg-10 p-0">

            {# TOPBAR #}

            <header class="topbar d-flex justify-content-between align-items-center">

                <div>
                    <strong>
                        {% block header_title %}
                            Gestion de Stock
                        {% endblock %}
                    </strong>
                </div>

                <div>

                    {% if app.user %}

                        <span class="me-3">
                            <i class="bi bi-person-circle"></i>
                            {{ app.user.email }}
                        </span>

                        <a
                            href="{{ path('app_logout') }}"
                            class="btn btn-outline-danger btn-sm"
                        >
                            <i class="bi bi-box-arrow-right"></i>
                            Déconnexion
                        </a>

                    {% endif %}

                </div>

            </header>


            {# CONTENU #}

            <div class="content">

                {# MESSAGES FLASH #}

                {% for label, messages in app.flashes %}

                    {% for message in messages %}

                        <div
                            class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show"
                            role="alert"
                        >

                            {{ message }}

                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Fermer"
                            ></button>

                        </div>

                    {% endfor %}

                {% endfor %}


                {# PAGE #}

                {% block body %}{% endblock %}

            </div>

        </main>

    </div>
</div>


{# BOOTSTRAP JS #}

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


{% block javascripts %}{% endblock %}

</body>
</html>

