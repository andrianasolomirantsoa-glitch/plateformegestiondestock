{% extends 'base.html.twig' %}

{% block title %}Gestion des catégories{% endblock %}

{% block body %}

<style>

    /* =========================================================
       PAGE CATEGORIES
       ========================================================= */

    .category-page {
        max-width: 1500px;
        margin: 0 auto;
    }


    /* =========================================================
       EN-TETE
       ========================================================= */

    .category-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 25px;
    }

    .category-header-left {
        min-width: 0;
    }

    .category-kicker {
        display: inline-flex;
        align-items: center;

        gap: 6px;

        margin-bottom: 6px;

        color: #2563eb;

        font-size: 11px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .category-header h1 {
        margin: 0;

        color: #172033;

        font-size: 28px;
        font-weight: 800;
    }

    .category-header p {
        margin: 7px 0 0;

        color: #7d8799;

        font-size: 12px;
    }

    .category-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 11px 15px;

        border-radius: 10px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s ease;
    }

    .category-add-button:hover {
        background: #263653;
        color: white;

        transform: translateY(-1px);
    }


    /* =========================================================
       STATISTIQUES
       ========================================================= */

    .category-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 17px;

        margin-bottom: 20px;
    }

    .category-stat {
        display: flex;
        align-items: center;

        gap: 13px;

        padding: 17px;

        background: white;

        border: 1px solid #edf0f5;
        border-radius: 14px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .category-stat-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 18px;
    }

    .category-stat-label {
        display: block;

        color: #8993a5;

        font-size: 9px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .category-stat-value {
        display: block;

        margin-top: 3px;

        color: #172033;

        font-size: 20px;
        font-weight: 900;
    }


    /* =========================================================
       OUTILS
       ========================================================= */

    .category-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        margin-bottom: 17px;
    }

    .category-search {
        position: relative;

        width: 100%;
        max-width: 500px;
    }

    .category-search i {
        position: absolute;

        left: 13px;
        top: 50%;

        transform: translateY(-50%);

        color: #8a94a6;

        font-size: 14px;
    }

    .category-search input {
        width: 100%;

        padding: 11px 14px 11px 37px;

        border: 1px solid #dde3ed;
        border-radius: 10px;

        background: white;

        color: #172033;

        outline: none;

        font-size: 11px;
    }

    .category-search input:focus {
        border-color: #93b4ff;

        box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
    }

    .category-result-info {
        color: #8993a5;

        font-size: 10px;

        white-space: nowrap;
    }


    /* =========================================================
       TABLEAU
       ========================================================= */

    .category-card {
        overflow: hidden;

        background: white;

        border: 1px solid #edf0f5;
        border-radius: 16px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .category-table-wrapper {
        overflow-x: auto;
    }

    .category-table {
        width: 100%;

        margin: 0;

        border-collapse: collapse;
    }

    .category-table thead th {
        padding: 14px 18px;

        background: #f8fafc;

        border-bottom: 1px solid #edf0f5;

        color: #7b8597;

        font-size: 9px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .05em;

        white-space: nowrap;
    }

    .category-table tbody td {
        padding: 16px 18px;

        border-bottom: 1px solid #f0f2f6;

        vertical-align: middle;

        color: #4c5668;

        font-size: 11px;
    }

    .category-table tbody tr:last-child td {
        border-bottom: none;
    }

    .category-table tbody tr {
        transition: .15s ease;
    }

    .category-table tbody tr:hover {
        background: #fbfcfe;
    }


    /* =========================================================
       NOM CATEGORIE
       ========================================================= */

    .category-name-box {
        display: flex;
        align-items: center;

        gap: 11px;
    }

    .category-icon {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 16px;
    }

    .category-name {
        color: #172033;

        font-size: 12px;
        font-weight: 800;
    }

    .category-id {
        margin-top: 3px;

        color: #9aa3b2;

        font-size: 9px;
    }


    /* =========================================================
       DESCRIPTION
       ========================================================= */

    .category-description {
        max-width: 350px;

        color: #737e90;

        line-height: 1.5;
    }

    .category-description.empty {
        color: #a4acb9;
        font-style: italic;
    }


    /* =========================================================
       PRODUITS
       ========================================================= */

    .product-count {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 9px;

        border-radius: 30px;

        background: #f4f6fa;
        color: #566174;

        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================================
       STATUT
       ========================================================= */

    .category-status {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 9px;

        border-radius: 30px;

        font-size: 9px;
        font-weight: 800;
    }

    .category-status.active {
        background: #ecfdf3;
        color: #15803d;
    }

    .category-status.inactive {
        background: #fef2f2;
        color: #b91c1c;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .category-actions {
        display: flex;
        align-items: center;

        gap: 6px;

        white-space: nowrap;
    }

    .category-action {
        width: 32px;
        height: 32px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        text-decoration: none;

        font-size: 13px;

        transition: .15s ease;
    }

    .category-action-edit {
        background: #eff6ff;
        color: #2563eb;
    }

    .category-action-edit:hover {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .category-action-toggle-on {
        border: 0;

        background: #fff7ed;
        color: #c2410c;

        cursor: pointer;
    }

    .category-action-toggle-on:hover {
        background: #ffedd5;
    }

    .category-action-toggle-off {
        border: 0;

        background: #ecfdf3;
        color: #15803d;

        cursor: pointer;
    }

    .category-action-toggle-off:hover {
        background: #dcfce7;
    }


    /* =========================================================
       EMPTY
       ========================================================= */

    .category-empty {
        padding: 55px 20px;

        text-align: center;
    }

    .category-empty-icon {
        width: 65px;
        height: 65px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 15px;

        border-radius: 18px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 28px;
    }

    .category-empty h3 {
        margin: 0 0 6px;

        color: #172033;

        font-size: 17px;
        font-weight: 800;
    }

    .category-empty p {
        margin: 0 auto 17px;

        max-width: 450px;

        color: #8791a3;

        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1000px) {

        .category-stats {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @media (max-width: 700px) {

        .category-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .category-add-button {
            width: 100%;
        }

        .category-stats {
            grid-template-columns: 1fr;
        }

        .category-tools {
            align-items: flex-start;

            flex-direction: column;
        }

        .category-search {
            max-width: none;
        }

        .category-result-info {
            white-space: normal;
        }

    }

</style>

<div class="category-page">


{# =========================================================
   EN-TETE
   ========================================================= #}

<div class="category-header">

    <div class="category-header-left">

        <span class="category-kicker">
            <i class="bi bi-tags"></i>
            Administration
        </span>

        <h1>
            Catégories
        </h1>

        <p>
            Organisez vos produits et gérez les catégories du catalogue.
        </p>

    </div>


    <a
        href="{{ path('app_categorie_new') }}"
        class="category-add-button"
    >
        <i class="bi bi-plus-lg"></i>
        Nouvelle catégorie
    </a>

</div>


{# =========================================================
   STATISTIQUES
   ========================================================= #}

{% set totalCategories = categories|length %}
{% set categoriesActives = 0 %}
{% set categoriesInactives = 0 %}
{% set totalProduits = 0 %}

{% for categorie in categories %}

    {% if categorie.actif %}
        {% set categoriesActives = categoriesActives + 1 %}
    {% else %}
        {% set categoriesInactives = categoriesInactives + 1 %}
    {% endif %}

    {% set totalProduits = totalProduits + categorie.produits|length %}

{% endfor %}


<div class="category-stats">


    <div class="category-stat">

        <div class="category-stat-icon">
            <i class="bi bi-tags"></i>
        </div>

        <div>

            <span class="category-stat-label">
                Total catégories
            </span>

            <span class="category-stat-value">
                {{ totalCategories }}
            </span>

        </div>

    </div>


    <div class="category-stat">

        <div class="category-stat-icon">
            <i class="bi bi-check-circle"></i>
        </div>

        <div>

            <span class="category-stat-label">
                Catégories actives
            </span>

            <span class="category-stat-value">
                {{ categoriesActives }}
            </span>

        </div>

    </div>


    <div class="category-stat">

        <div class="category-stat-icon">
            <i class="bi bi-box-seam"></i>
        </div>

        <div>

            <span class="category-stat-label">
                Produits classés
            </span>

            <span class="category-stat-value">
                {{ totalProduits }}
            </span>

        </div>

    </div>

</div>


{# =========================================================
   RECHERCHE
   ========================================================= #}

<div class="category-tools">

    <form
        method="GET"
        action="{{ path('app_categorie_index') }}"
        class="category-search"
    >

        <i class="bi bi-search"></i>

        <input
            type="search"
            name="search"
            value="{{ search }}"
            placeholder="Rechercher une catégorie..."
            autocomplete="off"
        >

    </form>


    <div class="category-result-info">

        {{ totalCategories }}

        catégorie{% if totalCategories != 1 %}s{% endif %}

        {% if search %}
            pour « {{ search }} »
        {% endif %}

    </div>

</div>


{# =========================================================
   TABLEAU
   ========================================================= #}

<div class="category-card">

    {% if categories is not empty %}

        <div class="category-table-wrapper">

            <table class="category-table">

                <thead>

                    <tr>

                        <th>
                            Catégorie
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Produits
                        </th>

                        <th>
                            Créée le
                        </th>

                        <th>
                            Statut
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {% for categorie in categories %}

                        <tr>


                            {# CATEGORIE #}

                            <td>

                                <div class="category-name-box">

                                    <div class="category-icon">
                                        <i class="bi bi-tag"></i>
                                    </div>

                                    <div>

                                        <div class="category-name">
                                            {{ categorie.nom }}
                                        </div>

                                        <div class="category-id">
                                            ID #{{ categorie.id }}
                                        </div>

                                    </div>

                                </div>

                            </td>


                            {# DESCRIPTION #}

                            <td>

                                {% if categorie.description %}

                                    <div class="category-description">

                                        {% if categorie.description|length > 100 %}

                                            {{ categorie.description|slice(0, 100) }}...

                                        {% else %}

                                            {{ categorie.description }}

                                        {% endif %}

                                    </div>

                                {% else %}

                                    <div class="category-description empty">
                                        Aucune description
                                    </div>

                                {% endif %}

                            </td>


                            {# PRODUITS #}

                            <td>

                                <span class="product-count">

                                    <i class="bi bi-box"></i>

                                    {{ categorie.produits|length }}

                                    produit{% if categorie.produits|length != 1 %}s{% endif %}

                                </span>

                            </td>


                            {# DATE #}

                            <td>

                                {% if categorie.createdAt %}

                                    {{ categorie.createdAt|date('d/m/Y') }}

                                {% else %}

                                    -

                                {% endif %}

                            </td>


                            {# STATUT #}

                            <td>

                                {% if categorie.actif %}

                                    <span class="category-status active">

                                        <i class="bi bi-check-circle"></i>

                                        Active

                                    </span>

                                {% else %}

                                    <span class="category-status inactive">

                                        <i class="bi bi-x-circle"></i>

                                        Inactive

                                    </span>

                                {% endif %}

                            </td>


                            {# ACTIONS #}

                            <td>

                                <div class="category-actions">


                                    {# MODIFIER #}

                                    <a
                                        href="{{ path('app_categorie_edit', {
                                            id: categorie.id
                                        }) }}"
                                        class="category-action category-action-edit"
                                        title="Modifier"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>


                                    {# ACTIVER / DESACTIVER #}

                                    <form
                                        method="POST"
                                        action="{{ path('app_categorie_toggle', {
                                            id: categorie.id
                                        }) }}"
                                        class="d-inline"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('toggle_categorie_' ~ categorie.id) }}"
                                        >


                                        {% if categorie.actif %}

                                            <button
                                                type="submit"
                                                class="category-action category-action-toggle-on"
                                                title="Désactiver"
                                                onclick="return confirm('Voulez-vous désactiver cette catégorie ?');"
                                            >
                                                <i class="bi bi-toggle-on"></i>
                                            </button>

                                        {% else %}

                                            <button
                                                type="submit"
                                                class="category-action category-action-toggle-off"
                                                title="Activer"
                                            >
                                                <i class="bi bi-toggle-off"></i>
                                            </button>

                                        {% endif %}

                                    </form>

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>


    {% else %}


        {# =================================================
           AUCUNE CATEGORIE
           ================================================= #}

        <div class="category-empty">

            <div class="category-empty-icon">
                <i class="bi bi-tags"></i>
            </div>

            {% if search %}

                <h3>
                    Aucune catégorie trouvée
                </h3>

                <p>
                    Aucun résultat ne correspond à votre recherche
                    « {{ search }} ».
                </p>

                <a
                    href="{{ path('app_categorie_index') }}"
                    class="category-add-button"
                >
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Réinitialiser la recherche
                </a>

            {% else %}

                <h3>
                    Aucune catégorie
                </h3>

                <p>
                    Commencez par créer votre première catégorie
                    pour organiser les produits du catalogue.
                </p>

                <a
                    href="{{ path('app_categorie_new') }}"
                    class="category-add-button"
                >
                    <i class="bi bi-plus-lg"></i>
                    Créer une catégorie
                </a>

            {% endif %}

        </div>


    {% endif %}

</div>


</div>

{% endblock %}
