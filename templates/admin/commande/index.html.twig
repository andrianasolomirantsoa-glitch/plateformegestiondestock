{% extends 'base.html.twig' %}

{% block title %}
    Gestion des commandes
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>
            <h1 class="page-title">
                Gestion des commandes
            </h1>

            <p class="dashboard-subtitle">
                Consultez et gérez les commandes des clients.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>
                Liste des commandes
            </h2>

            <p class="text-muted mb-0">
                {{ commandes|length }}
                commande{% if commandes|length > 1 %}s{% endif %}
            </p>
        </div>

        <a
            href="{{ path('app_dashboard') }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Retour au tableau de bord
        </a>

    </div>

    {% if commandes is empty %}

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <i
                    class="bi bi-receipt text-muted"
                    style="font-size: 70px;"
                ></i>

                <h3 class="mt-3">
                    Aucune commande
                </h3>

                <p class="text-muted mb-0">
                    Aucune commande n'a encore été enregistrée.
                </p>

            </div>

        </div>

    {% else %}

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Numéro</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            {% for commande in commandes %}

                                <tr>

                                    <td>
                                        <strong>
                                            {{ commande.numero }}
                                        </strong>
                                    </td>

                                    <td>

                                        {% if commande.user %}

                                            <strong>
                                                {{ commande.user.prenom }}
                                                {{ commande.user.nom }}
                                            </strong>

                                            <small class="text-muted d-block">
                                                {{ commande.user.email }}
                                            </small>

                                        {% else %}

                                            <span class="text-muted">
                                                Client inconnu
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td>
                                        {{ commande.createdAt|date('d/m/Y H:i') }}
                                    </td>

                                    <td>

                                        {% if commande.statut == 'EN_ATTENTE' %}

                                            <span class="badge bg-warning text-dark">
                                                En attente
                                            </span>

                                        {% elseif commande.statut == 'CONFIRMEE' %}

                                            <span class="badge bg-success">
                                                Confirmée
                                            </span>

                                        {% elseif commande.statut == 'ANNULEE' %}

                                            <span class="badge bg-danger">
                                                Annulée
                                            </span>

                                        {% else %}

                                            <span class="badge bg-secondary">
                                                {{ commande.statut }}
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td class="text-end">

                                        <strong class="text-primary">
                                            {{ commande.total|number_format(2, ',', ' ') }}
                                            Ar
                                        </strong>

                                    </td>

                                    <td class="text-center">

                                        <a
                                            href="{{ path(
                                                'app_admin_commande_show',
                                                {'id': commande.id}
                                            ) }}"
                                            class="btn btn-outline-primary btn-sm"
                                        >
                                            <i class="bi bi-eye"></i>
                                            Voir
                                        </a>

                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}

