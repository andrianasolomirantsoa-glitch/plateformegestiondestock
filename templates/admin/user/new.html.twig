{% extends 'base.html.twig' %}

{% block title %}
    Ajouter un administrateur
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>

            <h1 class="page-title">
                Ajouter un administrateur
            </h1>

            <p class="dashboard-subtitle">
                Créez un nouveau compte avec accès à l'administration.
            </p>

        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<style>
    .admin-form-card {
        max-width: 760px;
        margin: 0 auto;
        border: 0;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
    }

    .admin-form-header {
        padding: 35px;
        background: linear-gradient(
            135deg,
            #2563eb,
            #4f46e5
        );
        color: white;
    }

    .admin-form-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 28px;
    }

    .admin-form-body {
        padding: 30px;
        background: #ffffff;
    }

    .admin-form-body .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #334155;
    }

    .admin-form-body .form-control {
        min-height: 47px;
        border-radius: 12px;
    }

    .admin-form-body .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.12);
    }

    .role-box {
        padding: 15px 17px;
        border-radius: 13px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
    }

    .role-box-title {
        color: #1d4ed8;
        font-weight: 750;
        font-size: 13px;
    }

    .role-box-text {
        color: #64748b;
        font-size: 12px;
        margin-top: 3px;
    }

    @media (max-width: 767.98px) {

        .admin-form-header,
        .admin-form-body {
            padding: 25px 20px;
        }

    }
</style>

<div class="container py-4">

    <div class="mb-4">

        <a
            href="{{ path('app_admin_user_index') }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Retour aux administrateurs
        </a>

    </div>

    <div class="admin-form-card">

        <div class="admin-form-header">

            <div class="admin-form-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h2 class="mt-3 mb-2">
                Nouveau compte administrateur
            </h2>

            <p class="mb-0 text-white-50">
                Ce compte pourra accéder aux fonctionnalités
                d'administration de la plateforme.
            </p>

        </div>

        <div class="admin-form-body">

            <form method="post">

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('ajouter_admin') }}"
                >

                <div class="row g-4">

                    <div class="col-md-6">

                        <label
                            for="nom"
                            class="form-label"
                        >
                            Nom
                        </label>

                        <input
                            type="text"
                            id="nom"
                            name="nom"
                            class="form-control"
                            maxlength="100"
                            required
                        >

                    </div>

                    <div class="col-md-6">

                        <label
                            for="prenom"
                            class="form-label"
                        >
                            Prénom
                        </label>

                        <input
                            type="text"
                            id="prenom"
                            name="prenom"
                            class="form-control"
                            maxlength="100"
                            required
                        >

                    </div>

                    <div class="col-12">

                        <label
                            for="email"
                            class="form-label"
                        >
                            Adresse e-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            maxlength="180"
                            autocomplete="email"
                            required
                        >

                    </div>

                    <div class="col-md-6">

                        <label
                            for="password"
                            class="form-label"
                        >
                            Mot de passe
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            minlength="8"
                            autocomplete="new-password"
                            required
                        >

                        <small class="text-muted">
                            Minimum 8 caractères.
                        </small>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Rôle
                        </label>

                        <div class="role-box">

                            <div class="role-box-title">
                                <i class="bi bi-shield-check"></i>
                                Administrateur
                            </div>

                            <div class="role-box-text">
                                Le rôle sera automatiquement défini sur
                                ROLE_ADMIN.
                            </div>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a
                        href="{{ path('app_admin_user_index') }}"
                        class="btn btn-outline-secondary"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary px-4"
                    >
                        <i class="bi bi-person-plus"></i>
                        Créer l'administrateur
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

{% endblock %}

