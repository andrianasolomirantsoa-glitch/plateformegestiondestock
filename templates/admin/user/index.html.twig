{% extends 'base.html.twig' %}

{% block title %}
    Gestion des administrateurs
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>

            <h1 class="page-title">
                Gestion des administrateurs
            </h1>

            <p class="dashboard-subtitle">
                Gérez les comptes ayant accès à l'administration.
            </p>

        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <h2>
                Administrateurs
            </h2>

            <p class="text-muted mb-0">
                {{ admins|length }}
                administrateur{% if admins|length > 1 %}s{% endif %}
            </p>

        </div>

        <div class="d-flex gap-2">

            <a
                href="{{ path('app_dashboard') }}"
                class="btn btn-outline-secondary"
            >
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

            <a
                href="{{ path('app_admin_user_new') }}"
                class="btn btn-primary"
            >
                <i class="bi bi-person-plus"></i>
                Ajouter
            </a>

        </div>

    </div>

    {% if admins is empty %}

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <i
                    class="bi bi-people text-muted"
                    style="font-size: 70px;"
                ></i>

                <h3 class="mt-3">
                    Aucun administrateur
                </h3>

            </div>

        </div>

    {% else %}

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>
                                <th>Administrateur</th>
                                <th>Email</th>
                                <th>Statut</th>
                                <th>Date création</th>
                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            {% for admin in admins %}

                                <tr>

                                    <td>
                                        #{{ admin.id }}
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div
                                                class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                                                style="width: 42px; height: 42px;"
                                            >
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div>

                                                <strong>
                                                    {{ admin.prenom }}
                                                    {{ admin.nom }}
                                                </strong>

                                                <small class="text-muted d-block">
                                                    Administrateur
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        {{ admin.email }}
                                    </td>

                                    <td>

                                        {% if admin.actif %}

                                            <span class="badge bg-success">
                                                Actif
                                            </span>

                                        {% else %}

                                            <span class="badge bg-danger">
                                                Inactif
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td>
                                        {{ admin.createdAt|date('d/m/Y H:i') }}
                                    </td>

                                    <td class="text-center">

                                        <a
                                            href="{{ path(
                                                'app_admin_user_edit',
                                                {'id': admin.id}
                                            ) }}"
                                            class="btn btn-outline-primary btn-sm"
                                        >
                                            <i class="bi bi-pencil"></i>
                                            Modifier
                                        </a>

                                        {% if app.user and app.user.id != admin.id %}

                                            <form
                                                action="{{ path(
                                                    'app_admin_user_toggle',
                                                    {'id': admin.id}
                                                ) }}"
                                                method="post"
                                                class="d-inline"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('statut_admin_' ~ admin.id) }}"
                                                >

                                                {% if admin.actif %}

                                                    <button
                                                        type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                    >
                                                        <i class="bi bi-person-slash"></i>
                                                        Désactiver
                                                    </button>

                                                {% else %}

                                                    <button
                                                        type="submit"
                                                        class="btn btn-outline-success btn-sm"
                                                    >
                                                        <i class="bi bi-person-check"></i>
                                                        Activer
                                                    </button>

                                                {% endif %}

                                            </form>

                                        {% else %}

                                            <span
                                                class="badge bg-secondary"
                                                title="Vous ne pouvez pas désactiver votre propre compte."
                                            >
                                                Compte actuel
                                            </span>

                                        {% endif %}

                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}

