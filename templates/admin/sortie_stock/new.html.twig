</style>


{# =============================================================
   JAVASCRIPT
   ============================================================= #}
<script>


document.addEventListener('DOMContentLoaded', function () {

    const produitSelect = document.getElementById('produit');
    const magasinSelect = document.getElementById('magasin');
    const quantiteInput = document.getElementById('quantite');

    const stockActuelElement = document.getElementById('stockActuel');
    const quantiteSortieElement = document.getElementById('quantiteSortie');
    const nouveauStockElement = document.getElementById('nouveauStock');

    const formulaStock = document.getElementById('formulaStock');
    const formulaResult = document.getElementById('formulaResult');
    const exampleText = document.getElementById('exampleText');

    const stockInfoMessage = document.getElementById('stockInfoMessage');
    const stockAlert = document.getElementById('stockAlert');
    const stockAlertText = document.getElementById('stockAlertText');

    const quantityHelp = document.getElementById('quantiteHelp');
    const submitButton = document.getElementById('submitButton');
    const form = document.querySelector('form');

    /*
     * Stocks réels par couple produit-magasin.
     * Les données proviennent du contrôleur Symfony.
     */
    const stocksParProduitMagasin = {{ stocksParProduitMagasin|json_encode|raw }};

    /*
     * Récupérer le stock du couple sélectionné.
     *
     * null signifie qu'aucun enregistrement
     * StockMagasin n'existe pour ce couple.
     */
    function getStockProduitMagasin() {

        const produitId = produitSelect.value;
        const magasinId = magasinSelect.value;

        if (!produitId || !magasinId) {
            return null;
        }

        const key = `${produitId}-${magasinId}`;

        if (
            !Object.prototype.hasOwnProperty.call(
                stocksParProduitMagasin,
                key
            )
        ) {
            return null;
        }

        return Number(stocksParProduitMagasin[key]);
    }

    /*
     * Afficher un message dans la carte de stock.
     */
    function afficherMessage(type, message) {

        let icon = 'bi-info-circle-fill';

        if (type === 'warning') {
            icon = 'bi-exclamation-triangle-fill';
        } else if (type === 'good') {
            icon = 'bi-check-circle-fill';
        }

        stockInfoMessage.className = `stock-message ${type}`;

        stockInfoMessage.innerHTML = `
            <i class="bi ${icon}"></i>
            <span>${message}</span>
        `;
    }

    /*
     * Réinitialiser l'aperçu.
     */
    function reinitialiserApercu(message) {

        stockActuelElement.textContent = '0';
        quantiteSortieElement.textContent = '0';
        nouveauStockElement.textContent = '0';

        formulaStock.textContent = '0';
        formulaResult.textContent = '0';

        exampleText.innerHTML = `
            <i class="bi bi-info-circle me-1"></i>
            ${message}
        `;

        stockAlert.style.display = 'none';

        quantityHelp.textContent = message;
        quantityHelp.className = 'quantity-help';

        afficherMessage('',
            message
        );

        submitButton.disabled = true;
    }

    /*
     * Mise à jour complète de l'aperçu.
     */
    function mettreAJourStock() {

        const produitId = produitSelect.value;
        const magasinId = magasinSelect.value;

        let quantite = parseInt(
            quantiteInput.value || '0',
            10
        );

        if (isNaN(quantite) || quantite < 0) {
            quantite = 0;
        }

        quantiteSortieElement.textContent = quantite;

        /*
         * Il faut sélectionner un magasin et un produit.
         */
        if (!magasinId || !produitId) {

            reinitialiserApercu(
                'Sélectionnez un magasin et un produit pour consulter le stock.'
            );

            return;
        }

        /*
         * Récupération du stock du couple.
         */
        const stockActuel = getStockProduitMagasin();

        /*
         * Aucun stock enregistré pour ce couple.
         * On ne crée pas de stock automatiquement.
         */
        if (stockActuel === null) {

            stockActuelElement.textContent = '—';
            quantiteSortieElement.textContent = quantite;
            nouveauStockElement.textContent = '—';

            formulaStock.textContent = '—';
            formulaResult.textContent = '—';

            quantityHelp.textContent =
                'Aucun stock enregistré pour ce produit dans ce magasin.';

            quantityHelp.className = 'quantity-help danger';

            afficherMessage(
                'warning',
                'Aucun stock enregistré pour ce produit dans le magasin sélectionné. Cette sortie ne peut pas être enregistrée.'
            );

            stockAlert.style.display = 'flex';

            stockAlertText.textContent =
                'Aucun enregistrement de stock disponible pour ce couple produit-magasin.';

            exampleText.innerHTML = `
                <i class="bi bi-exclamation-circle me-1"></i>
                Stock non disponible pour ce couple.
            `;

            submitButton.disabled = true;

            return;
        }

        /*
         * Affichage du stock actuel.
         */
        stockActuelElement.textContent = stockActuel;
        formulaStock.textContent = stockActuel;

        /*
         * Calcul du stock après sortie.
         */
        const nouveauStock = stockActuel - quantite;

        nouveauStockElement.textContent = nouveauStock;
        formulaResult.textContent = nouveauStock;

        /*
         * Quantité non renseignée.
         */
        if (quantite <= 0) {

            quantityHelp.textContent =
                `Stock disponible : ${stockActuel} pièce(s). Saisissez une quantité à sortir.`;

            quantityHelp.className = 'quantity-help';

            afficherMessage(
                '',
                `Le stock actuel est de ${stockActuel} pièce(s). Saisissez la quantité à sortir.`
            );

            stockAlert.style.display = 'none';

            submitButton.disabled = true;

        }

        /*
         * Stock insuffisant.
         */
        else if (quantite > stockActuel) {

            quantityHelp.textContent =
                `Stock insuffisant : seulement ${stockActuel} pièce(s) disponibles.`;

            quantityHelp.className = 'quantity-help danger';

            afficherMessage(
                'warning',
                `Vous demandez ${quantite} pièce(s), alors que le stock disponible est de ${stockActuel} pièce(s). La sortie ne peut pas être enregistrée.`
            );

            stockAlert.style.display = 'flex';

            stockAlertText.textContent =
                `Quantité demandée : ${quantite} pièce(s). Stock disponible : ${stockActuel} pièce(s).`;

            submitButton.disabled = true;

        }

        /*
         * Quantité valide.
         */
        else {

            quantityHelp.textContent =
                `Stock disponible : ${stockActuel} pièce(s).`;

            quantityHelp.className = 'quantity-help success';

            afficherMessage(
                'good',
                `Calcul : ${stockActuel} − ${quantite} = ${nouveauStock} pièce(s). La quantité demandée est disponible.`
            );

            stockAlert.style.display = 'none';

            submitButton.disabled = false;

        }

        /*
         * Exemple dynamique.
         */
        exampleText.innerHTML = `
            <i class="bi bi-check-circle me-1"></i>
            ${stockActuel} − ${quantite} = ${nouveauStock} pièce(s)
        `;
    }

    /*
     * Changement du magasin.
     */
    magasinSelect.addEventListener(
        'change',
        mettreAJourStock
    );

    /*
     * Changement du produit.
     */
    produitSelect.addEventListener(
        'change',
        mettreAJourStock
    );

    /*
     * Changement de quantité.
     */
    quantiteInput.addEventListener(
        'input',
        mettreAJourStock
    );

    quantiteInput.addEventListener(
        'change',
        mettreAJourStock
    );

    /*
     * Vérification finale avant soumission.
     */
    form.addEventListener('submit', function (event) {

        const stock = getStockProduitMagasin();

        const quantite = parseInt(
            quantiteInput.value || '0',
            10
        );

        if (
            !magasinSelect.value ||
            !produitSelect.value ||
            stock === null ||
            isNaN(quantite) ||
            quantite <= 0 ||
            quantite > stock
        ) {

            event.preventDefault();

            mettreAJourStock();
        }
    });

    /*
     * Calcul initial.
     */
    mettreAJourStock();

});


</script>

{% endblock %}

