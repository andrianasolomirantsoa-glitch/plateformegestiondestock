        margin-top: 8px;
        padding-top: 10px;
        border-top: 1px solid #e2e8f0;
    }

    .formula-total strong {
        color: #be123c;
    }

    .example-text {
        margin-top: 14px;
        color: #64748b;
        font-size: 11px;
    }

    .example-text i {
        color: #059669;
    }


    /* =========================================================
       STOCK ALERT
       ========================================================= */

    .stock-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px;
        border-color: #fecaca;
        background: #fef2f2;
    }

    .stock-alert-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
