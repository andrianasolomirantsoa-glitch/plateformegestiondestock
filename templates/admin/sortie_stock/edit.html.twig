</style>


{# =============================================================
   JAVASCRIPT
   ============================================================= #}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const produitSelect = document.getElementById('produit');
    const magasinSelect = document.getElementById('magasin');
    const quantiteInput = document.getElementById('quantite');

    const stockActuelElement = document.getElementById('stockActuel');
    const ancienneQuantiteElement = document.getElementById('ancienneQuantite');
    const stockAvantSortieElement = document.getElementById('stockAvantSortie');
    const nouvelleQuantiteElement = document.getElementById('nouvelleQuantite');
    const nouveauStockElement = document.getElementById('nouveauStock');

    const formulaStock = document.getElementById('formulaStock');
    const formulaResult = document.getElementById('formulaResult');
    const exampleText = document.getElementById('exampleText');

    const stockInfoMessage = document.getElementById('stockInfoMessage');
    const stockAlert = document.getElementById('stockAlert');
    const stockAlertText = document.getElementById('stockAlertText');
    const stockResultText = document.getElementById('stockResultText');
    const quantityHelp = document.getElementById('quantiteHelp');

    const submitButton = document.getElementById('submitButton');
    const form = document.querySelector('form');

    // Stocks réels enregistrés par produit et par magasin.
    const stocksParProduitMagasin = {{ stocksParProduitMagasin|json_encode|raw }};

    // Informations de la sortie actuellement modifiée.
    const ancienneQuantite = {{ sortie.quantite }};
    const ancienProduitId = {{ sortie.produit ? sortie.produit.id : 0 }};
    const ancienMagasinId = {{ sortie.magasin ? sortie.magasin.id : 0 }};

    function obtenirStock(produitId, magasinId) {
        if (!produitId || !magasinId) {
            return null;
        }

        const cle = `${produitId}-${magasinId}`;

        if (!Object.prototype.hasOwnProperty.call(stocksParProduitMagasin, cle)) {
            return null;
        }

        return Number(stocksParProduitMagasin[cle]);
    }

    function afficherMessage(type, message) {
        let icon = 'bi-info-circle-fill';

        if (type === 'warning') {
            icon = 'bi-exclamation-triangle-fill';
        } else if (type === 'good') {
            icon = 'bi-check-circle-fill';
        }

        stockInfoMessage.className = `stock-message ${type}`;
        stockInfoMessage.innerHTML =
            `<i class="bi ${icon}"></i><span>${message}</span>`;
    }

    function bloquerModification(message) {
        stockActuelElement.textContent = '—';
        stockAvantSortieElement.textContent = '—';
        nouveauStockElement.textContent = '—';
        formulaStock.textContent = '—';
        formulaResult.textContent = '—';

        quantityHelp.textContent = message;
        quantityHelp.className = 'quantity-help danger';

        afficherMessage('warning', message);

        stockAlert.style.display = 'flex';
        stockAlertText.textContent = message;

        if (stockResultText) {
            stockResultText.textContent = message;
        }

        exampleText.innerHTML =
            `<i class="bi bi-exclamation-circle me-1"></i>${message}`;

        submitButton.disabled = true;
    }

    function mettreAJourStock() {
        const produitId = Number(produitSelect.value || 0);
        const magasinId = Number(magasinSelect.value || 0);

        let nouvelleQuantite = parseInt(quantiteInput.value || '0', 10);

        if (isNaN(nouvelleQuantite) || nouvelleQuantite < 0) {
            nouvelleQuantite = 0;
        }

        ancienneQuantiteElement.textContent = ancienneQuantite;
        nouvelleQuantiteElement.textContent = nouvelleQuantite;

        if (!produitId || !magasinId) {
            bloquerModification(
                'Sélectionnez un magasin et un produit pour consulter le stock.'
            );
            return;
        }

        const stockActuel = obtenirStock(produitId, magasinId);

        if (stockActuel === null) {
            stockActuelElement.textContent = '—';

            bloquerModification(
                'Aucun stock enregistré pour ce produit dans le magasin sélectionné. La modification est impossible.'
            );
            return;
        }

        // Vérifier si on conserve exactement le même produit et le même magasin.
        const memeCouple =
            produitId === ancienProduitId &&
            magasinId === ancienMagasinId;

        // Si le couple est identique, on réintègre l'ancienne sortie
        // uniquement pour calculer la quantité disponible.
        const stockDisponible = memeCouple
            ? stockActuel + ancienneQuantite
            : stockActuel;

        const nouveauStock = stockDisponible - nouvelleQuantite;

        stockActuelElement.textContent = stockActuel;
        stockAvantSortieElement.textContent = stockDisponible;
        nouveauStockElement.textContent = nouveauStock;
        formulaStock.textContent = stockDisponible;
        formulaResult.textContent = nouveauStock;

        if (nouvelleQuantite <= 0) {
            quantityHelp.textContent =
                `Saisissez une quantité positive. Stock disponible : ${stockDisponible} pièce(s).`;

            quantityHelp.className = 'quantity-help';

            afficherMessage(
                '',
                `Stock disponible pour cette modification : ${stockDisponible} pièce(s).`
            );

            stockAlert.style.display = 'none';
            submitButton.disabled = true;

        } else if (nouvelleQuantite > stockDisponible) {
            quantityHelp.textContent =
                `Stock insuffisant : seulement ${stockDisponible} pièce(s) disponibles.`;

            quantityHelp.className = 'quantity-help danger';

            afficherMessage(
                'warning',
                `Quantité demandée : ${nouvelleQuantite}. Stock disponible : ${stockDisponible}.`
            );

            stockAlert.style.display = 'flex';

            stockAlertText.textContent =
                `Vous demandez ${nouvelleQuantite} pièce(s), mais seulement ${stockDisponible} sont disponibles.`;

            if (stockResultText) {
                stockResultText.textContent =
                    'Stock insuffisant pour cette modification.';
            }

            submitButton.disabled = true;

        } else {
            quantityHelp.textContent =
                `Stock disponible : ${stockDisponible} pièce(s).`;

            quantityHelp.className = 'quantity-help success';

            afficherMessage(
                'good',
                `Calcul : ${stockDisponible} − ${nouvelleQuantite} = ${nouveauStock} pièce(s).`
            );

            stockAlert.style.display = 'none';
            submitButton.disabled = false;

            if (stockResultText) {
                stockResultText.textContent =
                    `Le nouveau stock sera de ${nouveauStock} pièce(s).`;
            }
        }

        exampleText.innerHTML =
            `<i class="bi bi-check-circle me-1"></i>${stockDisponible} − ${nouvelleQuantite} = ${nouveauStock} pièce(s)`;
    }

    magasinSelect.addEventListener('change', mettreAJourStock);
    produitSelect.addEventListener('change', mettreAJourStock);
    quantiteInput.addEventListener('input', mettreAJourStock);
    quantiteInput.addEventListener('change', mettreAJourStock);

    form.addEventListener('submit', function (event) {
        const produitId = Number(produitSelect.value || 0);
        const magasinId = Number(magasinSelect.value || 0);
        const stockActuel = obtenirStock(produitId, magasinId);
        const nouvelleQuantite = parseInt(quantiteInput.value || '0', 10);

        const memeCouple =
            produitId === ancienProduitId &&
            magasinId === ancienMagasinId;

        const stockDisponible =
            stockActuel === null
                ? null
                : (memeCouple
                    ? stockActuel + ancienneQuantite
                    : stockActuel);

        if (
            !produitId ||
            !magasinId ||
            stockDisponible === null ||
            isNaN(nouvelleQuantite) ||
            nouvelleQuantite <= 0 ||
            nouvelleQuantite > stockDisponible
        ) {
            event.preventDefault();
            mettreAJourStock();
        }
    });

    mettreAJourStock();
});
</script>



{% endblock %}

