{% extends 'base.html.twig' %}

{% block title %}
    Gestion des clients
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">

        <div>
            <h1 class="page-title">
                Gestion des clients
            </h1>

            <p class="dashboard-subtitle">
                Consultez et gérez les clients enregistrés.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>

    </div>
{% endblock %}

{% block body %}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="mb-1">
                Clients
            </h2>

            <p class="text-muted mb-0">
                {{ clients|length }}
                client{% if clients|length > 1 %}s{% endif %}
                trouvé{% if clients|length > 1 %}s{% endif %}
            </p>
        </div>

        <a
            href="{{ path('app_dashboard') }}"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form
                method="get"
                action="{{ path('app_admin_client_index') }}"
            >

                <div class="row g-2">

                    <div class="col-lg-10">

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input
                                type="search"
                                name="q"
                                class="form-control"
                                value="{{ search }}"
                                placeholder="Rechercher par nom, prénom, email, téléphone ou ville..."
                            >

                        </div>

                    </div>

                    <div class="col-lg-2">

                        <button
                            type="submit"
                            class="btn btn-primary w-100"
                        >
                            Rechercher
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    {% if clients is empty %}

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <i
                    class="bi bi-people text-muted"
                    style="font-size: 70px;"
                ></i>

                <h3 class="mt-3">
                    Aucun client trouvé
                </h3>

                {% if search %}
                    <p class="text-muted">
                        Aucun résultat pour :
                        <strong>{{ search }}</strong>
                    </p>
                {% else %}
                    <p class="text-muted">
                        Aucun client n'est actuellement enregistré.
                    </p>
                {% endif %}

            </div>

        </div>

    {% else %}

        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Client</th>
                                <th>Email</th>
                                <th>Téléphone</th>
                                <th>Ville</th>
                                <th>Statut</th>
                                <th>Créé le</th>
                                <th class="text-center">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            {% for client in clients %}

                                <tr>

                                    <td>
                                        #{{ client.id }}
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div
                                                class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                                                style="width: 42px; height: 42px;"
                                            >
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div>

                                                <strong>
                                                    {{ client.prenom }}
                                                    {{ client.nom }}
                                                </strong>

                                                <small class="text-muted d-block">
                                                    Client
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        {{ client.email ?: '—' }}
                                    </td>

                                    <td>
                                        {{ client.telephone ?: '—' }}
                                    </td>

                                    <td>
                                        {{ client.ville ?: '—' }}
                                    </td>

                                    <td>

                                        {% if client.actif %}

                                            <span class="badge bg-success">
                                                Actif
                                            </span>

                                        {% else %}

                                            <span class="badge bg-danger">
                                                Inactif
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td>

                                        {% if client.created_at %}
                                            {{ client.created_at|date('d/m/Y H:i') }}
                                        {% else %}
                                            —
                                        {% endif %}

                                    </td>

                                    <td class="text-center">

                                        <a
                                            href="{{ path(
                                                'app_admin_client_show',
                                                {'id': client.id}
                                            ) }}"
                                            class="btn btn-outline-primary btn-sm"
                                        >
                                            <i class="bi bi-eye"></i>
                                            Voir
                                        </a>

                                        <form
                                            action="{{ path(
                                                'app_admin_client_toggle',
                                                {'id': client.id}
                                            ) }}"
                                            method="post"
                                            class="d-inline"
                                        >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('statut_client_' ~ client.id) }}"
                                            >

                                            {% if client.actif %}

                                                <button
                                                    type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                >
                                                    <i class="bi bi-person-slash"></i>
                                                    Désactiver
                                                </button>

                                            {% else %}

                                                <button
                                                    type="submit"
                                                    class="btn btn-outline-success btn-sm"
                                                >
                                                    <i class="bi bi-person-check"></i>
                                                    Activer
                                                </button>

                                            {% endif %}

                                        </form>

                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}

