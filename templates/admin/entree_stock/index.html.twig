{% extends 'base.html.twig' %}

{% block title %}Entrées de stock{% endblock %}

{% block body %}

<style>

    /* =========================================================
       PAGE ENTREES DE STOCK
       ========================================================= */

    .entry-page {
        max-width: 1500px;
        margin: 0 auto;
    }


    /* =========================================================
       EN-TETE
       ========================================================= */

    .entry-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 25px;
    }

    .entry-header-left {
        min-width: 0;
    }

    .entry-kicker {
        display: inline-flex;
        align-items: center;

        gap: 6px;

        margin-bottom: 6px;

        color: #2563eb;

        font-size: 11px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .entry-header h1 {
        margin: 0;

        color: #172033;

        font-size: 28px;
        font-weight: 800;
    }

    .entry-header p {
        margin: 7px 0 0;

        color: #7d8799;

        font-size: 12px;
    }

    .entry-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 11px 15px;

        border-radius: 10px;

        background: #172033;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s ease;

        white-space: nowrap;
    }

    .entry-add-button:hover {
        background: #263653;

        color: white;

        transform: translateY(-1px);
    }


    /* =========================================================
       STATISTIQUES
       ========================================================= */

    .entry-stats {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 17px;

        margin-bottom: 20px;
    }

    .entry-stat {
        display: flex;
        align-items: center;

        gap: 13px;

        padding: 17px;

        background: white;

        border: 1px solid #edf0f5;
        border-radius: 14px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .entry-stat-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 18px;
    }

    .entry-stat-label {
        display: block;

        color: #8993a5;

        font-size: 9px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .entry-stat-value {
        display: block;

        margin-top: 3px;

        color: #172033;

        font-size: 19px;
        font-weight: 900;
    }


    /* =========================================================
       OUTILS
       ========================================================= */

    .entry-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        margin-bottom: 17px;
    }

    .entry-search {
        position: relative;

        width: 100%;
        max-width: 530px;
    }

    .entry-search i {
        position: absolute;

        left: 13px;
        top: 50%;

        transform: translateY(-50%);

        color: #8a94a6;

        font-size: 14px;
    }

    .entry-search input {
        width: 100%;

        padding: 11px 14px 11px 37px;

        border: 1px solid #dde3ed;
        border-radius: 10px;

        background: white;

        color: #172033;

        outline: none;

        font-size: 11px;
    }

    .entry-search input:focus {
        border-color: #93b4ff;

        box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
    }

    .entry-result-info {
        color: #8993a5;

        font-size: 10px;

        white-space: nowrap;
    }


    /* =========================================================
       TABLEAU
       ========================================================= */

    .entry-card {
        overflow: hidden;

        background: white;

        border: 1px solid #edf0f5;
        border-radius: 16px;

        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .entry-table-wrapper {
        overflow-x: auto;
    }

    .entry-table {
        width: 100%;

        margin: 0;

        border-collapse: collapse;
    }

    .entry-table thead th {
        padding: 14px 17px;

        background: #f8fafc;

        border-bottom: 1px solid #edf0f5;

        color: #7b8597;

        font-size: 9px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .05em;

        white-space: nowrap;
    }

    .entry-table tbody td {
        padding: 15px 17px;

        border-bottom: 1px solid #f0f2f6;

        vertical-align: middle;

        color: #4c5668;

        font-size: 10px;
    }

    .entry-table tbody tr:last-child td {
        border-bottom: none;
    }

    .entry-table tbody tr {
        transition: .15s ease;
    }

    .entry-table tbody tr:hover {
        background: #fbfcfe;
    }


    /* =========================================================
       PRODUIT
       ========================================================= */

    .entry-product {
        display: flex;
        align-items: center;

        gap: 10px;

        min-width: 190px;
    }

    .entry-product-icon {
        width: 37px;
        height: 37px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 15px;
    }

    .entry-product-name {
        color: #172033;

        font-size: 11px;
        font-weight: 800;
    }

    .entry-product-reference {
        margin-top: 3px;

        color: #9aa3b2;

        font-size: 8px;
    }


    /* =========================================================
       FOURNISSEUR
       ========================================================= */

    .entry-supplier-name {
        color: #344054;

        font-size: 10px;
        font-weight: 700;
    }

    .entry-no-supplier {
        color: #a1a9b5;

        font-size: 9px;

        font-style: italic;
    }


    /* =========================================================
       QUANTITE
       ========================================================= */

    .entry-quantity {
        display: inline-flex;
        align-items: center;

        gap: 5px;

        padding: 6px 9px;

        border-radius: 30px;

        background: #ecfdf3;
        color: #15803d;

        font-size: 9px;
        font-weight: 900;
    }


    /* =========================================================
       PRIX
       ========================================================= */

    .entry-price {
        color: #172033;

        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .entry-value {
        color: #172033;

        font-size: 10px;
        font-weight: 900;

        white-space: nowrap;
    }


    /* =========================================================
       DATE
       ========================================================= */

    .entry-date {
        white-space: nowrap;

        color: #667085;

        font-size: 9px;
    }


    /* =========================================================
       UTILISATEUR
       ========================================================= */

    .entry-user {
        color: #566174;

        font-size: 9px;
        font-weight: 700;
    }


    /* =========================================================
       DOCUMENT
       ========================================================= */

    .entry-document {
        max-width: 140px;

        color: #647084;

        font-size: 9px;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .entry-no-document {
        color: #a1a9b5;

        font-size: 9px;

        font-style: italic;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .entry-actions {
        display: flex;
        align-items: center;

        gap: 6px;

        white-space: nowrap;
    }

    .entry-action {
        width: 32px;
        height: 32px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        text-decoration: none;

        font-size: 13px;

        transition: .15s ease;
    }

    .entry-action-edit {
        background: #eff6ff;
        color: #2563eb;
    }

    .entry-action-edit:hover {
        background: #dbeafe;
        color: #1d4ed8;
    }


    /* =========================================================
       EMPTY
       ========================================================= */

    .entry-empty {
        padding: 55px 20px;

        text-align: center;
    }

    .entry-empty-icon {
        width: 65px;
        height: 65px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 15px;

        border-radius: 18px;

        background: #eff4ff;
        color: #2563eb;

        font-size: 28px;
    }

    .entry-empty h3 {
        margin: 0 0 6px;

        color: #172033;

        font-size: 17px;
        font-weight: 800;
    }

    .entry-empty p {
        max-width: 500px;

        margin: 0 auto 17px;

        color: #8791a3;

        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1000px) {

        .entry-stats {
            grid-template-columns: 1fr;
        }

    }

    @media (max-width: 700px) {

        .entry-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .entry-add-button {
            width: 100%;
        }

        .entry-tools {
            align-items: flex-start;

            flex-direction: column;
        }

        .entry-search {
            max-width: none;
        }

        .entry-result-info {
            white-space: normal;
        }

    }

</style>

<div class="entry-page">


{# =========================================================
   EN-TETE
   ========================================================= #}

<div class="entry-header">

    <div class="entry-header-left">

        <span class="entry-kicker">

            <i class="bi bi-arrow-down-circle"></i>

            Gestion du stock

        </span>

        <h1>
            Entrées de stock
        </h1>

        <p>
            Enregistrez les arrivages de produits et suivez
            les mouvements entrants du stock.
        </p>

    </div>


    <a
        href="{{ path('app_entree_stock_new') }}"
        class="entry-add-button"
    >

        <i class="bi bi-plus-lg"></i>

        Nouvelle entrée

    </a>

</div>


{# =========================================================
   STATISTIQUES
   ========================================================= #}

<div class="entry-stats">


    <div class="entry-stat">

        <div class="entry-stat-icon">
            <i class="bi bi-arrow-down-circle"></i>
        </div>

        <div>

            <span class="entry-stat-label">
                Total entrées
            </span>

            <span class="entry-stat-value">
                {{ totalEntrees }}
            </span>

        </div>

    </div>


    <div class="entry-stat">

        <div class="entry-stat-icon">
            <i class="bi bi-box-seam"></i>
        </div>

        <div>

            <span class="entry-stat-label">
                Quantité totale
            </span>

            <span class="entry-stat-value">
                {{ quantiteTotale }}
            </span>

        </div>

    </div>


    <div class="entry-stat">

        <div class="entry-stat-icon">
            <i class="bi bi-cash-stack"></i>
        </div>

        <div>

            <span class="entry-stat-label">
                Valeur des entrées
            </span>

            <span class="entry-stat-value">
                {{ valeurTotale|number_format(0, ',', ' ') }} Ar
            </span>

        </div>

    </div>

</div>


{# =========================================================
   RECHERCHE
   ========================================================= #}

<div class="entry-tools">

    <form
        method="GET"
        action="{{ path('app_entree_stock_index') }}"
        class="entry-search"
    >

        <i class="bi bi-search"></i>

        <input
            type="search"
            name="search"
            value="{{ search }}"
            placeholder="Rechercher par produit, référence, fournisseur..."
            autocomplete="off"
        >

    </form>


    <div class="entry-result-info">

        {{ totalEntrees }}

        entrée{% if totalEntrees != 1 %}s{% endif %}

        {% if search %}
            pour « {{ search }} »
        {% endif %}

    </div>

</div>


{# =========================================================
   TABLEAU
   ========================================================= #}

<div class="entry-card">


    {% if entrees is not empty %}

        <div class="entry-table-wrapper">

            <table class="entry-table">

                <thead>

                    <tr>

                        <th>
                            Produit
                        </th>

                        <th>
                            Fournisseur
                        </th>

                        <th>
                            Quantité
                        </th>

                        <th>
                            Prix unitaire
                        </th>

                        <th>
                            Valeur
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Utilisateur
                        </th>

                        <th>
                            Document
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {% for entree in entrees %}

                        <tr>


                            {# =================================================
                               PRODUIT
                               ================================================= #}

                            <td>

                                <div class="entry-product">

                                    <div class="entry-product-icon">

                                        <i class="bi bi-box-seam"></i>

                                    </div>


                                    <div>

                                        <div class="entry-product-name">

                                            {{ entree.produit.nom }}

                                        </div>

                                        <div class="entry-product-reference">

                                            Réf. {{ entree.produit.reference }}

                                        </div>

                                    </div>

                                </div>

                            </td>


                            {# =================================================
                               FOURNISSEUR
                               ================================================= #}

                            <td>

                                {% if entree.fournisseur %}

                                    <span class="entry-supplier-name">

                                        {{ entree.fournisseur.nom }}

                                    </span>

                                {% else %}

                                    <span class="entry-no-supplier">

                                        Aucun fournisseur

                                    </span>

                                {% endif %}

                            </td>


                            {# =================================================
                               QUANTITE
                               ================================================= #}

                            <td>

                                <span class="entry-quantity">

                                    <i class="bi bi-plus-circle"></i>

                                    +{{ entree.quantite }}

                                </span>

                            </td>


                            {# =================================================
                               PRIX UNITAIRE
                               ================================================= #}

                            <td>

                                <span class="entry-price">

                                    {{ entree.prixUnitaire|number_format(0, ',', ' ') }} Ar

                                </span>

                            </td>


                            {# =================================================
                               VALEUR
                               ================================================= #}

                            <td>

                                <span class="entry-value">

                                    {{
                                        (
                                            entree.quantite
                                            * (entree.prixUnitaire|default(0))
                                        )|number_format(0, ',', ' ')
                                    }}
                                    Ar

                                </span>

                            </td>


                            {# =================================================
                               DATE
                               ================================================= #}

                            <td>

                                <span class="entry-date">

                                    {% if entree.dateEntree %}

                                        {{ entree.dateEntree|date('d/m/Y H:i') }}

                                    {% else %}

                                        -

                                    {% endif %}

                                </span>

                            </td>


                            {# =================================================
                               UTILISATEUR
                               ================================================= #}

                            <td>

                                {% if entree.utilisateur %}

                                    <span class="entry-user">

                                        {{ entree.utilisateur.prenom }}
                                        {{ entree.utilisateur.nom }}

                                    </span>

                                {% else %}

                                    <span class="entry-no-document">

                                        -

                                    </span>

                                {% endif %}

                            </td>


                            {# =================================================
                               DOCUMENT
                               ================================================= #}

                            <td>

                                {% if entree.referenceDocument %}

                                    <div
                                        class="entry-document"
                                        title="{{ entree.referenceDocument }}"
                                    >

                                        <i class="bi bi-file-text"></i>

                                        {{ entree.referenceDocument }}

                                    </div>

                                {% else %}

                                    <span class="entry-no-document">

                                        Aucun document

                                    </span>

                                {% endif %}

                            </td>


                            {# =================================================
                               ACTIONS
                               ================================================= #}

                            <td>

                                <div class="entry-actions">

                                    <a
                                        href="{{ path('app_entree_stock_edit', {
                                            id: entree.id
                                        }) }}"
                                        class="entry-action entry-action-edit"
                                        title="Modifier"
                                    >

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>


    {% else %}


        {# =================================================
           AUCUNE ENTREE
           ================================================= #}

        <div class="entry-empty">

            <div class="entry-empty-icon">

                <i class="bi bi-arrow-down-circle"></i>

            </div>


            {% if search %}

                <h3>
                    Aucune entrée trouvée
                </h3>

                <p>
                    Aucun résultat ne correspond à votre recherche
                    « {{ search }} ».
                </p>


                <a
                    href="{{ path('app_entree_stock_index') }}"
                    class="entry-add-button"
                >

                    <i class="bi bi-arrow-counterclockwise"></i>

                    Réinitialiser

                </a>


            {% else %}

                <h3>
                    Aucune entrée de stock
                </h3>

                <p>
                    Commencez par enregistrer votre première entrée
                    de stock pour mettre à jour les quantités disponibles.
                </p>


                <a
                    href="{{ path('app_entree_stock_new') }}"
                    class="entry-add-button"
                >

                    <i class="bi bi-plus-lg"></i>

                    Enregistrer une entrée

                </a>

            {% endif %}

        </div>

    {% endif %}


</div>


</div>

{% endblock %}
