{% extends 'base.html.twig' %}

{% block title %}Modifier une entrée de stock{% endblock %}

{% block body %}

<div class="container-fluid py-4 px-3 px-lg-4">

    {# =========================================================
       HEADER
       ========================================================= #}
    <div class="page-header mb-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div>
                <div class="page-badge">
                    <i class="bi bi-box-arrow-in-down me-2"></i>
                    Gestion du stock
                </div>

                <h1 class="page-title mt-2 mb-1">
                    Modifier une entrée
                </h1>

                <p class="page-subtitle mb-0">
                    Modifiez les informations de l'entrée de stock.
                </p>
            </div>

            <a href="{{ path('app_entree_stock_index') }}"
               class="btn btn-light back-btn">
                <i class="bi bi-arrow-left me-2"></i>
                Retour aux entrées
            </a>

        </div>

    </div>


    {# =========================================================
       FLASH SUCCESS
       ========================================================= #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success custom-alert mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
        </div>
    {% endfor %}


    {# =========================================================
       FLASH ERROR
       ========================================================= #}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger custom-alert mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ message }}
        </div>
    {% endfor %}


    <div class="row g-4 align-items-start">

        {# =====================================================
           FORMULAIRE
           ===================================================== #}
        <div class="col-xl-8">

            <div class="main-card">

                {# CARD HEADER #}
                <div class="card-top">

                    <div class="d-flex align-items-center gap-3">

                        <div class="card-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>
                            <h2 class="card-title mb-1">
                                Informations de l'entrée
                            </h2>

                            <p class="card-subtitle mb-0">
                                Entrée #{{ entree.id }}
                            </p>
                        </div>

                    </div>

                    <div class="entry-status">
                        <i class="bi bi-pencil me-1"></i>
                        Modification
                    </div>

                </div>


                <div class="card-content">

                    <form method="post"
                          action="{{ path('app_entree_stock_edit', {'id': entree.id}) }}">

                        {# =================================================
                           PRODUIT
                           ================================================= #}
                        <div class="form-section">

                            <div class="section-title">
                                <i class="bi bi-box-seam"></i>
                                Produit
                            </div>

                            <label for="produit" class="form-label">
                                Produit <span class="required">*</span>
                            </label>

                            <select
                                id="produit"
                                name="produit"
                                class="form-select custom-select"
                                required
                            >

                                <option value="">
                                    -- Sélectionner un produit --
                                </option>

                                {% for produit in produits %}

                                    <option
                                        value="{{ produit.id }}"
                                        data-stock="{{ produit.quantiteStock }}"
                                        {% if entree.produit and entree.produit.id == produit.id %}
                                            selected
                                        {% endif %}
                                    >
                                        {{ produit.reference }} — {{ produit.nom }}
                                    </option>

                                {% endfor %}

                            </select>

                            <div class="field-help">
                                <i class="bi bi-info-circle me-1"></i>
                                Le stock actuel du produit est pris en compte automatiquement.
                            </div>

                        </div>


                        {# =================================================
                           FOURNISSEUR
                           ================================================= #}
                        <div class="form-section">

                            <div class="section-title">
                                <i class="bi bi-truck"></i>
                                Fournisseur
                            </div>

                            <label for="fournisseur" class="form-label">
                                Fournisseur
                            </label>

                            <select
                                id="fournisseur"
                                name="fournisseur"
                                class="form-select custom-select"
                            >

                                <option value="">
                                    -- Aucun fournisseur --
                                </option>

                                {% for fournisseur in fournisseurs %}

                                    <option
                                        value="{{ fournisseur.id }}"
                                        {% if entree.fournisseur and entree.fournisseur.id == fournisseur.id %}
                                            selected
                                        {% endif %}
                                    >
                                        {{ fournisseur.nom }}
                                    </option>

                                {% endfor %}

                            </select>

                        </div>


                        {# =================================================
                           QUANTITE + PRIX
                           ================================================= #}
                        <div class="form-section">

                            <div class="section-title">
                                <i class="bi bi-123"></i>
                                Quantité et prix
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="quantite" class="form-label">
                                        Quantité entrée
                                        <span class="required">*</span>
                                    </label>

                                    <div class="input-group">

                                        <input
                                            type="number"
                                            id="quantite"
                                            name="quantite"
                                            class="form-control custom-input"
                                            min="1"
                                            step="1"
                                            value="{{ entree.quantite }}"
                                            required
                                        >

                                        <span class="input-group-text custom-addon">
                                            pièces
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <label for="prixUnitaire" class="form-label">
                                        Prix unitaire
                                    </label>

                                    <div class="input-group">

                                        <input
                                            type="number"
                                            id="prixUnitaire"
                                            name="prixUnitaire"
                                            class="form-control custom-input"
                                            min="0"
                                            step="0.01"
                                            value="{{ entree.prixUnitaire }}"
                                        >

                                        <span class="input-group-text custom-addon">
                                            MGA
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        {# =================================================
                           DATE + REFERENCE
                           ================================================= #}
                        <div class="form-section">

                            <div class="section-title">
                                <i class="bi bi-calendar3"></i>
                                Informations du document
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="dateEntree" class="form-label">
                                        Date d'entrée
                                    </label>

                                    <input
                                        type="datetime-local"
                                        id="dateEntree"
                                        name="dateEntree"
                                        class="form-control custom-input"
                                        value="{% if entree.dateEntree %}{{ entree.dateEntree|date('Y-m-d\\TH:i') }}{% endif %}"
                                    >

                                </div>


                                <div class="col-md-6">

                                    <label for="referenceDocument" class="form-label">
                                        Référence du document
                                    </label>

                                    <input
                                        type="text"
                                        id="referenceDocument"
                                        name="referenceDocument"
                                        class="form-control custom-input"
                                        maxlength="100"
                                        value="{{ entree.referenceDocument ?? '' }}"
                                        placeholder="Ex : BL-2026-001"
                                    >

                                </div>

                            </div>

                        </div>


                        {# =================================================
                           COMMENTAIRE
                           ================================================= #}
                        <div class="form-section mb-0">

                            <div class="section-title">
                                <i class="bi bi-chat-left-text"></i>
                                Commentaire
                            </div>

                            <label for="commentaire" class="form-label">
                                Commentaire
                            </label>

                            <textarea
                                id="commentaire"
                                name="commentaire"
                                class="form-control custom-textarea"
                                rows="4"
                                placeholder="Ajouter une remarque..."
                            >{{ entree.commentaire ?? '' }}</textarea>

                        </div>


                        {# =================================================
                           CSRF
                           ================================================= #}
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('modifier_entree_stock_' ~ entree.id) }}"
                        >


                        {# =================================================
                           ACTIONS
                           ================================================= #}
                        <div class="form-actions">

                            <a href="{{ path('app_entree_stock_index') }}"
                               class="btn btn-light action-cancel">
                                <i class="bi bi-x-lg me-2"></i>
                                Annuler
                            </a>


                            <button type="submit"
                                    class="btn btn-primary action-save">
                                <i class="bi bi-check2-circle me-2"></i>
                                Enregistrer les modifications
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        {# =====================================================
           COLONNE DROITE
           ===================================================== #}
        <div class="col-xl-4">

            {# =================================================
               STOCK PREVIEW
               ================================================= #}
            <div class="stock-card">

                <div class="stock-card-header">

                    <div class="stock-card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <div>
                        <h3 class="stock-card-title mb-1">
                            Aperçu du stock
                        </h3>

                        <p class="stock-card-subtitle mb-0">
                            Calcul automatique
                        </p>
                    </div>

                </div>


                {# STOCK ACTUEL #}
                <div class="stock-item">

                    <div class="stock-item-label">
                        <i class="bi bi-box me-2"></i>
                        Stock actuel
                    </div>

                    <div class="stock-item-value">
                        <span id="stockActuel">0</span>
                        <small>pièces</small>
                    </div>

                </div>


                {# ANCIENNE QUANTITE #}
                <div class="stock-item">

                    <div class="stock-item-label">
                        <i class="bi bi-arrow-down-left me-2"></i>
                        Ancienne quantité
                    </div>

                    <div class="stock-item-value">
                        <span id="ancienneQuantite">
                            {{ entree.quantite }}
                        </span>
                        <small>pièces</small>
                    </div>

                </div>


                {# STOCK AVANT #}
                <div class="stock-item">

                    <div class="stock-item-label">
                        <i class="bi bi-box-arrow-left me-2"></i>
                        Stock avant cette entrée
                    </div>

                    <div class="stock-item-value">
                        <span id="stockAvantEntree">0</span>
                        <small>pièces</small>
                    </div>

                </div>


                {# NOUVELLE QUANTITE #}
                <div class="stock-item stock-new">

                    <div class="stock-item-label">
                        <i class="bi bi-plus-circle me-2"></i>
                        Nouvelle quantité
                    </div>

                    <div class="stock-item-value">
                        <span id="nouvelleQuantite">
                            {{ entree.quantite }}
                        </span>
                        <small>pièces</small>
                    </div>

                </div>


                {# RESULTAT #}
                <div class="stock-result">

                    <div>
                        <div class="stock-result-label">
                            Nouveau stock estimé
                        </div>

                        <div class="stock-result-text">
                            Après modification
                        </div>
                    </div>

                    <div class="stock-result-number">
                        <span id="nouveauStock">0</span>
                    </div>

                </div>


                {# MESSAGE #}
                <div id="stockInfoMessage"
                     class="stock-message">

                    <i class="bi bi-info-circle-fill"></i>

                    <span>
                        Le calcul sera mis à jour automatiquement.
                    </span>

                </div>

            </div>


            {# =================================================
               EXPLICATION
               ================================================= #}
            <div class="help-card mt-4">

                <div class="help-title">
                    <div class="help-icon">
                        <i class="bi bi-lightbulb-fill"></i>
                    </div>

                    <span>
                        Comment fonctionne le calcul ?
                    </span>
                </div>


                <p class="help-text">
                    Lors d'une modification, l'ancienne quantité est déjà
                    comprise dans le stock actuel.
                </p>


                <div class="formula">

                    <div class="formula-line">
                        <span>Stock actuel</span>
                        <strong>10</strong>
                    </div>

                    <div class="formula-operation">
                        − Ancienne quantité
                    </div>

                    <div class="formula-operation">
                        + Nouvelle quantité
                    </div>

                    <div class="formula-line formula-total">
                        <span>Nouveau stock</span>
                        <strong>11</strong>
                    </div>

                </div>


                <div class="example-text">
                    <i class="bi bi-check-circle me-1"></i>
                    Exemple : 10 − 4 + 5 = 11 pièces
                </div>

            </div>

        </div>

    </div>

</div>


{# =============================================================
   STYLE
   ============================================================= #}
