{# =============================================================
   JAVASCRIPT
   ============================================================= #}
<script>

document.addEventListener('DOMContentLoaded', function () {

    const produitSelect = document.getElementById('produit');
    const quantiteInput = document.getElementById('quantite');

    const stockActuelElement =
        document.getElementById('stockActuel');

    const ancienneQuantiteElement =
        document.getElementById('ancienneQuantite');

    const stockAvantEntreeElement =
        document.getElementById('stockAvantEntree');

    const nouvelleQuantiteElement =
        document.getElementById('nouvelleQuantite');

    const nouveauStockElement =
        document.getElementById('nouveauStock');

    const stockInfoMessage =
        document.getElementById('stockInfoMessage');


    /*
     * Anciennes informations de cette entrée
     */
    const ancienneQuantite = {{ entree.quantite }};
    const ancienProduitId = {{ entree.produit ? entree.produit.id : 0 }};


    /*
     * Récupérer le stock du produit sélectionné
     */
    function getStockProduit() {

        if (!produitSelect || !produitSelect.value) {
            return 0;
        }

        const option =
            produitSelect.options[produitSelect.selectedIndex];

        if (!option) {
            return 0;
        }

        return parseInt(
            option.dataset.stock || '0',
            10
        );
    }


    /*
     * Calcul et affichage
     */
    function mettreAJourStock() {

        if (!produitSelect || !quantiteInput) {
            return;
        }


        const produitId =
            parseInt(produitSelect.value || '0', 10);


        let nouvelleQuantite =
            parseInt(quantiteInput.value || '0', 10);


        if (isNaN(nouvelleQuantite) || nouvelleQuantite < 0) {
            nouvelleQuantite = 0;
        }


        const stockActuel =
            getStockProduit();


        stockActuelElement.textContent =
            stockActuel;

        ancienneQuantiteElement.textContent =
            ancienneQuantite;

        nouvelleQuantiteElement.textContent =
            nouvelleQuantite;


        /*
         * Aucun produit
         */
        if (produitId === 0) {

            stockAvantEntreeElement.textContent = '0';
            nouveauStockElement.textContent = '0';

            stockInfoMessage.className =
                'stock-message';

            stockInfoMessage.innerHTML = `
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    Sélectionnez un produit pour afficher
                    le calcul du stock.
                </span>
            `;

            return;
        }


        /*
         * =========================================================
         * MÊME PRODUIT
         * =========================================================
         *
         * Le stock actuel contient déjà l'ancienne quantité.
         *
         * Exemple :
         *
         * 10 stock actuel
         * - 4 ancienne quantité
         * + 5 nouvelle quantité
         * = 11 nouveau stock
         */
        if (produitId === ancienProduitId) {

            let stockAvantEntree =
                stockActuel - ancienneQuantite;


            if (stockAvantEntree < 0) {
                stockAvantEntree = 0;
            }


            const nouveauStock =
                stockAvantEntree + nouvelleQuantite;


            stockAvantEntreeElement.textContent =
                stockAvantEntree;

            nouveauStockElement.textContent =
                nouveauStock;


            stockInfoMessage.className =
                'stock-message';


            stockInfoMessage.innerHTML = `
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    Le stock actuel de
                    <strong>${stockActuel} pièce(s)</strong>
                    contient déjà l'ancienne quantité
                    de <strong>${ancienneQuantite} pièce(s)</strong>.
                    <br>
                    Calcul :
                    <strong>
                        ${stockActuel}
                        − ${ancienneQuantite}
                        + ${nouvelleQuantite}
                        = ${nouveauStock} pièce(s)
                    </strong>
                </span>
            `;

        }


        /*
         * =========================================================
         * CHANGEMENT DE PRODUIT
         * =========================================================
         */
        else {

            const nouveauStock =
                stockActuel + nouvelleQuantite;


            stockAvantEntreeElement.textContent =
                stockActuel;

            nouveauStockElement.textContent =
                nouveauStock;


            stockInfoMessage.className =
                'stock-message';


            stockInfoMessage.innerHTML = `
                <i class="bi bi-arrow-left-right"></i>
                <span>
                    Le produit a été changé.
                    <br>
                    L'ancienne quantité de
                    <strong>${ancienneQuantite} pièce(s)</strong>
                    sera retirée de l'ancien produit.
                    <br>
                    Nouveau produit :
                    <strong>
                        ${stockActuel}
                        + ${nouvelleQuantite}
                        = ${nouveauStock} pièce(s)
                    </strong>
                </span>
            `;

        }

    }


    /*
     * Changement de produit
     */
    if (produitSelect) {

        produitSelect.addEventListener(
            'change',
            mettreAJourStock
        );

    }


    /*
     * Modification quantité
     */
    if (quantiteInput) {

        quantiteInput.addEventListener(
            'input',
            mettreAJourStock
        );

        quantiteInput.addEventListener(
            'change',
            mettreAJourStock
        );

    }


    /*
     * Calcul initial
     */
    mettreAJourStock();

});

</script>

{% endblock %}

