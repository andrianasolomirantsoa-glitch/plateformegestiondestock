{% extends 'base.html.twig' %}

{% block title %}
    Tableau de bord - Gestion de Stock
{% endblock %}

{% block header_title %}
    <div class="dashboard-heading">
        <div>
            <h1 class="page-title">
                Tableau de bord
            </h1>

            <p class="dashboard-subtitle">
                Vue d'ensemble de votre gestion de stock
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            {{ "now"|date("d/m/Y") }}
        </div>
    </div>
{% endblock %}


{% block stylesheets %}
    {{ parent() }}

    <style>

        /* =========================================================
           VARIABLES
        ========================================================= */

        :root {
            --dashboard-bg: #f4f7fb;

            --navy-950: #081525;
            --navy-900: #0b1b30;
            --navy-850: #10243d;
            --navy-800: #142c48;
            --navy-700: #1b3a5c;

            --blue: #3b82f6;
            --blue-light: #60a5fa;
            --cyan: #22d3ee;

            --green: #34d399;
            --orange: #f59e0b;
            --red: #ef4444;
            --purple: #8b5cf6;

            --text-dark: #172033;
            --text-medium: #526176;
            --text-light: #8290a3;

            --white: #ffffff;

            --border: #e4eaf2;

            --shadow-sm:
                0 2px 8px rgba(15, 35, 60, .05);

            --shadow-md:
                0 8px 25px rgba(15, 35, 60, .09);

            --shadow-lg:
                0 15px 40px rgba(15, 35, 60, .13);

            --radius-sm: 10px;
            --radius-md: 14px;
            --radius-lg: 18px;
            --radius-xl: 22px;

            --transition:
                all .25s ease;
        }


        /* =========================================================
           PAGE
        ========================================================= */

        .dashboard-page {
            width: 100%;
            min-height: 100%;
            background: var(--dashboard-bg);
        }


        /* =========================================================
           HEADER
        ========================================================= */

        .dashboard-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 26px;
        }

        .dashboard-heading .page-title {
            margin: 0;
            color: var(--navy-950);
            font-size: 30px;
            font-weight: 750;
            letter-spacing: -.7px;
        }

        .dashboard-subtitle {
            margin: 6px 0 0;
            color: var(--text-medium);
            font-size: 14px;
        }

        .dashboard-date {
            display: flex;
            align-items: center;
            gap: 8px;

            padding: 10px 15px;

            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;

            color: var(--text-medium);
            font-size: 13px;

            box-shadow: var(--shadow-sm);
        }

        .dashboard-date i {
            color: var(--blue);
        }


        /* =========================================================
           MAIN GRID
        ========================================================= */

        .dashboard-content {
            width: 100%;
        }


        /* =========================================================
           STATISTIQUES
        ========================================================= */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }


        .stat-card {
            position: relative;
            overflow: hidden;

            min-height: 145px;

            padding: 20px;

            background: var(--navy-900);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: var(--radius-lg);

            color: white;

            box-shadow: var(--shadow-md);

            transition: var(--transition);
        }


        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }


        .stat-card::before {
            content: "";

            position: absolute;

            width: 120px;
            height: 120px;

            right: -40px;
            top: -45px;

            border-radius: 50%;

            background: rgba(255,255,255,.035);
        }


        .stat-card::after {
            content: "";

            position: absolute;

            width: 90px;
            height: 90px;

            right: 35px;
            bottom: -55px;

            border-radius: 50%;

            background: rgba(255,255,255,.025);
        }


        .stat-top {
            position: relative;
            z-index: 2;

            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 12px;
        }


        .stat-label {
            margin: 0;

            color: #a9b9cc;

            font-size: 13px;
            font-weight: 500;
        }


        .stat-icon {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            font-size: 19px;
        }


        .stat-icon.products {
            color: #60a5fa;
            background: rgba(59,130,246,.16);
        }


        .stat-icon.stock {
            color: #22d3ee;
            background: rgba(34,211,238,.14);
        }


        .stat-icon.alert {
            color: #fbbf24;
            background: rgba(245,158,11,.15);
        }


        .stat-icon.users {
            color: #c4b5fd;
            background: rgba(139,92,246,.15);
        }


        .stat-value {
            position: relative;
            z-index: 2;

            margin: 0;

            color: white;

            font-size: 29px;
            line-height: 1;

            font-weight: 750;

            letter-spacing: -.5px;
        }


        .stat-bottom {
            position: relative;
            z-index: 2;

            display: flex;
            align-items: center;
            gap: 6px;

            margin-top: 10px;

            color: #91a2b7;

            font-size: 11px;
        }


        .stat-trend {
            display: inline-flex;
            align-items: center;
            gap: 3px;

            color: var(--green);

            font-weight: 600;
        }


        .stat-trend.warning {
            color: var(--orange);
        }


        /* =========================================================
           ACTION HEADER
        ========================================================= */

        .section-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;

            margin-bottom: 14px;
        }


        .section-title {
            margin: 0;

            color: var(--text-dark);

            font-size: 20px;
            font-weight: 700;
        }


        .section-title i {
            margin-right: 7px;
            color: var(--blue);
        }


        .section-description {
            margin: 5px 0 0;

            color: var(--text-light);

            font-size: 12px;
        }


        /* =========================================================
           ACTIONS
        ========================================================= */

        .actions-grid {
            display: grid;

            grid-template-columns:
                repeat(4, minmax(0, 1fr));

            gap: 15px;

            margin-bottom: 24px;
        }


        .action-card {
            position: relative;
            overflow: hidden;

            min-height: 150px;

            display: flex;
            flex-direction: column;

            padding: 0;

            background: white;

            border: 1px solid var(--border);
            border-radius: var(--radius-lg);

            color: var(--text-dark);
            text-decoration: none;

            box-shadow: var(--shadow-sm);

            transition: var(--transition);
        }


        .action-card:hover {
            transform: translateY(-5px);

            color: var(--text-dark);

            border-color: #cbd8e8;

            box-shadow: var(--shadow-lg);
        }


        .action-image {
            position: relative;

            height: 78px;

            overflow: hidden;

            background: var(--navy-900);
        }


        .action-image::after {
            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    180deg,
                    rgba(8,21,37,.05),
                    rgba(8,21,37,.50)
                );
        }


        .action-image img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            transition: transform .45s ease;
        }


        .action-card:hover .action-image img {
            transform: scale(1.08);
        }


        .action-icon {
            position: absolute;

            z-index: 3;

            left: 14px;
            bottom: -18px;

            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background: white;

            color: var(--blue);

            font-size: 18px;

            box-shadow: 0 5px 15px rgba(0,0,0,.14);
        }


        .action-body {
            padding: 25px 15px 15px;
        }


        .action-body h3 {
            margin: 0 0 5px;

            font-size: 14px;
            font-weight: 700;
        }


        .action-body p {
            margin: 0;

            color: var(--text-light);

            font-size: 11px;

            line-height: 1.5;
        }


        .action-arrow {
            position: absolute;

            right: 15px;
            bottom: 14px;

            color: #9aa8b9;

            transition: var(--transition);
        }


        .action-card:hover .action-arrow {
            color: var(--blue);
            transform: translateX(4px);
        }


        /* =========================================================
           BOTTOM GRID
        ========================================================= */

        .dashboard-grid {
            display: grid;

            grid-template-columns:
                minmax(0, 1.7fr)
                minmax(300px, .8fr);

            gap: 18px;

            margin-bottom: 25px;
        }


        .dashboard-card {
            background: white;

            border: 1px solid var(--border);

            border-radius: var(--radius-lg);

            box-shadow: var(--shadow-sm);

            overflow: hidden;
        }


        .dashboard-card-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            padding: 18px 20px;

            border-bottom: 1px solid var(--border);
        }


        .dashboard-card-title {
            display: flex;
            align-items: center;

            gap: 8px;

            margin: 0;

            color: var(--text-dark);

            font-size: 15px;
            font-weight: 700;
        }


        .dashboard-card-title i {
            color: var(--blue);
        }


        .dashboard-card-link {
            color: var(--blue);

            font-size: 11px;
            font-weight: 600;

            text-decoration: none;
        }


        .dashboard-card-link:hover {
            text-decoration: underline;
        }


        /* =========================================================
           GRAPHIQUE
        ========================================================= */

        .chart-container {
            padding: 15px 20px 20px;
        }


        .chart-legend {
            display: flex;
            justify-content: flex-end;
            gap: 18px;

            margin-bottom: 8px;

            font-size: 10px;
            color: var(--text-light);
        }


        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }


        .legend-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;
        }


        .legend-sales {
            background: #22c55e;
        }


        .legend-orders {
            background: #3b82f6;
        }


        .legend-stock {
            background: #ef4444;
        }


        .performance-chart {
            width: 100%;
            height: 220px;

            display: block;
        }


        /* =========================================================
           SVG GRAPH
        ========================================================= */

        .chart-grid-line {
            stroke: #e9eef5;
            stroke-width: 1;
        }


        .chart-line-sales {
            fill: none;
            stroke: #22c55e;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


        .chart-line-orders {
            fill: none;
            stroke: #3b82f6;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


        .chart-line-stock {
            fill: none;
            stroke: #ef4444;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
            opacity: .75;
        }


        .chart-area {
            fill: rgba(59,130,246,.06);
        }


        .chart-point {
            fill: white;
            stroke-width: 3;
        }


        /* =========================================================
           ACTIVITES
        ========================================================= */

        .activity-list {
            padding: 7px 20px 12px;
        }


        .activity-item {
            display: flex;
            align-items: center;

            gap: 12px;

            padding: 13px 0;

            border-bottom: 1px solid #edf1f6;
        }


        .activity-item:last-child {
            border-bottom: 0;
        }


        .activity-icon {
            width: 37px;
            height: 37px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            background: #edf5ff;

            color: var(--blue);

            font-size: 15px;
        }


        .activity-icon.green {
            color: #059669;
            background: #ecfdf5;
        }


        .activity-icon.orange {
            color: #d97706;
            background: #fff7ed;
        }


        .activity-icon.purple {
            color: #7c3aed;
            background: #f5f3ff;
        }


        .activity-text {
            flex: 1;
            min-width: 0;
        }


        .activity-text strong {
            display: block;

            color: var(--text-dark);

            font-size: 12px;
            font-weight: 650;
        }


        .activity-text span {
            display: block;

            margin-top: 3px;

            color: var(--text-light);

            font-size: 10px;
        }


        .activity-time {
            color: #9aa7b7;

            font-size: 9px;
            white-space: nowrap;
        }


        /* =========================================================
           STOCK ALERT
        ========================================================= */

        .stock-alert {
            margin: 15px 20px 20px;

            padding: 15px;

            background:
                linear-gradient(
                    135deg,
                    #fff8eb,
                    #fffdf8
                );

            border: 1px solid #fde6b5;

            border-radius: 14px;
        }


        .stock-alert-header {
            display: flex;
            align-items: center;
            gap: 9px;

            margin-bottom: 10px;
        }


        .stock-alert-icon {
            width: 35px;
            height: 35px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background: #fff0c9;

            color: #d97706;
        }


        .stock-alert-header h4 {
            margin: 0;

            color: #704d12;

            font-size: 12px;
            font-weight: 700;
        }


        .stock-alert p {
            margin: 0;

            color: #896f3b;

            font-size: 10px;

            line-height: 1.55;
        }


        .alert-products {
            margin-top: 11px;
        }


        .alert-product {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 7px 0;

            border-top: 1px solid rgba(217,119,6,.12);

            font-size: 10px;
        }


        .alert-product-name {
            color: #60451b;
        }


        .alert-product-stock {
            color: #dc2626;

            font-weight: 700;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 1200px) {

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .actions-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 768px) {

            .dashboard-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .dashboard-heading .page-title {
                font-size: 25px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .actions-grid {
                grid-template-columns: 1fr;
            }

            .dashboard-date {
                width: 100%;
                justify-content: center;
            }

            .chart-legend {
                justify-content: flex-start;
                flex-wrap: wrap;
            }
        }


        @media (max-width: 480px) {

            .stat-card {
                min-height: 130px;
            }

            .stat-value {
                font-size: 25px;
            }

            .action-image {
                height: 90px;
            }

            .performance-chart {
                height: 180px;
            }
        }

    </style>
{% endblock %}


{% block body %}

<div class="dashboard-page">

    <div class="dashboard-content">


        {# =====================================================
           STATISTIQUES
        ====================================================== #}

        <section class="stats-grid">


            {# PRODUITS #}

            <div class="stat-card">

                <div class="stat-top">

                    <p class="stat-label">
                        Produits
                    </p>

                    <div class="stat-icon products">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

                <h2 class="stat-value">
                    1 284
                </h2>

                <div class="stat-bottom">

                    <span class="stat-trend">
                        <i class="bi bi-arrow-up"></i>
                        8.2%
                    </span>

                    <span>
                        produits enregistrés
                    </span>

                </div>

            </div>


            {# STOCK #}

            <div class="stat-card">

                <div class="stat-top">

                    <p class="stat-label">
                        Stock total
                    </p>

                    <div class="stat-icon stock">
                        <i class="bi bi-boxes"></i>
                    </div>

                </div>

                <h2 class="stat-value">
                    3 421
                </h2>

                <div class="stat-bottom">

                    <span class="stat-trend">
                        <i class="bi bi-arrow-up"></i>
                        5.4%
                    </span>

                    <span>
                        articles disponibles
                    </span>

                </div>

            </div>


            {# STOCK FAIBLE #}

            <div class="stat-card">

                <div class="stat-top">

                    <p class="stat-label">
                        Stock faible
                    </p>

                    <div class="stat-icon alert">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                </div>

                <h2 class="stat-value">
                    23
                </h2>

                <div class="stat-bottom">

                    <span class="stat-trend warning">
                        <i class="bi bi-exclamation-circle"></i>
                        Attention
                    </span>

                    <span>
                        produits à surveiller
                    </span>

                </div>

            </div>


            {# UTILISATEURS #}

            <div class="stat-card">

                <div class="stat-top">

                    <p class="stat-label">
                        Utilisateurs
                    </p>

                    <div class="stat-icon users">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

                <h2 class="stat-value">
                    18
                </h2>

                <div class="stat-bottom">

                    <span class="stat-trend">
                        <i class="bi bi-check-circle"></i>
                        Actifs
                    </span>

                    <span>
                        utilisateurs
                    </span>

                </div>

            </div>

        </section>


        {# =====================================================
           ACTIONS RAPIDES
        ====================================================== #}

        <section>

            <div class="section-header">

                <div>

                    <h2 class="section-title">
                        <i class="bi bi-lightning-charge-fill"></i>
                        Actions rapides
                    </h2>

                    <p class="section-description">
                        Accédez rapidement aux principales fonctions
                        de votre gestion de stock.
                    </p>

                </div>

            </div>


            <div class="actions-grid">


                {# AJOUTER PRODUIT #}

                <a
                    href="{{ path('app_produit_new') }}"
                    class="action-card"
                >

                    <div class="action-image">

                        <img
                            src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=700&q=80"
                            alt="Ajouter un produit"
                        >

                        <div class="action-icon">
                            <i class="bi bi-plus-lg"></i>
                        </div>

                    </div>

                    <div class="action-body">

                        <h3>
                            Ajouter un produit
                        </h3>

                        <p>
                            Enregistrer un nouveau produit
                            dans votre stock.
                        </p>

                    </div>

                    <span class="action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>


                {# VOIR PRODUITS #}

                <a
                    href="{{ path('app_produit_index') }}"
                    class="action-card"
                >

                    <div class="action-image">

                        <img
                            src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?auto=format&fit=crop&w=700&q=80"
                            alt="Gestion des produits"
                        >

                        <div class="action-icon">
                            <i class="bi bi-grid"></i>
                        </div>

                    </div>

                    <div class="action-body">

                        <h3>
                            Voir les produits
                        </h3>

                        <p>
                            Consulter, modifier ou supprimer
                            vos produits.
                        </p>

                    </div>

                    <span class="action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>


                {# GESTION STOCK #}

                <a
                    href="#"
                    class="action-card"
                >

                    <div class="action-image">

                        <img
                            src="https://images.unsplash.com/photo-1553413077-190dd305871c?auto=format&fit=crop&w=700&q=80"
                            alt="Gestion du stock"
                        >

                        <div class="action-icon">
                            <i class="bi bi-clipboard-data"></i>
                        </div>

                    </div>

                    <div class="action-body">

                        <h3>
                            Gestion du stock
                        </h3>

                        <p>
                            Consultez les quantités disponibles
                            et les mouvements.
                        </p>

                    </div>

                    <span class="action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>


                {# UTILISATEURS #}

                <a
                    href="#"
                    class="action-card"
                >

                    <div class="action-image">

                        <img
                            src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=700&q=80"
                            alt="Gestion des utilisateurs"
                        >

                        <div class="action-icon">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                    <div class="action-body">

                        <h3>
                            Utilisateurs
                        </h3>

                        <p>
                            Gérez les utilisateurs et leurs
                            différents accès.
                        </p>

                    </div>

                    <span class="action-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>

            </div>

        </section>


        {# =====================================================
           GRAPHIQUE + ACTIVITES
        ====================================================== #}

        <section class="dashboard-grid">


            {# =================================================
               PERFORMANCE
            ================================================== #}

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h3 class="dashboard-card-title">
                        <i class="bi bi-bar-chart-line"></i>
                        Performances hebdomadaires
                    </h3>

                    <a
                        href="#"
                        class="dashboard-card-link"
                    >
                        Voir détails
                    </a>

                </div>


                <div class="chart-container">

                    <div class="chart-legend">

                        <span class="legend-item">
                            <span class="legend-dot legend-sales"></span>
                            Ventes
                        </span>

                        <span class="legend-item">
                            <span class="legend-dot legend-orders"></span>
                            Commandes
                        </span>

                        <span class="legend-item">
                            <span class="legend-dot legend-stock"></span>
                            Inventaire
                        </span>

                    </div>


                    <svg
                        class="performance-chart"
                        viewBox="0 0 800 250"
                        preserveAspectRatio="none"
                    >

                        {# GRILLE #}

                        <line
                            x1="0"
                            y1="30"
                            x2="800"
                            y2="30"
                            class="chart-grid-line"
                        />

                        <line
                            x1="0"
                            y1="80"
                            x2="800"
                            y2="80"
