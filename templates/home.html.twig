<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jumbo Score Madagascar | Accueil</title>
    <meta name="description" content="Découvrez Jumbo Score Madagascar, consultez notre catalogue et localisez nos magasins.">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --jumbo-primary: #173b70;
            --jumbo-primary-dark: #10294f;
            --jumbo-blue: #2864a5;
            --jumbo-yellow: #ffc928;
            --jumbo-yellow-light: #fff5d6;
            --jumbo-gray: #f4f7fb;
            --jumbo-white: #ffffff;
            --jumbo-text: #18263b;
            --jumbo-muted: #68778d;
            --jumbo-border: #e6ebf2;
            --jumbo-green: #16834a;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: var(--jumbo-text);
            background: var(--jumbo-white);
        }

        a {
            text-decoration: none;
        }

        /* BARRE D'INFORMATION */

        .top-bar {
            background: var(--jumbo-primary-dark);
            color: white;
            padding: 9px 0;
            font-size: 13px;
        }

        .top-bar i {
            color: var(--jumbo-yellow);
        }

        /* NAVIGATION */

        .main-navbar {
            background: white;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(16, 41, 79, .09);
            border-bottom: 3px solid var(--jumbo-yellow);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--jumbo-primary);
            font-weight: 900;
            font-size: 23px;
            letter-spacing: -.7px;
        }

        .navbar-brand img {
            max-width: 155px;
            max-height: 58px;
            object-fit: contain;
        }

        .brand-fallback {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--jumbo-primary);
            font-weight: 900;
            font-size: 22px;
        }

        .brand-mark {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--jumbo-primary);
            color: white;
            border-bottom: 5px solid var(--jumbo-yellow);
            border-radius: 8px;
            font-size: 22px;
        }

        .navbar-nav .nav-link {
            color: var(--jumbo-text);
            font-weight: 700;
            padding: 12px 11px !important;
            transition: color .2s;
        }

        .navbar-nav .nav-link:hover {
            color: var(--jumbo-blue);
        }

        .navbar-toggler {
            border-color: var(--jumbo-border);
        }

        .btn-jumbo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 0;
            border-radius: 8px;
            background: var(--jumbo-primary);
            color: white;
            padding: 12px 20px;
            font-weight: 800;
            transition: all .2s;
        }

        .btn-jumbo:hover {
            background: var(--jumbo-blue);
            color: white;
            transform: translateY(-2px);
        }

        .btn-jumbo-yellow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--jumbo-yellow);
            color: var(--jumbo-primary-dark);
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 900;
            transition: all .2s;
        }

        .btn-jumbo-yellow:hover {
            background: #f0b800;
            color: var(--jumbo-primary-dark);
            transform: translateY(-2px);
        }

        .btn-jumbo-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 2px solid white;
            border-radius: 8px;
            padding: 11px 20px;
            color: white;
            font-weight: 800;
            transition: all .2s;
        }

        .btn-jumbo-outline:hover {
            background: white;
            color: var(--jumbo-primary);
        }

        /* HERO */

        .hero {
            position: relative;
            min-height: 520px;
            display: flex;
            align-items: center;
            overflow: hidden;
            background: var(--jumbo-primary-dark);
            color: white;
        }

        .hero-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            animation: heroAppear .8s ease-out;
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                rgba(10, 27, 54, .96) 0%,
                rgba(16, 41, 79, .82) 48%,
                rgba(16, 41, 79, .25) 100%
            );
        }

        .hero-content {
            position: relative;
            z-index: 2;
            padding-top: 75px;
            padding-bottom: 75px;
        }

        .hero-label {
            display: inline-block;
            background: var(--jumbo-yellow);
            color: var(--jumbo-primary-dark);
            border-radius: 5px;
            padding: 8px 13px;
            margin-bottom: 22px;
            font-weight: 900;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .hero h1 {
            max-width: 720px;
            font-size: clamp(35px, 5vw, 61px);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: var(--jumbo-yellow);
        }

        .hero p {
            max-width: 590px;
            color: rgba(255,255,255,.9);
            font-size: 17px;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .hero-decoration {
            position: absolute;
            z-index: 2;
            right: 5%;
            bottom: 25px;
            color: rgba(255,255,255,.85);
            font-size: 12px;
            letter-spacing: 1px;
        }

        @keyframes heroAppear {
            from {
                opacity: .55;
                transform: scale(1.03);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* AVANTAGES */

        .benefits {
            background: white;
            border-bottom: 1px solid var(--jumbo-border);
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 25px 12px;
            height: 100%;
        }

        .benefit-icon {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            background: var(--jumbo-yellow-light);
            color: var(--jumbo-primary);
            border-radius: 12px;
            font-size: 23px;
        }

        .benefit-item h3 {
            font-size: 15px;
            font-weight: 900;
            margin: 0 0 5px;
        }

        .benefit-item p {
            font-size: 12px;
            color: var(--jumbo-muted);
            margin: 0;
        }

        /* SECTIONS */

        .section {
            padding: 78px 0;
        }

        .section-soft {
            background: var(--jumbo-gray);
        }

        .section-eyebrow {
            display: inline-block;
            color: var(--jumbo-blue);
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .section-title {
            color: var(--jumbo-primary-dark);
            font-size: clamp(28px, 3vw, 39px);
            font-weight: 900;
            margin-bottom: 12px;
        }

        .section-description {
            color: var(--jumbo-muted);
            line-height: 1.8;
            max-width: 650px;
        }

        /* CATALOGUE */

        .catalogue-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .product-card {
            height: 100%;
            background: white;
            border: 1px solid var(--jumbo-border);
            border-radius: 14px;
            overflow: hidden;
            transition: transform .25s, box-shadow .25s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(16, 41, 79, .12);
        }

        .product-image-wrap {
            height: 215px;
            background: #f5f7fa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 15px;
            transition: transform .3s;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: #a1a7b3;
            font-size: 13px;
        }

        .product-placeholder i {
            font-size: 45px;
        }

        .product-body {
            padding: 20px;
        }

        .product-category {
            display: inline-block;
            background: var(--jumbo-yellow-light);
            color: var(--jumbo-primary);
            border-radius: 4px;
            padding: 5px 8px;
            margin-bottom: 10px;
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .product-name {
            font-size: 17px;
            font-weight: 900;
            margin-bottom: 8px;
            color: var(--jumbo-primary-dark);
        }

        .product-description {
            color: var(--jumbo-muted);
            font-size: 13px;
            line-height: 1.7;
            min-height: 44px;
            margin-bottom: 18px;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            border-top: 1px solid var(--jumbo-border);
            padding-top: 15px;
        }

        .product-price {
            color: var(--jumbo-primary);
            font-size: 18px;
            font-weight: 900;
        }

        .empty-catalogue {
            text-align: center;
            padding: 55px 20px;
            background: white;
            border: 1px dashed #cbd5e1;
            border-radius: 14px;
        }

        .empty-catalogue i {
            font-size: 50px;
            color: #9aa8ba;
        }

        /* BANDEAU */

        .promo-section {
            padding: 65px 0;
            background: linear-gradient(120deg, var(--jumbo-primary-dark), var(--jumbo-blue));
            color: white;
            border-top: 5px solid var(--jumbo-yellow);
        }

        .promo-section h2 {
            font-weight: 900;
            font-size: clamp(27px, 4vw, 40px);
            margin-bottom: 12px;
        }

        .promo-section p {
            color: rgba(255,255,255,.9);
            line-height: 1.8;
            margin-bottom: 0;
        }

        .promo-icon {
            font-size: 85px;
            color: var(--jumbo-yellow);
            text-align: center;
        }

        /* A PROPOS */

        .about-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 310px;
            background: linear-gradient(135deg, var(--jumbo-primary-dark), var(--jumbo-blue));
            border-radius: 18px;
            color: var(--jumbo-yellow);
            font-size: 115px;
            position: relative;
            overflow: hidden;
        }

        .about-icon::before,
        .about-icon::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border: 25px solid rgba(255,255,255,.07);
            border-radius: 50%;
        }

        .about-icon::before {
            top: -65px;
            left: -55px;
        }

        .about-icon::after {
            bottom: -75px;
            right: -45px;
        }

        .about-icon i {
            position: relative;
            z-index: 1;
        }

        .about-point {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .about-point i {
            color: var(--jumbo-blue);
            font-size: 21px;
        }

        .about-point strong {
            display: block;
            margin-bottom: 4px;
        }

        .about-point p {
            margin: 0;
            color: var(--jumbo-muted);
            font-size: 14px;
            line-height: 1.7;
        }

        /* LOCALISATION */

        .location-card {
            background: white;
            padding: 30px;
            border-radius: 16px;
            border-top: 5px solid var(--jumbo-yellow);
            box-shadow: 0 8px 28px rgba(16, 41, 79, .07);
        }

        .location-icon {
            width: 65px;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--jumbo-yellow-light);
            color: var(--jumbo-primary);
            border-radius: 14px;
            font-size: 30px;
            margin-bottom: 20px;
        }

        .location-badge {
            display: inline-block;
            background: var(--jumbo-yellow);
            color: var(--jumbo-primary-dark);
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1px;
            padding: 7px 11px;
            border-radius: 4px;
            margin-bottom: 15px;
        }

        .location-card h3 {
            font-size: 23px;
            font-weight: 900;
            color: var(--jumbo-primary-dark);
            margin-bottom: 18px;
        }

        .location-address {
            color: var(--jumbo-primary);
            font-weight: 800;
            line-height: 1.7;
        }

        .location-address i {
            color: var(--jumbo-blue);
            margin-right: 7px;
        }

        .location-description {
            color: var(--jumbo-muted);
            font-size: 14px;
            line-height: 1.8;
            margin: 20px 0 25px;
        }

        .btn-location-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 2px solid var(--jumbo-primary);
            border-radius: 8px;
            color: var(--jumbo-primary);
            padding: 12px 16px;
            font-weight: 800;
            transition: all .2s;
        }

        .btn-location-outline:hover {
            background: var(--jumbo-primary);
            color: white;
        }

        .location-map-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 28px rgba(16, 41, 79, .07);
            border: 1px solid var(--jumbo-border);
        }

        .location-map-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 22px 25px;
            border-bottom: 1px solid var(--jumbo-border);
        }

        .location-map-heading h3 {
            font-size: 17px;
            font-weight: 900;
            margin: 0 0 5px;
            color: var(--jumbo-primary-dark);
        }

        .location-map-heading h3 i {
            color: var(--jumbo-blue);
            margin-right: 5px;
        }

        .location-map-heading p {
            color: var(--jumbo-muted);
            font-size: 13px;
            margin: 0;
        }

        .map-status {
            background: var(--jumbo-yellow-light);
            color: var(--jumbo-primary-dark);
            border-radius: 20px;
            padding: 7px 11px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .map-status i {
            color: var(--jumbo-green);
            font-size: 8px;
            margin-right: 4px;
        }

        .location-map {
            height: 390px;
            width: 100%;
            background: #eeeeee;
        }

        .location-map iframe {
            display: block;
            width: 100%;
            height: 100%;
            border: 0;
        }

        .location-map-footer {
            padding: 15px 20px;
            color: var(--jumbo-muted);
            font-size: 12px;
            line-height: 1.7;
        }

        .location-map-footer i {
            color: var(--jumbo-blue);
            margin-right: 5px;
        }

        /* FOOTER */

        .footer {
            padding-top: 55px;
            background: var(--jumbo-primary-dark);
            color: white;
            border-top: 5px solid var(--jumbo-yellow);
        }

        .footer-brand {
            color: white;
            font-size: 24px;
            font-weight: 900;
        }

        .footer-description {
            max-width: 370px;
            color: #c4cfdf;
            line-height: 1.8;
            font-size: 14px;
        }

        .footer h4 {
            font-size: 15px;
            font-weight: 900;
            margin-bottom: 18px;
            color: var(--jumbo-yellow);
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-links a {
            color: #c4cfdf;
            font-size: 14px;
            transition: color .2s;
        }

        .footer-links a:hover {
            color: var(--jumbo-yellow);
        }

        .footer-bottom {
            margin-top: 45px;
            padding: 20px 0;
            border-top: 1px solid rgba(255,255,255,.13);
            color: #c4cfdf;
            font-size: 12px;
        }

        /* RESPONSIVE */

        @media (max-width: 767px) {
            .top-bar {
                font-size: 11px;
            }

            .hero {
                min-height: 470px;
            }

            .hero-content {
                padding-top: 55px;
                padding-bottom: 55px;
            }

            .hero::after {
                background: rgba(10, 27, 54, .82);
            }

            .hero-decoration {
                display: none;
            }

            .section {
                padding: 55px 0;
            }

            .product-image-wrap {
                height: 180px;
            }

            .about-icon {
                min-height: 220px;
                font-size: 85px;
            }

            .benefit-item {
                padding: 15px 5px;
            }

            .location-card {
                padding: 22px;
            }

            .location-map {
                height: 300px;
            }

            .location-map-heading {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

{# Images locales de la bannière #}
{% set imagesJumbo = [
    'images/jumbo/jumbo-1.jpg',
    'images/jumbo/jumbo-2.jpg',
    'images/jumbo/jumbo-3.jpg',
    'images/jumbo/jumbo-4.jpg'
] %}

{% set imageJumbo = random(imagesJumbo) %}

<!-- BARRE D'INFORMATION -->
<div class="top-bar">
    <div class="container d-flex justify-content-between align-items-center gap-2">
        <span>
            <i class="bi bi-geo-alt-fill me-1"></i>
            Jumbo Score Madagascar
        </span>

        <span>
            <i class="bi bi-bag-check-fill me-1"></i>
            Découvrez notre catalogue de produits
        </span>
    </div>
</div>

<!-- NAVIGATION -->
<nav class="navbar navbar-expand-lg main-navbar">
    <div class="container">

        <a class="navbar-brand" href="{{ path('app_home') }}" aria-label="Accueil Jumbo Score">

            <img
                src="{{ asset('images/jumbo-score-logo.png') }}"
                alt="Jumbo Score"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';"
            >

            <span class="brand-fallback" style="display:none;">
                <span class="brand-mark">
                    <i class="bi bi-shop"></i>
                </span>
                JUMBO SCORE
            </span>

        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavigation"
            aria-controls="mainNavigation"
            aria-expanded="false"
            aria-label="Ouvrir la navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavigation">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#catalogue">Catalogue</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#avantages">Nos avantages</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#apropos">À propos</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#localisation">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        Localisation
                    </a>
                </li>

                <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                    <a class="btn-jumbo" href="{{ path('app_login') }}">
                        <i class="bi bi-person-circle"></i>
                        Connexion
                    </a>
                </li>

            </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<header class="hero">

    <img
        class="hero-image"
        src="{{ asset(imageJumbo) }}"
        alt="Supermarché Jumbo Score Madagascar"
        fetchpriority="high"
    >

    <div class="container hero-content">

        <span class="hero-label">
            <i class="bi bi-star-fill me-1"></i>
            Bienvenue chez Jumbo Score
        </span>

        <h1>
            Tout ce qu'il vous faut,
            <span>au même endroit.</span>
        </h1>

        <p>
            Découvrez notre catalogue de produits et consultez les informations
            disponibles. Retrouvez facilement les articles qui vous intéressent
            grâce à une présentation simple et agréable.
        </p>

        <div class="hero-buttons">

            <a href="#catalogue" class="btn-jumbo-yellow">
                Découvrir le catalogue
                <i class="bi bi-arrow-right"></i>
            </a>

            <a href="#localisation" class="btn-jumbo-outline">
                <i class="bi bi-geo-alt"></i>
                Nous trouver
            </a>

        </div>
    </div>

    <div class="hero-decoration">
        JUMBO SCORE · MADAGASCAR
    </div>

</header>

<!-- AVANTAGES -->
<section class="benefits" id="avantages">
    <div class="container">
        <div class="row">

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-basket2"></i>
                    </div>
                    <div>
                        <h3>Grand choix</h3>
                        <p>Un catalogue varié</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div>
                        <h3>Prix consultables</h3>
                        <p>Les prix affichés en ligne</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <h3>Stock affiché</h3>
                        <p>Quantités renseignées au catalogue</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-phone"></i>
                    </div>
                    <div>
                        <h3>Simple à consulter</h3>
                        <p>Sur ordinateur et mobile</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- CATALOGUE -->
<section class="section section-soft" id="catalogue">
    <div class="container">

        <div class="catalogue-heading">
            <div>
                <span class="section-eyebrow">Notre sélection</span>
                <h2 class="section-title">Catalogue de produits</h2>
                <p class="section-description mb-0">
                    Retrouvez ci-dessous les produits enregistrés dans notre catalogue.
                </p>
            </div>

            <a href="{{ path('app_login') }}" class="btn-jumbo">
                <i class="bi bi-person-lock"></i>
                Espace de gestion
            </a>
        </div>

        {% if produits is defined and produits|length > 0 %}

            <div class="row g-4">

                {% for produit in produits %}

                    <div class="col-6 col-md-4 col-xl-3">

                        <article class="product-card">

                            <div class="product-image-wrap">

                                {% if produit.image is defined and produit.image %}

                                    <img
                                        class="product-image"
                                        src="{{ asset('images/produits/' ~ produit.image) }}"
                                        alt="{{ produit.nom }}"
                                        loading="lazy"
                                    >

                                {% else %}

                                    <div class="product-placeholder">
                                        <i class="bi bi-box-seam"></i>
                                        <span>Image non disponible</span>
                                    </div>

                                {% endif %}

                            </div>

                            <div class="product-body">

                                <span class="product-category">
                                    <i class="bi bi-bag me-1"></i>
                                    Produit
                                </span>

                                <h3 class="product-name">
                                    {{ produit.nom }}
                                </h3>

                                <p class="product-description">

                                    {% if produit.description is defined and produit.description %}

                                        {{ produit.description|length > 95
                                            ? produit.description|slice(0, 95) ~ '…'
                                            : produit.description }}

                                    {% else %}

                                        Découvrez ce produit dans notre catalogue.

                                    {% endif %}

                                </p>

                                <div class="product-bottom">

                                    <div class="product-price">

                                        {% if produit.prixVente is defined and produit.prixVente is not null %}

                                            {{ produit.prixVente|number_format(0, ',', ' ') }} Ar

                                        {% else %}

                                            Prix non renseigné

                                        {% endif %}

                                    </div>

                                </div>

                            </div>

                        </article>

                    </div>

                {% endfor %}

            </div>

        {% else %}

            <div class="empty-catalogue">

                <i class="bi bi-inboxes"></i>

                <h3 class="mt-3 fw-bold">
                    Le catalogue est en préparation
                </h3>

                <p class="text-secondary mb-4">
                    Aucun produit n'est disponible à l'affichage pour le moment.
                </p>

                <a href="{{ path('app_login') }}" class="btn-jumbo">
                    <i class="bi bi-person-circle"></i>
                    Se connecter
                </a>

            </div>

        {% endif %}

    </div>
</section>

<!-- BANDEAU PROMOTIONNEL -->
<section class="promo-section">

    <div class="container">

        <div class="row align-items-center g-4">

            <div class="col-lg-8">

                <h2>
                    Découvrez notre catalogue en quelques clics.
                </h2>

                <p>
                    Consultez les produits présentés sur notre site et accédez
                    à l'espace de gestion si vous disposez d'un compte autorisé.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end">

                <a href="{{ path('app_login') }}" class="btn-jumbo-yellow">
                    Accéder à mon compte
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</section>

<!-- À PROPOS -->
<section class="section" id="apropos">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-5">

                <div class="about-icon">
                    <i class="bi bi-shop-window"></i>
                </div>

            </div>

            <div class="col-lg-7">

                <span class="section-eyebrow">À propos</span>

                <h2 class="section-title">
                    Bienvenue dans l'univers Jumbo Score
                </h2>

                <p class="section-description">
                    Cette page vous permet de découvrir les produits présentés
                    dans notre catalogue et de consulter les informations
                    disponibles sur chacun d'eux.
                </p>

                <div class="about-point">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>Un catalogue facile à parcourir</strong>
                        <p>
                            Les produits sont présentés avec leur nom,
                            leur description et leur prix lorsqu'ils sont renseignés.
                        </p>
                    </div>
                </div>

                <div class="about-point">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>Une consultation pratique</strong>
                        <p>
                            Une interface adaptée aux écrans d'ordinateur,
                            de tablette et de téléphone.
                        </p>
                    </div>
                </div>

                <div class="about-point">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>Un espace de gestion protégé</strong>
                        <p>
                            Les utilisateurs autorisés peuvent accéder
                            à leur espace via la page de connexion.
                        </p>
                    </div>
                </div>

                <a href="{{ path('app_login') }}" class="btn-jumbo mt-4">
                    Accéder à l'espace de gestion
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</section>

<!-- LOCALISATION -->
<section class="section section-soft" id="localisation">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-eyebrow">Nous trouver</span>

            <h2 class="section-title">
                Où nous trouver ?
            </h2>

            <p class="section-description mx-auto">
                Retrouvez le siège central de Jumbo Score Madagascar
                et découvrez les différents emplacements de nos magasins.
            </p>

        </div>

        <div class="row g-4 align-items-stretch">

            <!-- INFORMATIONS DU SIÈGE -->
            <div class="col-lg-4">

                <div class="location-card h-100">

                    <div class="location-icon">
                        <i class="bi bi-building-fill"></i>
                    </div>

                    <span class="location-badge">
                        SIÈGE CENTRAL
                    </span>

                    <h3>Jumbo Score Madagascar</h3>

                    <p class="location-address">
                        <i class="bi bi-geo-alt-fill"></i>
                        4F5V+63P, Andohitapenaka,
                        Antananarivo, Madagascar
                    </p>

                    <p class="location-description">
                        Retrouvez notre siège central à Andohitapenaka.
                        Cette adresse correspond au site de la société
                        pour laquelle cette plateforme a été développée.
                    </p>

                    <a
                        href="https://www.google.com/maps/search/?api=1&query=4F5V%2B63P%20Andohitapenaka%2C%20Antananarivo%2C%20Madagascar"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-jumbo w-100 mb-3"
                    >
                        <i class="bi bi-sign-turn-right-fill"></i>
                        Obtenir un itinéraire
                    </a>

                    <a
                        href="{{ path('app_home') == '/' ? '/magasins' : '/magasins' }}"
                        class="btn-location-outline w-100"
                    >
                        <i class="bi bi-shop"></i>
                        Découvrir les autres magasins
                    </a>

                </div>

            </div>

            <!-- CARTE DU SIÈGE -->
            <div class="col-lg-8">

                <div class="location-map-card h-100">

                    <div class="location-map-heading">

                        <div>
                            <h3>
                                <i class="bi bi-geo-alt-fill"></i>
                                Notre siège central
                            </h3>

                            <p>
                                Andohitapenaka, Antananarivo
                            </p>
                        </div>

                        <span class="map-status">
                            <i class="bi bi-circle-fill"></i>
                            Localisation
                        </span>

                    </div>

                    <div class="location-map">

                        <iframe
                            title="Localisation du siège central Jumbo Score à Andohitapenaka"
                            src="https://www.google.com/maps?q=4F5V%2B63P%20Andohitapenaka%2C%20Antananarivo%2C%20Madagascar&output=embed"
                            loading="lazy"
                            allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>

                    </div>

                    <div class="location-map-footer">

                        <i class="bi bi-info-circle-fill"></i>

                        La carte indique l'emplacement du siège central.
                        Les autres magasins sont consultables sur notre page
                        de localisation.

                    </div>

                </div>

            </div>

        </div>

        <!-- ACCÈS AUX AUTRES MAGASINS -->
        <div class="text-center mt-5">

            <h3 class="fw-bold mb-2" style="color: var(--jumbo-primary-dark);">
                Vous recherchez un autre magasin ?
            </h3>

            <p class="section-description mx-auto mb-4">
                Consultez notre carte interactive pour découvrir les autres
                emplacements Jumbo Score et préparer votre itinéraire.
            </p>

            <a
                href="{{ path('app_magasins') }}"
                class="btn-jumbo-yellow"
            >
                <i class="bi bi-map-fill"></i>
                Voir tous nos magasins
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>

</section>

